+    fun canReadContent(actor: Member, post: Post): Boolean {
+        if (!post.isPaid) return true
+        if (post.author.id == actor.id) return true
+
+        return postPurchaseRepository.existsByMemberIdAndPostId(actor.id!!, post.id!!)
+    }
+
+    // 구매 금액은 구매자 지갑에서 전액 빠지고, 작성자 지갑에는 가격의 90%(플랫폼 수수료 10% 제외)가 들어간다.
+    // 반환값은 구매 후 구매자 잔액.
+    @Transactional
+    fun purchase(buyer: Member, post: Post): Long {
+        val buyerId = buyer.id!!
+        val authorId = post.author.id!!
+
+        if (!post.isPaid) throw ServiceException("400-3", "무료 글은 구매할 수 없습니다.")
+        if (authorId == buyerId) throw ServiceException("400-4", "본인이 작성한 글은 구매할 수 없습니다.")
+
+        // 지갑을 먼저 잠근 뒤 구매 여부를 확인해야 동시 구매 요청이 중복 결제되지 않는다
+        val wallets = walletService.lockWallets(buyerId, authorId)
+
+        if (postPurchaseRepository.existsByMemberIdAndPostId(buyerId, post.id!!)) {
+            throw ServiceException("409-2", "이미 구매한 글입니다.")
+        }
+
+        val buyerWallet = wallets.getValue(buyerId)
+        buyerWallet.withdraw(post.price)
+        wallets.getValue(authorId).deposit(authorPayout(post.price))
+
+        postPurchaseRepository.save(PostPurchase(buyerId, post.id!!))
+
+        return buyerWallet.balance
+    }
+
+    // 가격은 100원 단위이므로 나머지가 없다. 과거 데이터처럼 단위가 맞지 않는 값은 내림한다.
+    private fun authorPayout(price: Long): Long = price / 100L * (100L - PLATFORM_FEE_PERCENT)
+
+    companion object {
+        private const val PRICE_UNIT = 100L
+        private const val PLATFORM_FEE_PERCENT = 10L
+    }
 }
