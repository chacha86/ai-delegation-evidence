+@RestController
+@RequestMapping("/api/v1/wallet")
+@Tag(name = "ApiV1WalletController", description = "지갑 API")
+@SecurityRequirement(name = "bearerAuth")
+class ApiV1WalletController(
+    private val walletService: WalletService,
+    private val rq: Rq,
+) {
+    data class WalletResBody(
+        val balance: Long,
+    )
+
+    @GetMapping
+    @Transactional(readOnly = true)
+    @Operation(summary = "내 지갑 잔액 조회")
+    fun getWallet(): RsData<WalletResBody> {
+        val actor = rq.actor
+
+        return RsData(
+            "200-1",
+            "OK",
+            WalletResBody(walletService.balanceOf(actor.id!!)),
+        )
+    }
+
+    // 필드를 nullable 로 두는 이유는 ApiV1MemberController.JoinReqBody 주석 참고
+    data class ChargeReqBody(
+        @field:NotNull
+        @field:Positive
+        @field:Max(WalletService.MAX_CHARGE_AMOUNT)
+        val amount: Long?,
+    )
+
+    @PostMapping("/charge")
+    @Transactional
+    @Operation(summary = "지갑 충전")
+    fun charge(
+        @RequestBody @Valid reqBody: ChargeReqBody,
+    ): RsData<WalletResBody> {
+        val actor = rq.actor
+        val balance = walletService.charge(actor.id!!, reqBody.amount!!)
+
+        return RsData(
+            "200-1",
+            "${reqBody.amount}원이 충전되었습니다.",
+            WalletResBody(balance),
+        )
+    }
+}
