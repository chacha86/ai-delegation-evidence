+package com.rest1.domain.wallet.wallet.repository
+
+import com.rest1.domain.wallet.wallet.entity.Wallet
+import jakarta.persistence.LockModeType
+import org.springframework.data.jpa.repository.JpaRepository
+import org.springframework.data.jpa.repository.Lock
+import org.springframework.data.jpa.repository.Query
+
+interface WalletRepository : JpaRepository<Wallet, Long> {
+    fun findByMemberId(memberId: Long): Wallet?
+
+    @Lock(LockModeType.PESSIMISTIC_WRITE)
+    @Query("select w from Wallet w where w.memberId = :memberId")
+    fun findByMemberIdForUpdate(memberId: Long): Wallet?
+}
