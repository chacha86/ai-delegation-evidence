+package com.rest1.domain.wallet.wallet.service
+
+import com.rest1.domain.wallet.wallet.entity.Wallet
+import com.rest1.domain.wallet.wallet.repository.WalletRepository
+import com.rest1.global.exception.ServiceException
+import org.springframework.stereotype.Service
+import org.springframework.transaction.annotation.Transactional
+
+@Service
+class WalletService(
+    private val walletRepository: WalletRepository,
+) {
+    // 지갑은 처음 필요할 때 잔액 0으로 만든다
+    @Transactional
+    fun balanceOf(memberId: Long): Long = getOrCreate(memberId).balance
+
+    // 1회 충전 금액은 100,000 이하. 넘으면 지갑을 건드리지 않고 거부한다.
+    @Transactional
+    fun charge(memberId: Long, amount: Long): Long {
+        if (amount > MAX_CHARGE_AMOUNT) throw ServiceException("400-5", "1회 충전 금액은 100,000원 이하여야 합니다.")
+
+        val wallet = lockWallets(memberId).getValue(memberId)
+        wallet.deposit(amount)
+
+        return wallet.balance
+    }
+
+    // 여러 지갑을 회원 id 오름차순으로 잠가 교착(deadlock)을 막는다.
+    @Transactional
+    fun lockWallets(vararg memberIds: Long): Map<Long, Wallet> {
+        val ids = memberIds.distinct().sorted()
+
+        ids.forEach { getOrCreate(it) }
+
+        return ids.associateWith { walletRepository.findByMemberIdForUpdate(it)!! }
+    }
+
+    private fun getOrCreate(memberId: Long): Wallet =
+        walletRepository.findByMemberId(memberId) ?: walletRepository.save(Wallet(memberId))
+
+    companion object {
+        const val MAX_CHARGE_AMOUNT = 100_000L
+    }
+}
