+        call("user2", "POST", "/api/v1/posts/$id/purchase").andExpect(status().is2xxSuccessful)
+        org.assertj.core.api.Assertions.assertThat(balance("user2")).isEqualTo(0)
+        org.assertj.core.api.Assertions.assertThat(balance("user1")).isEqualTo(270)
