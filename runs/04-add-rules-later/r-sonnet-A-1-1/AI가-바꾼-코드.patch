+        call(null, "GET", "/api/v1/posts/$id/content").andExpect(status().isUnauthorized)
+        // 작성자는 열람 가능
+        call("user1", "GET", "/api/v1/posts/$id/content").andExpect(status().isOk).andExpect(jsonPath("$.content").value("비밀내용입니다"))
+        // 무료 글은 누구나
