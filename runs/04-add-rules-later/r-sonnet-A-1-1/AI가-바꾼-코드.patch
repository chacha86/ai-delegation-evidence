+package com.rest1.domain.payment.service
+
+import com.rest1.domain.member.member.repository.MemberRepository
+import com.rest1.domain.payment.entity.Purchase
+import com.rest1.domain.payment.repository.PurchaseRepository
+import com.rest1.domain.post.post.entity.Post
+import com.rest1.global.exception.ServiceException
+import org.springframework.dao.DataIntegrityViolationException
+import org.springframework.stereotype.Service
+import org.springframework.transaction.annotation.Transactional
+import java.math.BigDecimal
+
+@Service
+class PaymentService(
+    private val memberRepository: MemberRepository,
+    private val purchaseRepository: PurchaseRepository,
+) {
+    companion object {
+        const val MAX_CHARGE = 100_000L
+        const val PRICE_UNIT = 100L
+        const val FEE_PERCENT = 10L
+        const val MAX_PRICE = 10_000_000L
+        const val MAX_BALANCE = 1_000_000_000_000L
+
+        fun validatePrice(price: Long) {
+            if (price % PRICE_UNIT != 0L) {
+                throw ServiceException("400-3", "price 는 ${PRICE_UNIT}원 단위여야 합니다.")
+            }
+        }
+
+        // 작성자 정산액: 가격의 90% (원 미만 버림)
+        fun authorProceeds(price: Long): Long = price - price * FEE_PERCENT / 100
+
+        // 요청의 숫자를 검증해 Long 으로. 소수(1.5)·범위 초과는 조용히 깎지 않고 거절한다.
+        fun toWholeNumber(value: BigDecimal, field: String, max: Long): Long {
+            if (value.compareTo(BigDecimal.valueOf(max)) > 0) {
+                throw ServiceException("400-3", "$field 은(는) $max 이하여야 합니다.")
+            }
+            if (value.compareTo(BigDecimal.ZERO) < 0) {
+                throw ServiceException("400-3", "$field 은(는) 0 이상이어야 합니다.")
+            }
+            return try {
+                value.longValueExact()
+            } catch (e: ArithmeticException) {
+                throw ServiceException("400-3", "$field 은(는) 정수여야 합니다.")
+            }
+        }
+    }
+
+    @Transactional(readOnly = true)
+    fun getBalance(memberId: Long): Long =
+        memberRepository.findBalanceById(memberId) ?: throw NoSuchElementException()
+
+    @Transactional
+    fun charge(memberId: Long, amount: Long): Long {
+        if (amount < 1) throw ServiceException("400-3", "충전 금액은 1 이상이어야 합니다.")
+        if (amount > MAX_CHARGE) throw ServiceException("400-3", "한 번에 $MAX_CHARGE 까지만 충전할 수 있습니다.")
+
+        val updated = memberRepository.addBalance(memberId, amount, MAX_BALANCE - amount)
+        if (updated == 0) {
+            if (!memberRepository.existsById(memberId)) throw NoSuchElementException()
+            throw ServiceException("400-4", "잔액 한도($MAX_BALANCE)를 초과합니다.")
+        }
+
+        return getBalance(memberId)
+    }
+
+    @Transactional
+    fun purchase(buyerId: Long, post: Post) {
+        val postId = post.id!!
+        val authorId = post.author.id!!
+        val price = post.price
+
+        if (price <= 0) throw ServiceException("400-5", "무료 글은 구매할 수 없습니다.")
+        if (authorId == buyerId) throw ServiceException("400-6", "자신의 글은 구매할 수 없습니다.")
+        if (purchaseRepository.existsByMemberIdAndPostId(buyerId, postId)) {
+            throw ServiceException("409-1", "이미 구매한 글입니다.")
+        }
+
+        // 잔액 차감을 먼저 한다: 잔액 부족이면 아무것도 기록되지 않는다 (롤백에 의존하지 않음).
+        if (memberRepository.subtractBalance(buyerId, price) == 0) {
+            throw ServiceException("402-1", "잔액이 부족합니다.")
+        }
+        // 동시 중복 구매는 유니크 제약이 막는다. 예외로 트랜잭션 전체(차감 포함)가 롤백된다.
+        try {
+            purchaseRepository.saveAndFlush(Purchase(buyerId, postId, price))
+        } catch (e: DataIntegrityViolationException) {
+            throw ServiceException("409-1", "이미 구매한 글입니다.")
+        }
+        val proceeds = authorProceeds(price)
+        if (proceeds > 0 && memberRepository.addBalance(authorId, proceeds, MAX_BALANCE - proceeds) == 0) {
+            throw ServiceException("500-1", "판매자에게 대금을 지급할 수 없습니다.") // 전체 롤백
+        }
+    }
+
+    @Transactional(readOnly = true)
+    fun canRead(memberId: Long, post: Post): Boolean =
+        !post.isPaid || post.author.id == memberId || purchaseRepository.existsByMemberIdAndPostId(memberId, post.id!!)
+}
