+package com.rest1.domain.payment
+
+import org.junit.jupiter.api.DisplayName
+import org.junit.jupiter.api.Test
+import org.springframework.beans.factory.annotation.Autowired
+import org.springframework.boot.test.autoconfigure.web.servlet.AutoConfigureMockMvc
+import org.springframework.boot.test.context.SpringBootTest
+import org.springframework.http.MediaType
+import org.springframework.test.annotation.DirtiesContext
+import org.springframework.test.context.ActiveProfiles
+import org.springframework.test.context.TestPropertySource
+import org.springframework.test.web.servlet.MockMvc
+import org.springframework.test.web.servlet.ResultActions
+import org.springframework.test.web.servlet.request.MockMvcRequestBuilders.get
+import org.springframework.test.web.servlet.request.MockMvcRequestBuilders.post
+import org.springframework.test.web.servlet.result.MockMvcResultMatchers.jsonPath
+import org.springframework.test.web.servlet.result.MockMvcResultMatchers.status
+import org.springframework.transaction.annotation.Transactional
+
+@SpringBootTest
+@ActiveProfiles("test")
+@AutoConfigureMockMvc
+// IDENTITY 값은 롤백되지 않아 같은 캐시 컨텍스트를 쓰는 다른 테스트(글 id 단언)에 영향을 주므로 컨텍스트를 격리한다.
+@TestPropertySource(properties = ["spring.datasource.url=jdbc:h2:mem:db_payment_test;MODE=MySQL"])
+@DirtiesContext(classMode = DirtiesContext.ClassMode.AFTER_CLASS)
+@Transactional
+class PaymentTest {
+    @Autowired
+    private lateinit var mvc: MockMvc
+
+    // BaseInitData 의 apiKey 가 곧 username (user1, user2, user3)
+    private fun call(key: String?, method: String, url: String, body: String? = null): ResultActions {
+        val b = if (method == "GET") get(url) else post(url)
+        if (key != null) b.header("Authorization", "Bearer $key")
+        if (body != null) b.contentType(MediaType.APPLICATION_JSON).content(body)
+        return mvc.perform(b)
+    }
+
+    private fun balance(key: String): Int {
+        val json = call(key, "GET", "/api/v1/wallet").andExpect(status().isOk).andReturn().response.contentAsString
+        return Regex("\"balance\":(-?\\d+)").find(json)!!.groupValues[1].toInt()
+    }
+
+    private fun charge(key: String, amount: String) = call(key, "POST", "/api/v1/wallet/charge", """{"amount": $amount}""")
+
+    private fun write(key: String, price: String?): Int {
+        val p = if (price == null) "" else ""","price": $price"""
+        val json = call(key, "POST", "/api/v1/posts", """{"title":"유료글","content":"비밀내용입니다"$p}""")
+            .andExpect(status().isCreated).andReturn().response.contentAsString
+        return Regex("\"postDto\":\\{\"id\":(\\d+)").find(json)!!.groupValues[1].toInt()
+    }
+
+    @Test
+    @DisplayName("초기 잔액 0, 충전 후 증가, 잘못된 금액 거절")
+    fun wallet() {
+        org.assertj.core.api.Assertions.assertThat(balance("user1")).isEqualTo(0)
+        charge("user1", "1000").andExpect(status().isOk)
+        charge("user1", "500").andExpect(status().is2xxSuccessful)
+        org.assertj.core.api.Assertions.assertThat(balance("user1")).isEqualTo(1500)
+        for (bad in listOf("0", "-5", "1.5", "99999999999", "null", "\"abc\"")) {
+            charge("user1", bad).andExpect(status().isBadRequest)
+        }
+        call("user1", "POST", "/api/v1/wallet/charge", "{}").andExpect(status().isBadRequest)
+        org.assertj.core.api.Assertions.assertThat(balance("user1")).isEqualTo(1500)
