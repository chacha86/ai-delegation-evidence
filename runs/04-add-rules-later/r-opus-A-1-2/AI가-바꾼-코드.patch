+package com.rest1.domain.post.purchase.entity
+
+import com.rest1.domain.member.member.entity.Member
+import com.rest1.domain.post.post.entity.Post
+import com.rest1.global.jpa.entity.BaseEntity
+import jakarta.persistence.Column
+import jakarta.persistence.Entity
+import jakarta.persistence.FetchType
+import jakarta.persistence.ManyToOne
+import jakarta.persistence.Table
+import jakarta.persistence.UniqueConstraint
+
+// 회원이 유료 글을 구매한 기록. 같은 회원은 같은 글을 한 번만 구매할 수 있다
+@Entity
+@Table(
+    uniqueConstraints = [UniqueConstraint(name = "uk_post_purchase_buyer_post", columnNames = ["buyer_id", "post_id"])],
+)
+class PostPurchase(
+    @ManyToOne(fetch = FetchType.LAZY, optional = false)
+    val buyer: Member,
+    @ManyToOne(fetch = FetchType.LAZY, optional = false)
+    val post: Post,
+    // 구매 당시 지불한 금액 (이후 글 가격이 바뀌어도 기록은 유지된다)
+    val price: Long,
+    // 구매 금액 중 플랫폼이 가져간 수수료. 작성자 정산액 = price - fee
+    // 수수료 규칙 도입 전 기록(작성자가 전액 정산받음)은 0 이 되도록 DB 기본값을 0 으로 둔다
+    @Column(nullable = false, columnDefinition = "BIGINT DEFAULT 0 NOT NULL")
+    val fee: Long = 0,
+) : BaseEntity() {
+    val authorRevenue: Long
+        get() = price - fee
+}
