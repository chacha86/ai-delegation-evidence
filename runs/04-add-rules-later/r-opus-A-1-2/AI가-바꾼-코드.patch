index 0000000..6e59a27
--- /dev/null
+++ b/src/main/kotlin/com/rest1/domain/post/purchase/service/PostPurchaseService.kt
@@ -0,0 +1,108 @@
+package com.rest1.domain.post.purchase.service
+
+import com.rest1.domain.member.member.entity.Member
+import com.rest1.domain.member.member.repository.MemberRepository
+import com.rest1.domain.post.post.entity.Post
+import com.rest1.domain.post.post.repository.PostRepository
+import com.rest1.domain.post.purchase.entity.PostPurchase
+import com.rest1.domain.post.purchase.repository.PostPurchaseRepository
+import com.rest1.global.exception.ServiceException
+import org.springframework.data.repository.findByIdOrNull
+import org.springframework.stereotype.Service
+import org.springframework.transaction.annotation.Transactional
+
+@Service
+class PostPurchaseService(
+    private val postRepository: PostRepository,
+    private val memberRepository: MemberRepository,
+    private val postPurchaseRepository: PostPurchaseRepository,
+) {
+    companion object {
+        // 회사 규칙: 구매 금액에서 플랫폼 수수료 10% 를 뺀 금액(가격의 90%)이 작성자 지갑에 들어간다
+        const val PLATFORM_FEE_PERCENT = 10L
+
+        /**
+         * 작성자 정산액 = 가격의 90%, 원 미만은 버린다(수수료 = 가격 - 정산액).
+         * 새 글은 100원 단위라 항상 나누어떨어지고, 버림은 규칙 도입 전에 만들어진 100원 단위가 아닌 글에만 해당한다.
+         */
+        fun authorRevenueOf(price: Long): Long = price * (100 - PLATFORM_FEE_PERCENT) / 100
+    }
+
+    data class PurchaseResult(
+        val purchase: PostPurchase,
+        val buyerBalance: Long,
+    )
+
+    /**
+     * 유료 글 구매.
+     * - 잠금 순서: 글 행 -> 회원 행(id 오름차순). 충전/삭제도 같은 순서를 따르므로 교착이 생기지 않는다.
+     * - 구매자 잔액에서 가격만큼 빼고, 플랫폼 수수료(10%)를 뺀 금액(가격의 90%)을 글 작성자 잔액에 더한다.
+     */
+    @Transactional
+    fun purchase(actor: Member, postId: Long): PurchaseResult {
+        val actorId = actor.id!!
+        val post = postRepository.findWithLockById(postId) ?: throw NoSuchElementException()
+
+        if (!post.isPaid) {
+            throw ServiceException("400-3", "무료 글은 구매할 필요가 없습니다.")
+        }
+
+        val authorId = post.author.id!!
+
+        if (authorId == actorId) {
+            throw ServiceException("400-4", "본인이 작성한 글은 구매할 수 없습니다.")
+        }
+
+        // 두 회원 행을 id 오름차순으로 잠근다
+        val locked = listOf(actorId, authorId).sorted()
+            .associateWith { memberRepository.findWithLockById(it) ?: throw NoSuchElementException() }
+        val buyer = locked.getValue(actorId)
+        val author = locked.getValue(authorId)
+
+        // 잠금을 잡은 뒤에 확인해야 같은 회원의 동시 중복 구매를 막을 수 있다
+        if (postPurchaseRepository.existsByBuyerIdAndPostId(actorId, postId)) {
+            throw ServiceException("409-2", "이미 구매한 글입니다.")
+        }
+
+        val price = post.price
+        val authorRevenue = authorRevenueOf(price)
+        buyer.withdraw(price)
+        // 규칙 도입 전에 만든 1~9원짜리 글은 정산액이 0 이 될 수 있다 (deposit 은 양수만 받는다)
+        if (authorRevenue > 0) author.deposit(authorRevenue)
+
+        val purchase = postPurchaseRepository.save(PostPurchase(buyer, post, price, price - authorRevenue))
+
+        return PurchaseResult(purchase, buyer.balance)
+    }
+
+    fun hasPurchased(memberId: Long, postId: Long): Boolean =
+        postPurchaseRepository.existsByBuyerIdAndPostId(memberId, postId)
+
+    fun hasAnyPurchase(postId: Long): Boolean = postPurchaseRepository.existsByPostId(postId)
+
+    /**
+     * 본문 열람 권한.
+     * - 무료 글: 누구나 (비로그인 포함)
+     * - 유료 글: 작성자 본인 또는 구매한 회원만
+     */
+    @Transactional(readOnly = true)
+    fun getReadableContent(actor: Member?, postId: Long): Post {
+        val post = postRepository.findByIdOrNull(postId) ?: throw NoSuchElementException()
+
+        if (!post.isPaid) return post
+
+        if (actor == null) {
+            throw ServiceException("401-1", "로그인 후 이용해주세요.")
+        }
+
+        val actorId = actor.id!!
+
+        if (post.author.id == actorId) return post
+
+        if (!hasPurchased(actorId, postId)) {
+            throw ServiceException("403-3", "구매한 회원만 열람할 수 있는 유료 글입니다.")
+        }
+
+        return post
+    }
+}
