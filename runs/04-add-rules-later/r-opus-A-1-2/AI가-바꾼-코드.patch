+package com.rest1.domain.post.purchase.repository
+
+import com.rest1.domain.post.purchase.entity.PostPurchase
+import org.springframework.data.jpa.repository.JpaRepository
+
+interface PostPurchaseRepository : JpaRepository<PostPurchase, Long> {
+    fun existsByBuyerIdAndPostId(buyerId: Long, postId: Long): Boolean
+
+    fun existsByPostId(postId: Long): Boolean
+}
diff --git a/src/main/kotlin/com/rest1/domain/post/purchase/service/PostPurchaseService.kt b/src/main/kotlin/com/rest1/domain/post/purchase/service/PostPurchaseService.kt
