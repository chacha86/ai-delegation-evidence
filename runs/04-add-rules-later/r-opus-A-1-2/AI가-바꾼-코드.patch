@@ -0,0 +1,112 @@
+package com.rest1.domain.post.purchase
+
+import com.rest1.domain.member.member.repository.MemberRepository
+import com.rest1.domain.member.member.service.MemberService
+import com.rest1.domain.post.post.service.PostService
+import com.rest1.domain.post.purchase.repository.PostPurchaseRepository
+import com.rest1.domain.post.purchase.service.PostPurchaseService
+import com.rest1.domain.wallet.wallet.service.WalletService
+import org.assertj.core.api.Assertions.assertThat
+import org.junit.jupiter.api.DisplayName
+import org.junit.jupiter.api.Test
+import org.springframework.beans.factory.annotation.Autowired
+import org.springframework.boot.test.context.SpringBootTest
+import org.springframework.test.annotation.DirtiesContext
+import org.springframework.test.context.ActiveProfiles
+import org.springframework.transaction.support.TransactionTemplate
+import java.util.concurrent.CountDownLatch
+import java.util.concurrent.Executors
+import java.util.concurrent.TimeUnit
+import java.util.concurrent.atomic.AtomicInteger
+
+// 실제 커밋이 일어나야 하므로 @Transactional 을 붙이지 않는다. 다른 테스트에 데이터가 새지 않도록 컨텍스트를 버린다
+@SpringBootTest
+@ActiveProfiles("test")
+@DirtiesContext(classMode = DirtiesContext.ClassMode.AFTER_CLASS)
+class PostPurchaseConcurrencyTest {
+    @Autowired private lateinit var memberService: MemberService
+    @Autowired private lateinit var memberRepository: MemberRepository
+    @Autowired private lateinit var postService: PostService
+    @Autowired private lateinit var walletService: WalletService
+    @Autowired private lateinit var postPurchaseService: PostPurchaseService
+    @Autowired private lateinit var postPurchaseRepository: PostPurchaseRepository
+    @Autowired private lateinit var tx: TransactionTemplate
+
+    private fun runConcurrently(n: Int, task: () -> Unit): Pair<Int, List<Throwable>> {
+        val pool = Executors.newFixedThreadPool(n)
+        val start = CountDownLatch(1)
+        val ok = AtomicInteger()
+        val errors = java.util.Collections.synchronizedList(mutableListOf<Throwable>())
+        repeat(n) {
+            pool.submit {
+                start.await()
+                try {
+                    task()
+                    ok.incrementAndGet()
+                } catch (e: Throwable) {
+                    errors.add(e)
+                }
+            }
+        }
+        start.countDown()
+        pool.shutdown()
+        pool.awaitTermination(60, TimeUnit.SECONDS)
+        return ok.get() to errors.toList()
+    }
+
+    @Test
+    @DisplayName("같은 회원이 같은 글을 동시에 여러 번 구매해도 한 번만 결제된다")
+    fun t1() {
+        val seller = memberService.join("cc_seller", "1234", "판매자")
+        val buyer = memberService.join("cc_buyer", "1234", "구매자")
+        val post = tx.execute {
+            postService.write(memberRepository.findById(seller.id!!).get(), "제목", "본문", 100)
+        }!!
+        walletService.charge(buyer.id!!, 1000)
+
+        val (ok, errors) = runConcurrently(10) { postPurchaseService.purchase(buyer, post.id!!) }
+
+        assertThat(ok).isEqualTo(1)
+        // 실패한 9건은 모두 "이미 구매" 로 거절되어야 한다 (잠금 시간 초과/제약 위반 500 이 아니라)
+        assertThat(errors.map { it.message }).allMatch { it!!.startsWith("409-2") }
+        assertThat(walletService.getBalance(buyer.id!!)).isEqualTo(900)
+        assertThat(walletService.getBalance(seller.id!!)).isEqualTo(90) // 수수료 10% 를 뺀 정산액
+        assertThat(postPurchaseRepository.count()).isEqualTo(1)
+    }
+
+    @Test
+    @DisplayName("동시 충전이 유실되지 않는다")
+    fun t2() {
+        val m = memberService.join("cc_charger", "1234", "충전자")
+
+        val (ok, errors) = runConcurrently(20) { walletService.charge(m.id!!, 10) }
+
+        assertThat(errors).isEmpty()
+        assertThat(ok).isEqualTo(20)
+        assertThat(walletService.getBalance(m.id!!)).isEqualTo(200)
+    }
+
+    @Test
+    @DisplayName("서로의 글을 동시에 구매해도 교착 없이 둘 다 성공한다")
+    fun t3() {
+        val a = memberService.join("cc_a", "1234", "에이")
+        val b = memberService.join("cc_b", "1234", "비")
+        val (postA, postB) = tx.execute {
+            // 글 가격은 100원 단위여야 한다
+            postService.write(memberRepository.findById(a.id!!).get(), "제목", "본문", 100) to
+                postService.write(memberRepository.findById(b.id!!).get(), "제목", "본문", 100)
+        }!!
+        walletService.charge(a.id!!, 100)
+        walletService.charge(b.id!!, 100)
+
+        val tasks = listOf({ postPurchaseService.purchase(a, postB.id!!) }, { postPurchaseService.purchase(b, postA.id!!) })
+        val idx = AtomicInteger()
+        val (ok, errors) = runConcurrently(2) { tasks[idx.getAndIncrement()]() }
+
+        assertThat(errors).isEmpty()
+        assertThat(ok).isEqualTo(2)
+        // 100 충전 - 100 지불 + 90 정산(수수료 10%)
+        assertThat(walletService.getBalance(a.id!!)).isEqualTo(90)
+        assertThat(walletService.getBalance(b.id!!)).isEqualTo(90)
+    }
+}
