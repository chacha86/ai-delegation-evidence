+package com.rest1.domain.wallet.wallet.controller
+
+import com.rest1.domain.wallet.wallet.dto.WalletDto
+import com.rest1.domain.wallet.wallet.service.WalletService
+import com.rest1.global.rq.Rq
+import com.rest1.global.rsData.RsData
+import io.swagger.v3.oas.annotations.Operation
+import io.swagger.v3.oas.annotations.security.SecurityRequirement
+import io.swagger.v3.oas.annotations.tags.Tag
+import jakarta.validation.Valid
+import jakarta.validation.constraints.DecimalMax
+import jakarta.validation.constraints.Digits
+import jakarta.validation.constraints.NotNull
+import jakarta.validation.constraints.Positive
+import org.springframework.web.bind.annotation.GetMapping
+import org.springframework.web.bind.annotation.PostMapping
+import org.springframework.web.bind.annotation.RequestBody
+import org.springframework.web.bind.annotation.RequestMapping
+import org.springframework.web.bind.annotation.RestController
+import java.math.BigDecimal
+
+@RestController
+@RequestMapping("/api/v1/wallet")
+@Tag(name = "ApiV1WalletController", description = "지갑 API")
+@SecurityRequirement(name = "bearerAuth")
+class ApiV1WalletController(
+    private val walletService: WalletService,
+    private val rq: Rq,
+) {
+    @GetMapping
+    @Operation(summary = "내 잔액 조회")
+    fun getMyWallet(): WalletDto {
+        val actorId = rq.actor.id!!
+
+        return WalletDto(actorId, walletService.getBalance(actorId))
+    }
+
+    // amount 를 Long 이 아니라 BigDecimal 로 받는 이유:
+    // Jackson 은 기본 설정에서 1.5 같은 소수를 Long 으로 받을 때 조용히 1 로 잘라 버리므로, 소수를 명시적으로 거절하기 위해서다
+    data class WalletChargeReqBody(
+        @field:NotNull
+        @field:Positive
+        @field:Digits(integer = 6, fraction = 0)
+        @field:DecimalMax("100000") // WalletService.MAX_CHARGE_AMOUNT
+        val amount: BigDecimal?,
+    )
+
+    @PostMapping("/charge")
+    @Operation(summary = "잔액 충전")
+    fun charge(
+        @RequestBody @Valid reqBody: WalletChargeReqBody,
+    ): RsData<WalletDto> {
+        val actorId = rq.actor.id!!
+        val amount = reqBody.amount!!.longValueExact()
+
+        val balance = walletService.charge(actorId, amount)
+
+        return RsData(
+            "200-1",
+            "${amount}원이 충전되었습니다.",
+            WalletDto(actorId, balance),
+        )
+    }
+}
