+package com.rest1.domain.wallet.wallet.service
+
+import com.rest1.domain.member.member.repository.MemberRepository
+import com.rest1.global.exception.ServiceException
+import org.springframework.data.repository.findByIdOrNull
+import org.springframework.stereotype.Service
+import org.springframework.transaction.annotation.Transactional
+
+// 회원 지갑. 잔액은 Member.balance 에 저장한다 (회원 1명당 지갑 1개, 초기 잔액 0)
+@Service
+class WalletService(
+    private val memberRepository: MemberRepository,
+) {
+    companion object {
+        // 회사 규칙: 1회 충전 금액은 100,000 이하
+        const val MAX_CHARGE_AMOUNT = 100_000L
+        const val MAX_BALANCE_BY_CHARGE = 1_000_000_000L
+    }
+
+    @Transactional(readOnly = true)
+    fun getBalance(memberId: Long): Long {
+        val member = memberRepository.findByIdOrNull(memberId) ?: throw NoSuchElementException()
+        return member.balance
+    }
+
+    @Transactional
+    fun charge(memberId: Long, amount: Long): Long {
+        if (amount <= 0 || amount > MAX_CHARGE_AMOUNT) {
+            throw ServiceException("400-6", "충전 금액은 1 이상 $MAX_CHARGE_AMOUNT 이하의 정수여야 합니다.")
+        }
+
+        val member = memberRepository.findWithLockById(memberId) ?: throw NoSuchElementException()
+
+        if (member.balance + amount > MAX_BALANCE_BY_CHARGE) {
+            throw ServiceException("400-7", "충전 후 잔액은 $MAX_BALANCE_BY_CHARGE 을(를) 넘을 수 없습니다.")
+        }
+
+        member.deposit(amount)
+
+        return member.balance
+    }
+}
