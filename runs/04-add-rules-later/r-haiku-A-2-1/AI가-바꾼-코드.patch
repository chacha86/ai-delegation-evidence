+package com.rest1.domain.post.post.controller
+
+import com.rest1.domain.member.member.repository.MemberRepository
+import com.rest1.domain.post.post.entity.Post
+import com.rest1.domain.post.post.repository.PostRepository
+import org.hamcrest.Matchers.hasItem
+import org.junit.jupiter.api.DisplayName
+import org.junit.jupiter.api.Test
+import org.springframework.beans.factory.annotation.Autowired
+import org.springframework.boot.test.autoconfigure.web.servlet.AutoConfigureMockMvc
+import org.springframework.boot.test.context.SpringBootTest
+import org.springframework.http.MediaType
+import org.springframework.test.context.ActiveProfiles
+import org.springframework.test.web.servlet.MockMvc
+import org.springframework.test.web.servlet.request.MockMvcRequestBuilders.get
+import org.springframework.test.web.servlet.request.MockMvcRequestBuilders.post
+import org.springframework.test.web.servlet.result.MockMvcResultMatchers.jsonPath
+import org.springframework.test.web.servlet.result.MockMvcResultMatchers.status
+import org.springframework.transaction.annotation.Transactional
+
+@SpringBootTest
+@ActiveProfiles("test")
+@AutoConfigureMockMvc
+@Transactional
+class ApiV1PostPurchaseControllerTest {
+    @Autowired
+    private lateinit var mvc: MockMvc
+
+    @Autowired
+    private lateinit var memberRepository: MemberRepository
+
+    @Autowired
+    private lateinit var postRepository: PostRepository
+
+    private fun apiKeyOf(username: String): String = memberRepository.findByUsername(username).get().apiKey!!
+
+    private fun paidPost(authorUsername: String, price: Long): Post {
+        val author = memberRepository.findByUsername(authorUsername).get()
+
+        return postRepository.save(Post(author, "유료글", "비밀본문", price))
+    }
+
+    private fun charge(username: String, amount: Long) {
+        mvc.perform(
+            post("/api/v1/wallet/charge")
+                .header("Authorization", "Bearer ${apiKeyOf(username)}")
+                .contentType(MediaType.APPLICATION_JSON)
+                .content("""{"amount": $amount}""")
+        ).andExpect(status().isOk)
+    }
+
+    @Test
+    @DisplayName("글 작성 시 price 를 받고, 생략하면 0")
+    fun t1() {
+        mvc.perform(
+            post("/api/v1/posts")
+                .header("Authorization", "Bearer ${apiKeyOf("user1")}")
+                .contentType(MediaType.APPLICATION_JSON)
+                .content("""{"title": "유료제목", "content": "유료본문", "price": 300}""")
+        )
+            .andExpect(status().isCreated)
+            .andExpect(jsonPath("$.data.postDto.price").value(300))
+
+        mvc.perform(
+            post("/api/v1/posts")
+                .header("Authorization", "Bearer ${apiKeyOf("user1")}")
+                .contentType(MediaType.APPLICATION_JSON)
+                .content("""{"title": "무료제목", "content": "무료본문"}""")
+        )
+            .andExpect(status().isCreated)
+            .andExpect(jsonPath("$.data.postDto.price").value(0))
+    }
+
+    @Test
+    @DisplayName("음수 가격으로 글을 쓸 수 없다")
+    fun t2() {
+        mvc.perform(
+            post("/api/v1/posts")
+                .header("Authorization", "Bearer ${apiKeyOf("user1")}")
+                .contentType(MediaType.APPLICATION_JSON)
+                .content("""{"title": "제목입니다", "content": "내용입니다", "price": -1}""")
+        )
+            .andExpect(status().isBadRequest)
+    }
+
+    @Test
+    @DisplayName("유료 글은 비로그인 상세 조회에서 본문이 가려진다")
+    fun t3() {
+        val post = paidPost("user1", 500)
+
+        mvc.perform(get("/api/v1/posts/${post.id}"))
+            .andExpect(status().isOk)
+            .andExpect(jsonPath("$.price").value(500))
+            .andExpect(jsonPath("$.content").value(""))
+    }
+
+    @Test
+    @DisplayName("잔액 부족이면 구매 실패(402), 구매 기록도 남지 않는다")
+    fun t4() {
+        val post = paidPost("user1", 500)
+
+        mvc.perform(
+            post("/api/v1/posts/${post.id}/purchase")
+                .header("Authorization", "Bearer ${apiKeyOf("user2")}")
+        )
+            .andExpect(status().isPaymentRequired)
+            .andExpect(jsonPath("$.resultCode").value("402-1"))
+
+        mvc.perform(
+            get("/api/v1/posts/${post.id}/content")
+                .header("Authorization", "Bearer ${apiKeyOf("user2")}")
+        )
+            .andExpect(status().isForbidden)
+    }
+
+    @Test
+    @DisplayName("충전 후 구매하면 잔액이 차감되고 본문을 볼 수 있다")
+    fun t5() {
+        val post = paidPost("user1", 500)
+        charge("user2", 1000)
+
+        mvc.perform(
+            post("/api/v1/posts/${post.id}/purchase")
+                .header("Authorization", "Bearer ${apiKeyOf("user2")}")
+        )
+            .andExpect(status().isCreated)
+            .andExpect(jsonPath("$.data.balance").value(500))
+
+        mvc.perform(
+            get("/api/v1/posts/${post.id}/content")
+                .header("Authorization", "Bearer ${apiKeyOf("user2")}")
+        )
+            .andExpect(status().isOk)
+            .andExpect(jsonPath("$.data.content").value("비밀본문"))
+
+        mvc.perform(
+            get("/api/v1/posts/${post.id}")
+                .header("Authorization", "Bearer ${apiKeyOf("user2")}")
+        )
+            .andExpect(jsonPath("$.content").value("비밀본문"))
+
+        mvc.perform(
+            get("/api/v1/wallet")
+                .header("Authorization", "Bearer ${apiKeyOf("user2")}")
+        )
+            .andExpect(jsonPath("$.data.balance").value(500))
+    }
+
+    @Test
+    @DisplayName("같은 글을 두 번 구매할 수 없고, 잔액도 한 번만 빠진다")
+    fun t6() {
+        val post = paidPost("user1", 500)
+        charge("user2", 2000)
+        val apiKey = apiKeyOf("user2")
+
+        mvc.perform(post("/api/v1/posts/${post.id}/purchase").header("Authorization", "Bearer $apiKey"))
+            .andExpect(status().isCreated)
+
+        mvc.perform(post("/api/v1/posts/${post.id}/purchase").header("Authorization", "Bearer $apiKey"))
+            .andExpect(status().isConflict)
+            .andExpect(jsonPath("$.resultCode").value("409-2"))
+
+        mvc.perform(get("/api/v1/wallet").header("Authorization", "Bearer $apiKey"))
+            .andExpect(jsonPath("$.data.balance").value(1500))
+    }
+
+    @Test
+    @DisplayName("작성자 본인과 무료 글은 구매할 수 없다")
+    fun t7() {
+        val paid = paidPost("user1", 500)
+        val free = paidPost("user1", 0)
+        charge("user1", 1000)
+        val apiKey = apiKeyOf("user1")
+
+        mvc.perform(post("/api/v1/posts/${paid.id}/purchase").header("Authorization", "Bearer $apiKey"))
+            .andExpect(status().isBadRequest)
+            .andExpect(jsonPath("$.resultCode").value("400-4"))
+
+        mvc.perform(post("/api/v1/posts/${free.id}/purchase").header("Authorization", "Bearer $apiKey"))
+            .andExpect(status().isBadRequest)
+            .andExpect(jsonPath("$.resultCode").value("400-3"))
+
+        // 작성자는 구매 없이 본문을 볼 수 있다
+        mvc.perform(get("/api/v1/posts/${paid.id}/content").header("Authorization", "Bearer $apiKey"))
+            .andExpect(status().isOk)
+            .andExpect(jsonPath("$.data.content").value("비밀본문"))
+
+        mvc.perform(get("/api/v1/wallet").header("Authorization", "Bearer $apiKey"))
+            .andExpect(jsonPath("$.data.balance").value(1000))
+    }
+
+    @Test
+    @DisplayName("무료 글 본문은 누구나 열람할 수 있고, 없는 글은 404")
+    fun t8() {
+        val free = paidPost("user1", 0)
+
+        mvc.perform(get("/api/v1/posts/${free.id}/content").header("Authorization", "Bearer ${apiKeyOf("user2")}"))
+            .andExpect(status().isOk)
+            .andExpect(jsonPath("$.data.content").value("비밀본문"))
+
+        mvc.perform(post("/api/v1/posts/999999/purchase").header("Authorization", "Bearer ${apiKeyOf("user2")}"))
+            .andExpect(status().isNotFound)
+    }
+
+    @Test
+    @DisplayName("비로그인 본문 열람과 구매는 401")
+    fun t9() {
+        val post = paidPost("user1", 500)
+
+        mvc.perform(get("/api/v1/posts/${post.id}/content"))
+            .andExpect(status().isUnauthorized)
+
+        mvc.perform(post("/api/v1/posts/${post.id}/purchase"))
+            .andExpect(status().isUnauthorized)
+    }
+
+    @Test
+    @DisplayName("목록 조회에서도 구매하지 않은 유료 글 본문은 가려지고, 구매 후에는 보인다")
+    fun t10() {
+        val post = paidPost("user1", 500)
+        charge("user2", 1000)
+        val apiKey = apiKeyOf("user2")
+
+        mvc.perform(get("/api/v1/posts").header("Authorization", "Bearer $apiKey"))
+            .andExpect(status().isOk)
+            .andExpect(jsonPath("$[?(@.id == ${post.id})].content").value(hasItem("")))
+
+        mvc.perform(post("/api/v1/posts/${post.id}/purchase").header("Authorization", "Bearer $apiKey"))
+            .andExpect(status().isCreated)
+
+        mvc.perform(get("/api/v1/posts").header("Authorization", "Bearer $apiKey"))
+            .andExpect(jsonPath("$[?(@.id == ${post.id})].content").value(hasItem("비밀본문")))
+    }
+
+    @Test
+    @DisplayName("구매하면 구매자 잔액만 차감되고, 작성자 지갑에는 가격의 90%가 들어간다")
+    fun t11() {
+        val post = paidPost("user1", 500)
+        charge("user2", 1000)
+
+        mvc.perform(
+            post("/api/v1/posts/${post.id}/purchase")
+                .header("Authorization", "Bearer ${apiKeyOf("user2")}")
+        )
+            .andExpect(status().isCreated)
+            .andExpect(jsonPath("$.data.balance").value(500))
+
+        mvc.perform(get("/api/v1/wallet").header("Authorization", "Bearer ${apiKeyOf("user1")}"))
+            .andExpect(status().isOk)
+            .andExpect(jsonPath("$.data.balance").value(450))
+    }
+
+    @Test
+    @DisplayName("글 가격은 100원 단위여야 한다 (150, 1 거부 / 0, 100, 2500 허용)")
+    fun t12() {
+        listOf(150, 1).forEach { price ->
+            mvc.perform(
+                post("/api/v1/posts")
+                    .header("Authorization", "Bearer ${apiKeyOf("user1")}")
+                    .contentType(MediaType.APPLICATION_JSON)
+                    .content("""{"title": "제목입니다", "content": "내용입니다", "price": $price}""")
+            )
+                .andExpect(status().isBadRequest)
+                .andExpect(jsonPath("$.resultCode").value("400-5"))
+        }
+
+        listOf(0, 100, 2500).forEach { price ->
+            mvc.perform(
+                post("/api/v1/posts")
+                    .header("Authorization", "Bearer ${apiKeyOf("user1")}")
+                    .contentType(MediaType.APPLICATION_JSON)
+                    .content("""{"title": "제목입니다", "content": "내용입니다", "price": $price}""")
+            )
+                .andExpect(status().isCreated)
+                .andExpect(jsonPath("$.data.postDto.price").value(price))
+        }
+    }
+}
