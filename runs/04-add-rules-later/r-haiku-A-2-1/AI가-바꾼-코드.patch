+package com.rest1.domain.wallet.wallet.service
+
+import com.rest1.domain.wallet.wallet.entity.Wallet
+import com.rest1.domain.wallet.wallet.repository.WalletRepository
+import org.springframework.stereotype.Service
+import org.springframework.transaction.annotation.Transactional
+
+@Service
+class WalletService(
+    private val walletRepository: WalletRepository,
+) {
+    // 지갑은 처음 필요할 때 만든다 (잔액 0)
+    @Transactional(readOnly = true)
+    fun balanceOf(memberId: Long): Long = walletRepository.findByMemberId(memberId)?.balance ?: 0L
+
+    // 호출한 트랜잭션 안에서 잠근 지갑을 돌려준다. 잔액 변경은 호출자가 엔티티로 한다.
+    @Transactional
+    fun lockForUpdate(memberId: Long): Wallet {
+        return walletRepository.findByMemberIdForUpdate(memberId)
+            ?: walletRepository.save(Wallet(memberId))
+    }
+
+    @Transactional
+    fun charge(memberId: Long, amount: Long): Long {
+        val wallet = lockForUpdate(memberId)
+        wallet.charge(amount)
+
+        return wallet.balance
+    }
+}
