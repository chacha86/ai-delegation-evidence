+package com.rest1.domain.post.post.service
+
+import com.rest1.domain.member.member.entity.Member
+import com.rest1.domain.post.post.entity.Post
+import com.rest1.domain.post.post.entity.PostPurchase
+import com.rest1.domain.post.post.repository.PostPurchaseRepository
+import com.rest1.domain.wallet.wallet.service.WalletService
+import com.rest1.global.exception.ServiceException
+import org.springframework.stereotype.Service
+import org.springframework.transaction.annotation.Transactional
+
+@Service
+class PostPurchaseService(
+    private val postPurchaseRepository: PostPurchaseRepository,
+    private val walletService: WalletService,
+) {
+    // 반환값은 구매 후 잔액
+    @Transactional
+    fun purchase(actor: Member, post: Post): Long {
+        post.checkPurchasable(actor)
+
+        val buyerId = actor.id!!
+        val authorId = post.author.id!!
+
+        // 구매자와 작성자 지갑을 회원 id 오름차순으로 잠가서 A->B, B->A 동시 구매가 교착되지 않게 한다
+        val lowId = minOf(buyerId, authorId)
+        val highId = maxOf(buyerId, authorId)
+        val locked = mapOf(lowId to walletService.lockForUpdate(lowId), highId to walletService.lockForUpdate(highId))
+        val buyerWallet = locked.getValue(buyerId)
+        val authorWallet = locked.getValue(authorId)
+
+        // 잠금을 잡은 뒤에 중복 검사해야 동시 구매 요청이 한 번만 성공한다
+        if (postPurchaseRepository.existsByMemberIdAndPostId(buyerId, post.id!!)) {
+            throw ServiceException("409-2", "이미 구매한 글입니다.")
+        }
+
+        buyerWallet.withdraw(post.price)
+        // 수수료 10%를 뺀 90%만 작성자 지갑에 들어간다 (나머지는 플랫폼 수수료)
+        authorWallet.charge(post.authorPayout)
+        postPurchaseRepository.save(PostPurchase(buyerId, post.id!!, post.price))
+
+        return buyerWallet.balance
+    }
+
+    @Transactional(readOnly = true)
+    fun hasPurchased(memberId: Long, postId: Long): Boolean =
+        postPurchaseRepository.existsByMemberIdAndPostId(memberId, postId)
+
+    @Transactional(readOnly = true)
+    fun purchasedPostIds(memberId: Long): Set<Long> =
+        postPurchaseRepository.findPurchasedPostIds(memberId).toSet()
+}
