+import org.springframework.transaction.annotation.Transactional
+import org.springframework.web.bind.annotation.GetMapping
+import org.springframework.web.bind.annotation.PostMapping
+import org.springframework.web.bind.annotation.RequestBody
+import org.springframework.web.bind.annotation.RequestMapping
+import org.springframework.web.bind.annotation.RestController
+
+@RestController
+@RequestMapping("/api/v1/wallet")
+@Tag(name = "ApiV1WalletController", description = "지갑 API")
+@SecurityRequirement(name = "bearerAuth")
+class ApiV1WalletController(
+    private val walletService: WalletService,
+    private val rq: Rq,
+) {
+    // 필드를 nullable 로 두는 이유는 ApiV1MemberController.JoinReqBody 주석 참고
+    data class WalletChargeReqBody(
+        @field:NotNull
+        @field:Min(1)
+        @field:Max(100_000)
+        val amount: Long?,
+    )
+
+    data class WalletResBody(
+        val balance: Long,
+    )
+
+    @GetMapping
+    @Transactional(readOnly = true)
+    @Operation(summary = "잔액 조회")
+    fun getWallet(): RsData<WalletResBody> {
+        val actor = rq.actor
+
+        return RsData(
+            "200-1",
+            "잔액을 조회했습니다.",
+            WalletResBody(walletService.balanceOf(actor.id!!)),
+        )
+    }
+
+    @PostMapping("/charge")
+    @Transactional
+    @Operation(summary = "지갑 충전")
+    fun charge(
+        @RequestBody @Valid reqBody: WalletChargeReqBody,
+    ): RsData<WalletResBody> {
+        val actor = rq.actor
+        val balance = walletService.charge(actor.id!!, reqBody.amount!!)
+
+        return RsData(
+            "200-1",
+            "${reqBody.amount}원이 충전되었습니다.",
+            WalletResBody(balance),
+        )
+    }
+}
