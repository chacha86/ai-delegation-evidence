+package com.rest1.domain.wallet.wallet.entity
+
+import com.rest1.global.exception.ServiceException
+import com.rest1.global.jpa.entity.BaseEntity
+import jakarta.persistence.Column
+import jakarta.persistence.Entity
+
+// 회원 한 명당 지갑 한 개. 잔액 단위는 원(정수)이다.
+@Entity
+class Wallet(
+    @Column(name = "member_id", unique = true, nullable = false)
+    val memberId: Long,
+    balance: Long = 0,
+) : BaseEntity() {
+    @Column(nullable = false)
+    var balance: Long = balance
+        protected set
+
+    fun charge(amount: Long) {
+        if (amount > MAX_CHARGE_AMOUNT) {
+            throw ServiceException("400-6", "1회 충전 금액은 ${MAX_CHARGE_AMOUNT}원 이하여야 합니다.")
+        }
+
+        balance += amount
+    }
+
+    companion object {
+        const val MAX_CHARGE_AMOUNT = 100_000L
+    }
+
+    fun withdraw(amount: Long) {
+        if (balance < amount) {
+            throw ServiceException("402-1", "잔액이 부족합니다.")
+        }
+
+        balance -= amount
+    }
+}
