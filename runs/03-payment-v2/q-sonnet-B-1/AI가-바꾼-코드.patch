+    @Test
+    fun crossPurchasesNoDeadlock() {
+        val a = newMember()
+        val b = newMember()
+        val pa = write(a, 1000)
+        val pb = write(b, 1000)
+        charge(a, 10000); charge(b, 10000)
+        val results = parallel(10) {
+            if (it % 2 == 0) call(a, "POST", "/api/v1/posts/$pb/purchase").response.status
+            else call(b, "POST", "/api/v1/posts/$pa/purchase").response.status
+        }
+        assertThat(results.count { it in 200..299 }).isEqualTo(2)
+        assertThat(balance(a)).isEqualTo(10000 - 1000 + 900)
+        assertThat(balance(b)).isEqualTo(10000 - 1000 + 900)
+    }
