+package com.rest1.domain.wallet.service
+
+import com.rest1.domain.member.member.repository.MemberRepository
+import com.rest1.domain.post.post.entity.Post
+import com.rest1.domain.wallet.entity.Purchase
+import com.rest1.domain.wallet.repository.PurchaseRepository
+import com.rest1.global.exception.ServiceException
+import org.springframework.stereotype.Service
+import org.springframework.transaction.annotation.Transactional
+
+@Service
+class WalletService(
+    private val memberRepository: MemberRepository,
+    private val purchaseRepository: PurchaseRepository,
+) {
+    companion object {
+        const val MAX_CHARGE = 100_000L
+        const val PRICE_UNIT = 100L
+        const val FEE_PERCENT = 10L
+
+        fun checkPrice(price: Long) {
+            if (price < 0 || price % PRICE_UNIT != 0L)
+                throw ServiceException("400-4", "글 가격은 0 이상, 100원 단위여야 합니다.")
+        }
+    }
+
+    @Transactional(readOnly = true)
+    fun balanceOf(memberId: Long): Long =
+        memberRepository.findBalanceById(memberId) ?: throw NoSuchElementException()
+
+    // 회원 행을 잠근 뒤 더하므로 동시 충전도 누락되지 않는다
+    @Transactional
+    fun charge(memberId: Long, amount: Long): Long {
+        if (amount < 1 || amount > MAX_CHARGE)
+            throw ServiceException("400-3", "충전 금액은 1 이상 100,000 이하여야 합니다.")
+
+        val member = memberRepository.findAllForUpdate(listOf(memberId)).firstOrNull()
+            ?: throw NoSuchElementException()
+        member.deposit(amount)
+
+        return member.balance
+    }
+
+    @Transactional
+    fun purchase(buyerId: Long, post: Post): Long {
+        val authorId = post.author.id!!
+
+        if (!post.isPaid) throw ServiceException("400-5", "무료 글은 구매할 수 없습니다.")
+        if (authorId == buyerId) throw ServiceException("403-3", "자신의 글은 구매할 수 없습니다.")
+
+        // 구매자와 작성자 행을 id 순으로 한 번에 잠근다 (같은 구매자의 동시 요청은 여기서 직렬화됨)
+        val locked = memberRepository.findAllForUpdate(listOf(buyerId, authorId)).associateBy { it.id }
+        val buyer = locked[buyerId] ?: throw NoSuchElementException()
+        val author = locked[authorId] ?: throw NoSuchElementException()
+
+        if (purchaseRepository.existsByPostIdAndBuyerId(post.id!!, buyerId))
+            throw ServiceException("409-1", "이미 구매한 글입니다.")
+
+        val price = post.price
+        if (buyer.balance < price) throw ServiceException("400-6", "잔액이 부족합니다.")
+
+        val income = price - price * FEE_PERCENT / 100 // 가격의 90%
+
+        buyer.withdraw(price)
+        author.deposit(income)
+        purchaseRepository.saveAndFlush(Purchase(post.id!!, buyerId, price, income))
+
+        return buyer.balance
+    }
+
+    @Transactional(readOnly = true)
+    fun hasPurchased(postId: Long, memberId: Long): Boolean =
+        purchaseRepository.existsByPostIdAndBuyerId(postId, memberId)
+
+    @Transactional(readOnly = true)
+    fun purchasedPostIds(memberId: Long): Set<Long> =
+        purchaseRepository.findPostIdsByBuyerId(memberId).toSet()
+}
