+    private fun <T> parallel(n: Int, task: (Int) -> T): List<T> {
+        val pool = Executors.newFixedThreadPool(n)
+        try {
+            val futures = pool.invokeAll((0 until n).map { i -> Callable { task(i) } })
+            return futures.map { it.get() }
+        } finally {
+            pool.shutdown()
+        }
+    }
