+    @Test
+    fun purchaseFlowAndVisibility() {
+        val author = newMember()
+        val buyer = newMember()
+        val other = newMember()
+        val id = write(author, 2500, "paid-secret")
+
+        // 열람 제한
+        fun contentLeaks(m: Member?): Boolean {
+            val urls = listOf("/api/v1/posts", "/api/v1/posts/$id", "/api/v1/posts/$id/content")
+            return urls.any { call(m, "GET", it).response.contentAsString.contains("paid-secret") }
+        }
+        assertThat(contentLeaks(null)).isFalse()
+        assertThat(contentLeaks(other)).isFalse()
+        assertThat(contentLeaks(buyer)).isFalse()
+        assertThat(call(buyer, "GET", "/api/v1/posts/$id/content").response.status).isEqualTo(403)
+        assertThat(call(author, "GET", "/api/v1/posts/$id/content").response.contentAsString).contains("paid-secret")
+        assertThat(call(author, "GET", "/api/v1/posts/$id").response.contentAsString).contains("paid-secret")
+
+        // 작성자 본인 구매 불가
+        charge(author, 5000)
+        assertThat(call(author, "POST", "/api/v1/posts/$id/purchase").response.status).isEqualTo(403)
+        assertThat(balance(author)).isEqualTo(5000)
+
+        // 잔액 부족
+        charge(buyer, 2499)
+        assertThat(call(buyer, "POST", "/api/v1/posts/$id/purchase").response.status).isEqualTo(400)
+        assertThat(balance(buyer)).isEqualTo(2499)
+
+        // 성공, 수수료 10%
+        charge(buyer, 2501)
+        assertThat(call(buyer, "POST", "/api/v1/posts/$id/purchase").response.status).isBetween(200, 299)
+        assertThat(balance(buyer)).isEqualTo(2500)
+        assertThat(balance(author)).isEqualTo(5000 + 2250)
+
+        // 중복 구매 불가
+        assertThat(call(buyer, "POST", "/api/v1/posts/$id/purchase").response.status).isEqualTo(409)
+        assertThat(balance(buyer)).isEqualTo(2500)
+        assertThat(balance(author)).isEqualTo(7250)
+
+        // 구매자는 열람 가능, 제3자는 여전히 불가
+        for (u in listOf("/api/v1/posts", "/api/v1/posts/$id", "/api/v1/posts/$id/content"))
+            assertThat(call(buyer, "GET", u).response.contentAsString).contains("paid-secret")
+        assertThat(contentLeaks(other)).isFalse()
+        assertThat(contentLeaks(null)).isFalse()
+    }
