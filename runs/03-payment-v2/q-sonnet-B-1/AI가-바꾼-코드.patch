+        assertThat(charge(m, 100001)).isEqualTo(400)
+        assertThat(charge(m, "\"abc\"")).isEqualTo(400)
+        assertThat(call(m, "POST", "/api/v1/wallet/charge", "{}").response.status).isEqualTo(400)
+        assertThat(balance(m)).isEqualTo(0)
+        assertThat(charge(m, 100000)).isBetween(200, 299)
+        assertThat(charge(m, 1)).isBetween(200, 299)
