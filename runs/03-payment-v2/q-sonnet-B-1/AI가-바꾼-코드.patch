+import java.util.concurrent.Executors
+
+// 동시성 검증을 위해 @Transactional 을 쓰지 않는다 (회원은 테스트마다 새로 만든다)
+@SpringBootTest
+@ActiveProfiles("test")
+@AutoConfigureMockMvc
+class PaymentTest {
+    @Autowired
+    private lateinit var mvc: MockMvc
+
+    @Autowired
+    private lateinit var memberRepository: MemberRepository
+
+    private val om = ObjectMapper()
+
+    private fun newMember(): Member {
+        val n = UUID.randomUUID().toString().take(8)
+        return memberRepository.save(Member("u$n", "pw", "n$n"))
+    }
+
+    private fun call(m: Member?, method: String, url: String, body: String? = null): MvcResult {
+        val b = if (method == "GET") get(url) else post(url)
+        if (m != null) b.header("Authorization", "Bearer ${m.apiKey}")
+        if (body != null) b.contentType(MediaType.APPLICATION_JSON).content(body)
+        return mvc.perform(b).andReturn()
+    }
+
+    private fun json(r: MvcResult) = om.readTree(r.response.contentAsString)
+    private fun balance(m: Member) = json(call(m, "GET", "/api/v1/wallet")).get("balance").asLong()
+    private fun charge(m: Member, amount: Any) =
+        call(m, "POST", "/api/v1/wallet/charge", """{"amount": $amount}""").response.status
+
+    private fun write(m: Member, price: Any?, content: String = "secret-content"): Long {
+        val p = if (price == null) "" else ""","price": $price"""
+        val r = call(m, "POST", "/api/v1/posts", """{"title":"title","content":"$content"$p}""")
+        assertThat(r.response.status).isBetween(200, 299)
+        return json(r).get("data").get("postDto").get("id").asLong()
+    }
+
+    @Test
+    fun walletAndChargeRules() {
+        val m = newMember()
+        assertThat(balance(m)).isEqualTo(0)
