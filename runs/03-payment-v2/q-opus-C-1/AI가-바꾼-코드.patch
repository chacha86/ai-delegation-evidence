+package com.rest1.domain.wallet.entity
+
+import com.rest1.global.jpa.entity.BaseEntity
+import jakarta.persistence.Entity
+import jakarta.persistence.Table
+import jakarta.persistence.UniqueConstraint
+
+/**
+ * 구매 기록. (postId, buyerId) 유니크 제약으로 "같은 글은 한 번만 구매" 를 DB 가 최종 보장한다.
+ *
+ * 글/회원을 FK(@ManyToOne)로 묶지 않고 id 만 저장한다.
+ * 구매된 글을 작성자가 지워도 글 삭제가 FK 때문에 실패하지 않고, 결제 기록(장부)은 남게 하기 위함이다.
+ */
+@Entity
+@Table(
+    uniqueConstraints = [UniqueConstraint(name = "uk_purchase_post_buyer", columnNames = ["post_id", "buyer_id"])],
+)
+class Purchase(
+    val postId: Long,
+    val buyerId: Long,
+    val authorId: Long,
+    val price: Long,
+    val authorIncome: Long,
+) : BaseEntity()
