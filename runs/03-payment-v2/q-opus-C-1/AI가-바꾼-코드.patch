@@ -0,0 +1,63 @@
+package com.rest1.domain.wallet
+
+import com.rest1.global.exception.ServiceException
+import java.math.BigDecimal
+
+/**
+ * 결제 관련 규칙을 한곳에 모아 둔다.
+ *
+ * 금액은 요청에서 BigDecimal 로 받는다. Long 으로 바로 받으면 Jackson 이 100.7 같은 소수를
+ * 조용히 100 으로 잘라 버리기 때문에, 소수·범위 초과를 여기서 명시적으로 거부한다.
+ */
+object PaymentPolicy {
+    const val MIN_CHARGE_AMOUNT = 1L
+    const val MAX_CHARGE_AMOUNT = 100_000L
+    const val PRICE_UNIT = 100L
+    const val PLATFORM_FEE_PERCENT = 10L
+
+    fun validateChargeAmount(raw: BigDecimal?): Long {
+        if (raw == null) throw ServiceException("400-4", "충전 금액(amount)을 입력해주세요.")
+
+        val amount = toWholeNumberOrNull(raw)
+            ?: throw ServiceException("400-4", "충전 금액은 정수여야 합니다.")
+
+        if (amount < MIN_CHARGE_AMOUNT)
+            throw ServiceException("400-4", "충전 금액은 ${MIN_CHARGE_AMOUNT}원 이상이어야 합니다.")
+        if (amount > MAX_CHARGE_AMOUNT)
+            throw ServiceException("400-4", "1회 충전 금액은 ${MAX_CHARGE_AMOUNT}원 이하여야 합니다.")
+
+        return amount
+    }
+
+    /** price 를 생략하면 무료(0원) 글이다. */
+    fun validatePrice(raw: BigDecimal?): Long {
+        if (raw == null) return 0L
+
+        val price = toWholeNumberOrNull(raw)
+            ?: throw ServiceException("400-3", "가격은 정수여야 합니다.")
+
+        if (price < 0) throw ServiceException("400-3", "가격은 0원 이상이어야 합니다.")
+        if (price % PRICE_UNIT != 0L) throw ServiceException("400-3", "가격은 ${PRICE_UNIT}원 단위여야 합니다.")
+
+        return price
+    }
+
+    /**
+     * 작성자가 받는 금액 = 가격 - 수수료(10%).
+     * 가격이 100원 단위이므로 (price / 100) * 10 으로 수수료가 정확히 나누어 떨어지고, 곱셈 오버플로도 없다.
+     */
+    fun platformFee(price: Long): Long = (price / 100) * PLATFORM_FEE_PERCENT
+
+    fun authorIncome(price: Long): Long = price - platformFee(price)
+
+    private fun toWholeNumberOrNull(raw: BigDecimal): Long? {
+        val normalized = raw.stripTrailingZeros()
+        if (normalized.scale() > 0) return null
+
+        return try {
+            normalized.longValueExact()
+        } catch (e: ArithmeticException) {
+            null
+        }
+    }
+}
