+package com.rest1.domain.wallet.service
+
+import com.rest1.domain.wallet.PaymentPolicy
+import com.rest1.domain.wallet.repository.WalletRepository
+import org.springframework.dao.DataIntegrityViolationException
+import org.springframework.stereotype.Service
+import org.springframework.transaction.PlatformTransactionManager
+import org.springframework.transaction.TransactionDefinition
+import org.springframework.transaction.support.TransactionTemplate
+
+@Service
+class WalletService(
+    private val walletRepository: WalletRepository,
+    transactionManager: PlatformTransactionManager,
+) {
+    private val tx = TransactionTemplate(transactionManager)
+
+    // 지갑 생성은 독립 트랜잭션으로 한다. 동시 생성으로 PK 충돌이 나도 바깥 트랜잭션을 망치지 않게 하기 위함.
+    private val newTx = TransactionTemplate(transactionManager).apply {
+        propagationBehavior = TransactionDefinition.PROPAGATION_REQUIRES_NEW
+    }
+
+    /** 지갑이 아직 없으면 잔액 0 으로 본다(조회만으로 행을 만들지 않는다). */
+    fun balanceOf(memberId: Long): Long = walletRepository.findBalance(memberId) ?: 0L
+
+    fun ensureWallet(memberId: Long) {
+        if (walletRepository.existsById(memberId)) return
+
+        try {
+            newTx.executeWithoutResult { walletRepository.insertIfAbsent(memberId) }
+        } catch (e: DataIntegrityViolationException) {
+            // 다른 요청이 같은 회원의 지갑을 먼저 만들었다. 지갑이 존재하므로 그대로 진행한다.
+        }
+
+        check(walletRepository.existsById(memberId)) { "지갑 생성 실패: memberId=$memberId" }
+    }
+
+    /** @return 충전 후 잔액 */
+    fun charge(memberId: Long, amount: Long): Long {
+        require(amount in PaymentPolicy.MIN_CHARGE_AMOUNT..PaymentPolicy.MAX_CHARGE_AMOUNT)
+
+        ensureWallet(memberId)
+
+        return tx.execute {
+            val updated = walletRepository.increase(memberId, amount)
+            check(updated == 1) { "지갑 충전 실패: memberId=$memberId" }
+
+            walletRepository.findBalance(memberId)!!
+        }!!
+    }
+}
