+package com.rest1.domain.wallet.controller
+
+import com.rest1.domain.wallet.PaymentPolicy
+import com.rest1.domain.wallet.service.WalletService
+import com.rest1.global.rq.Rq
+import com.rest1.global.rsData.RsData
+import io.swagger.v3.oas.annotations.Operation
+import io.swagger.v3.oas.annotations.security.SecurityRequirement
+import io.swagger.v3.oas.annotations.tags.Tag
+import org.springframework.web.bind.annotation.GetMapping
+import org.springframework.web.bind.annotation.PostMapping
+import org.springframework.web.bind.annotation.RequestBody
+import org.springframework.web.bind.annotation.RequestMapping
+import org.springframework.web.bind.annotation.RestController
+import java.math.BigDecimal
+
+@RestController
+@RequestMapping("/api/v1/wallet")
+@Tag(name = "ApiV1WalletController", description = "지갑 API")
+@SecurityRequirement(name = "bearerAuth")
+class ApiV1WalletController(
+    private val walletService: WalletService,
+    private val rq: Rq,
+) {
+    data class WalletResBody(
+        val memberId: Long,
+        val balance: Long,
+    )
+
+    @GetMapping
+    @Operation(summary = "내 지갑 잔액 조회")
+    fun getMyWallet(): WalletResBody {
+        val actorId = rq.actor.id!!
+
+        return WalletResBody(actorId, walletService.balanceOf(actorId))
+    }
+
+    data class ChargeReqBody(
+        val amount: BigDecimal?,
+    )
+
+    data class ChargeResBody(
+        val amount: Long,
+        val balance: Long,
+    )
+
+    // 트랜잭션은 WalletService 안에서 관리한다 (지갑 생성과 충전을 별도 트랜잭션으로 나누기 위함)
+    @PostMapping("/charge")
+    @Operation(summary = "지갑 충전 (1회 1 ~ 100,000)")
+    fun charge(
+        @RequestBody reqBody: ChargeReqBody,
+    ): RsData<ChargeResBody> {
+        val actorId = rq.actor.id!!
+        val amount = PaymentPolicy.validateChargeAmount(reqBody.amount)
+        val balance = walletService.charge(actorId, amount)
+
+        return RsData(
+            "200-1",
+            "${amount}원이 충전되었습니다.",
+            ChargeResBody(amount, balance),
+        )
+    }
+}
