+package com.rest1.domain.wallet.repository
+
+import com.rest1.domain.wallet.entity.Wallet
+import org.springframework.data.jpa.repository.JpaRepository
+import org.springframework.data.jpa.repository.Modifying
+import org.springframework.data.jpa.repository.Query
+
+interface WalletRepository : JpaRepository<Wallet, Long> {
+    /** 엔티티가 아닌 스칼라로 읽어 영속성 컨텍스트 캐시(OSIV)에 영향받지 않게 한다. */
+    @Query("select w.balance from Wallet w where w.memberId = :memberId")
+    fun findBalance(memberId: Long): Long?
+
+    /** 지갑이 없을 때만 0원 지갑을 만든다. 동시 생성 경합은 PK 제약 위반으로 드러나고 호출 측에서 무시한다. */
+    @Modifying
+    @Query(
+        value = "insert into wallet (member_id, balance) select :memberId, 0 from dual " +
+                "where not exists (select 1 from wallet where member_id = :memberId)",
+        nativeQuery = true,
+    )
+    fun insertIfAbsent(memberId: Long): Int
+
+    /** 원자적 증가. DB 행 잠금으로 동시 충전이 직렬화되어 누락이 없다. */
+    @Modifying
+    @Query("update Wallet w set w.balance = w.balance + :amount where w.memberId = :memberId")
+    fun increase(memberId: Long, amount: Long): Int
+
+    /** 잔액이 충분할 때만 원자적으로 차감한다. 반환값 0 이면 잔액 부족. 잔액은 절대 음수가 되지 않는다. */
+    @Modifying
+    @Query("update Wallet w set w.balance = w.balance - :amount where w.memberId = :memberId and w.balance >= :amount")
+    fun decreaseIfEnough(memberId: Long, amount: Long): Int
+}
