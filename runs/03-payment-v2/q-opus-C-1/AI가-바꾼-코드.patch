+package com.rest1.domain.wallet
+
+import com.fasterxml.jackson.databind.JsonNode
+import com.fasterxml.jackson.databind.ObjectMapper
+import com.rest1.domain.wallet.repository.PurchaseRepository
+import org.assertj.core.api.Assertions.assertThat
+import org.junit.jupiter.api.DisplayName
+import org.junit.jupiter.api.Test
+import org.springframework.beans.factory.annotation.Autowired
+import org.springframework.boot.test.context.SpringBootTest
+import org.springframework.boot.test.web.server.LocalServerPort
+import org.springframework.test.context.ActiveProfiles
+import java.net.URI
+import java.net.http.HttpClient
+import java.net.http.HttpRequest
+import java.net.http.HttpResponse
+import java.util.UUID
+import java.util.concurrent.CountDownLatch
+import java.util.concurrent.Executors
+import java.util.concurrent.TimeUnit
+import java.util.concurrent.atomic.AtomicInteger
+
+/**
+ * PaymentPolicyTest 를 보강하는 경계값·동시성·노출 테스트.
+ */
+@SpringBootTest(webEnvironment = SpringBootTest.WebEnvironment.RANDOM_PORT)
+@ActiveProfiles("test")
+class PaymentEdgeCaseTest {
+    @LocalServerPort
+    private var port: Int = 0
+
+    @Autowired
+    private lateinit var purchaseRepository: PurchaseRepository
+
+    private val http = HttpClient.newHttpClient()
+    private val om = ObjectMapper()
+
+    private data class Res(val status: Int, val body: String) {
+        val ok get() = status in 200..299
+    }
+
+    private fun call(method: String, path: String, key: String? = null, body: Any? = null, rawBody: String? = null): Res {
+        val publisher = when {
+            rawBody != null -> HttpRequest.BodyPublishers.ofString(rawBody)
+            body != null -> HttpRequest.BodyPublishers.ofString(om.writeValueAsString(body))
+            else -> HttpRequest.BodyPublishers.noBody()
+        }
+        val b = HttpRequest.newBuilder(URI.create("http://localhost:$port$path"))
+            .header("Content-Type", "application/json")
+            .method(method, publisher)
+        if (key != null) b.header("Authorization", "Bearer $key")
+        val r = http.send(b.build(), HttpResponse.BodyHandlers.ofString())
+        return Res(r.statusCode(), r.body())
+    }
+
+    private fun json(body: String): JsonNode = om.readTree(body)
+
+    private fun newUser(): String {
+        val name = "e" + UUID.randomUUID().toString().take(8)
+        call("POST", "/api/v1/members/join", body = mapOf("username" to name, "password" to "1234", "nickname" to name))
+        val login = call("POST", "/api/v1/members/login", body = mapOf("username" to name, "password" to "1234"))
+        return json(login.body).findValue("apiKey").asText()
+    }
+
+    private fun balance(key: String): Long = json(call("GET", "/api/v1/wallet", key).body).get("balance").asLong()
+    private fun charge(key: String, amount: Any?) = call("POST", "/api/v1/wallet/charge", key, mapOf("amount" to amount))
+    private fun writeRes(key: String, price: Any?, content: String = "본문-" + UUID.randomUUID().toString().take(8)): Res {
+        val body = mutableMapOf<String, Any?>("title" to "유료글", "content" to content)
+        if (price != null) body["price"] = price
+        return call("POST", "/api/v1/posts", key, body)
+    }
+    private fun write(key: String, price: Long?, content: String = "본문-" + UUID.randomUUID().toString().take(8)): Long =
+        json(writeRes(key, price, content).body).findValue("id").asLong()
+    private fun purchase(key: String, postId: Long) = call("POST", "/api/v1/posts/$postId/purchase", key)
+    private fun content(key: String?, postId: Long) = call("GET", "/api/v1/posts/$postId/content", key)
+
+    @Test
+    @DisplayName("충전 경계값: 1, 100000 은 허용 / 음수, 100001, 소수, 누락은 거부")
+    fun chargeBoundaries() {
+        val user = newUser()
+        assertThat(charge(user, 1).ok).isTrue()
+        assertThat(charge(user, 100_000).ok).isTrue()
+        assertThat(charge(user, -5).ok).isFalse()
+        assertThat(charge(user, 100_001).ok).isFalse()
+        assertThat(charge(user, 10.5).ok).isFalse()
+        assertThat(charge(user, null).ok).isFalse()
+        assertThat(call("POST", "/api/v1/wallet/charge", user, rawBody = "{}").ok).isFalse()
+        assertThat(balance(user)).isEqualTo(100_001)
+    }
+
+    @Test
+    @DisplayName("가격 경계값: 생략=0, 0/100/2500 허용, 150/소수 거부, 응답에 price 포함")
+    fun priceBoundaries() {
+        val author = newUser()
+        val freeRes = writeRes(author, null)
+        assertThat(freeRes.ok).isTrue()
+        assertThat(json(freeRes.body).findValue("price").asLong()).isEqualTo(0)
+        assertThat(writeRes(author, 0).ok).isTrue()
+        assertThat(writeRes(author, 100).ok).isTrue()
+        assertThat(writeRes(author, 2500).ok).isTrue()
+        assertThat(writeRes(author, 150).ok).isFalse()
+        assertThat(writeRes(author, 100.5).ok).isFalse()
+    }
+
+    @Test
+    @DisplayName("무료 글은 로그인한 누구나 본문을 보고, 구매 대상이 아니다. 비로그인은 /content 불가")
+    fun freePost() {
+        val author = newUser(); val other = newUser()
+        charge(other, 1000)
+        val postId = write(author, 0, "무료 본문")
+        assertThat(json(content(other, postId).body).get("content").asText()).isEqualTo("무료 본문")
+        assertThat(purchase(other, postId).ok).isFalse()
+        assertThat(balance(other)).isEqualTo(1000)
+        assertThat(content(null, postId).status).isEqualTo(401)
+    }
+
+    @Test
+    @DisplayName("목록/단건 조회: 비구매자·비로그인에게 유료 본문이 보이지 않고, 구매자·작성자에게는 보인다")
+    fun listAndItemHideContent() {
+        val author = newUser(); val buyer = newUser(); val other = newUser()
+        val secret = "비밀-" + UUID.randomUUID().toString().take(8)
+        val postId = write(author, 100, secret)
+
+        assertThat(call("GET", "/api/v1/posts", other).body).doesNotContain(secret)
+        assertThat(call("GET", "/api/v1/posts").body).doesNotContain(secret)
+        assertThat(call("GET", "/api/v1/posts/$postId").body).doesNotContain(secret)
+        assertThat(call("GET", "/api/v1/posts/$postId/comments", other).body).doesNotContain(secret)
+        assertThat(content(other, postId).status).isEqualTo(403)
+
+        assertThat(call("GET", "/api/v1/posts/$postId", author).body).contains(secret)
+        assertThat(call("GET", "/api/v1/posts", author).body).contains(secret)
+
+        charge(buyer, 100)
+        assertThat(purchase(buyer, postId).ok).isTrue()
+        assertThat(balance(buyer)).isEqualTo(0)
+        assertThat(call("GET", "/api/v1/posts", buyer).body).contains(secret)
+        assertThat(call("GET", "/api/v1/posts/$postId", buyer).body).contains(secret)
+        assertThat(call("GET", "/api/v1/posts", other).body).doesNotContain(secret)
+    }
+
+    @Test
+    @DisplayName("없는 글 구매는 실패하고 잔액 그대로")
+    fun purchaseMissingPost() {
+        val buyer = newUser()
+        charge(buyer, 1000)
+        assertThat(purchase(buyer, 999_999).ok).isFalse()
+        assertThat(balance(buyer)).isEqualTo(1000)
+    }
+
+    @Test
+    @DisplayName("같은 글 20번 동시 구매: 한 번만 차감, 구매 기록 1건, 작성자 90% 1회 적립")
+    fun concurrentSamePurchase() {
+        val author = newUser(); val buyer = newUser()
+        charge(buyer, 10_000)
+        val postId = write(author, 1000)
+        val success = AtomicInteger()
+        runConcurrently(20) { if (purchase(buyer, postId).ok) success.incrementAndGet() }
+        assertThat(success.get()).isEqualTo(1)
+        assertThat(balance(buyer)).isEqualTo(9000)
+        assertThat(balance(author)).isEqualTo(900)
+        assertThat(purchaseRepository.findAll().count { it.postId == postId }).isEqualTo(1)
+    }
+
+    @Test
+    @DisplayName("잔액으로 3개만 살 수 있을 때 10개 글 동시 구매: 정확히 3개 성공, 잔액 0, 음수 없음")
+    fun concurrentDifferentPurchases() {
+        val author = newUser(); val buyer = newUser()
+        charge(buyer, 300)
+        val postIds = (1..10).map { write(author, 100) }
+        val success = AtomicInteger()
+        runConcurrently(10) { i -> if (purchase(buyer, postIds[i]).ok) success.incrementAndGet() }
+        assertThat(success.get()).isEqualTo(3)
+        assertThat(balance(buyer)).isEqualTo(0)
+        assertThat(balance(author)).isEqualTo(270)
+    }
+
+    @Test
+    @DisplayName("지갑이 없는 상태에서 20번 동시 충전: 누락 없음 (지갑 동시 생성 경합 포함)")
+    fun concurrentFirstCharge() {
+        val user = newUser()
+        val success = AtomicInteger()
+        runConcurrently(20) { if (charge(user, 100).ok) success.incrementAndGet() }
+        assertThat(success.get()).isEqualTo(20)
+        assertThat(balance(user)).isEqualTo(2000)
+    }
+
+    @Test
+    @DisplayName("두 회원이 서로의 글을 동시에 반복 구매해도 교착 없이 금액이 맞는다")
+    fun crossPurchaseNoDeadlock() {
+        val a = newUser(); val b = newUser()
+        charge(a, 10_000); charge(b, 10_000)
+        val aPosts = (1..5).map { write(a, 100) }
+        val bPosts = (1..5).map { write(b, 100) }
+        val success = AtomicInteger()
+        runConcurrently(10) { i ->
+            val ok = if (i % 2 == 0) purchase(a, bPosts[i / 2]).ok else purchase(b, aPosts[i / 2]).ok
+            if (ok) success.incrementAndGet()
+        }
+        assertThat(success.get()).isEqualTo(10)
+        // 각자 500 지출, 450 수입
+        assertThat(balance(a)).isEqualTo(9950)
+        assertThat(balance(b)).isEqualTo(9950)
+    }
+
+    private fun runConcurrently(n: Int, task: (Int) -> Unit) {
+        val pool = Executors.newFixedThreadPool(n)
+        val start = CountDownLatch(1)
+        val done = CountDownLatch(n)
+        repeat(n) { i ->
+            pool.submit {
+                try { start.await(); task(i) } finally { done.countDown() }
+            }
+        }
+        start.countDown()
+        assertThat(done.await(60, TimeUnit.SECONDS)).isTrue()
+        pool.shutdown()
+    }
+}
