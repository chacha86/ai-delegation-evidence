+package com.rest1.domain.wallet.service
+
+import com.rest1.domain.post.post.entity.Post
+import com.rest1.domain.post.post.repository.PostRepository
+import com.rest1.domain.wallet.PaymentPolicy
+import com.rest1.domain.wallet.entity.Purchase
+import com.rest1.domain.wallet.repository.PurchaseRepository
+import com.rest1.domain.wallet.repository.WalletRepository
+import com.rest1.global.exception.ServiceException
+import org.springframework.dao.ConcurrencyFailureException
+import org.springframework.dao.DataIntegrityViolationException
+import org.springframework.data.repository.findByIdOrNull
+import org.springframework.stereotype.Service
+import org.springframework.transaction.PlatformTransactionManager
+import org.springframework.transaction.support.TransactionTemplate
+
+@Service
+class PurchaseService(
+    private val postRepository: PostRepository,
+    private val purchaseRepository: PurchaseRepository,
+    private val walletRepository: WalletRepository,
+    private val walletService: WalletService,
+    transactionManager: PlatformTransactionManager,
+) {
+    private val tx = TransactionTemplate(transactionManager)
+
+    data class PurchaseResult(
+        val postId: Long,
+        val price: Long,
+        val balance: Long,
+    )
+
+    /**
+     * 구매 한 건 = 하나의 트랜잭션 안에서
+     *   1) 구매 기록 INSERT (postId, buyerId 유니크 → 중복 구매 차단)
+     *   2) 구매자 잔액 조건부 차감 (balance >= price 일 때만 → 음수 잔액 차단)
+     *   3) 작성자에게 가격의 90% 적립
+     * 중 하나라도 실패하면 전부 롤백된다.
+     */
+    fun purchase(buyerId: Long, postId: Long): PurchaseResult {
+        val post = postRepository.findByIdOrNull(postId) ?: throw NoSuchElementException()
+        val price = post.price
+        val authorId = post.author.id!!
+
+        if (price <= 0) throw ServiceException("400-5", "무료 글은 구매할 필요가 없습니다.")
+        if (authorId == buyerId) throw ServiceException("403-3", "자신의 글은 구매할 수 없습니다.")
+        if (purchaseRepository.existsByPostIdAndBuyerId(postId, buyerId)) throw alreadyPurchased()
+
+        // 지갑 생성은 본 트랜잭션 밖에서 먼저 끝낸다 (커넥션을 동시에 두 개 잡지 않도록)
+        walletService.ensureWallet(buyerId)
+        walletService.ensureWallet(authorId)
+
+        val income = PaymentPolicy.authorIncome(price)
+
+        try {
+            return tx.execute {
+                purchaseRepository.saveAndFlush(Purchase(postId, buyerId, authorId, price, income))
+
+                // 서로의 글을 동시에 사는 경우의 교착을 막기 위해 항상 회원 id 오름차순으로 지갑 행을 잠근다
+                for (memberId in listOf(buyerId, authorId).sorted()) {
+                    if (memberId == buyerId) {
+                        if (walletRepository.decreaseIfEnough(buyerId, price) != 1)
+                            throw ServiceException("400-6", "잔액이 부족합니다.")
+                    } else {
+                        check(walletRepository.increase(authorId, income) == 1) { "작성자 지갑 적립 실패" }
+                    }
+                }
+
+                PurchaseResult(postId, price, walletRepository.findBalance(buyerId)!!)
+            }!!
+        } catch (e: DataIntegrityViolationException) {
+            // 동시에 들어온 같은 구매 요청이 유니크 제약에 걸린 경우
+            throw alreadyPurchased()
+        } catch (e: ConcurrencyFailureException) {
+            throw ServiceException("409-3", "동시에 처리 중인 요청이 있습니다. 잠시 후 다시 시도해주세요.")
+        }
+    }
+
+    fun canViewContent(post: Post, viewerId: Long?): Boolean {
+        if (post.price <= 0) return true
+        if (viewerId == null) return false
+        if (post.author.id == viewerId) return true
+
+        return purchaseRepository.existsByPostIdAndBuyerId(post.id!!, viewerId)
+    }
+
+    /** 목록 조회용: 글마다 쿼리를 날리지 않고 한 번에 열람 가능 여부를 계산한다. */
+    fun viewablePostIds(posts: List<Post>, viewerId: Long?): Set<Long> {
+        val (free, paid) = posts.partition { it.price <= 0 }
+        val result = free.mapNotNull { it.id }.toMutableSet()
+
+        if (viewerId == null || paid.isEmpty()) return result
+
+        paid.filter { it.author.id == viewerId }.mapNotNull { it.id }.let(result::addAll)
+
+        val notOwned = paid.filter { it.author.id != viewerId }.mapNotNull { it.id }
+        if (notOwned.isNotEmpty()) result.addAll(purchaseRepository.findPurchasedPostIds(viewerId, notOwned))
+
+        return result
+    }
+
+    private fun alreadyPurchased() = ServiceException("409-2", "이미 구매한 글입니다.")
+}
