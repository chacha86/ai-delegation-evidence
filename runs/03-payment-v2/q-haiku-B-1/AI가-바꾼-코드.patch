+package com.rest1.domain.post.purchase.service
+
+import com.rest1.domain.member.member.entity.Member
+import com.rest1.domain.member.member.service.MemberService
+import com.rest1.domain.post.post.service.PostService
+import com.rest1.domain.post.purchase.repository.PurchaseRepository
+import com.rest1.domain.wallet.wallet.service.WalletService
+import com.rest1.global.exception.ServiceException
+import org.assertj.core.api.Assertions.assertThat
+import org.junit.jupiter.api.DisplayName
+import org.junit.jupiter.api.Test
+import org.springframework.beans.factory.annotation.Autowired
+import org.springframework.boot.test.context.SpringBootTest
+import org.springframework.test.context.ActiveProfiles
+import java.math.BigDecimal
+import java.util.UUID
+import java.util.concurrent.Callable
+import java.util.concurrent.CountDownLatch
+import java.util.concurrent.Executors
+import java.util.concurrent.TimeUnit
+
+// 트랜잭션 없이 실제로 커밋되는 동시 요청을 검증한다.
+// 같은 DB(payment_test)를 쓰지만 테스트마다 새 회원/글을 만들어 서로 간섭하지 않는다.
+@SpringBootTest(properties = ["spring.datasource.url=jdbc:h2:mem:payment_test;MODE=MySQL"])
+@ActiveProfiles("test")
+class PaymentConcurrencyTest {
+    @Autowired
+    private lateinit var memberService: MemberService
+
+    @Autowired
+    private lateinit var postService: PostService
+
+    @Autowired
+    private lateinit var walletService: WalletService
+
+    @Autowired
+    private lateinit var purchaseService: PurchaseService
+
+    @Autowired
+    private lateinit var purchaseRepository: PurchaseRepository
+
+    private fun newMember(): Member =
+        memberService.join("c_${UUID.randomUUID().toString().take(8)}", "1234", "동시성")
+
+    // 모든 작업을 같은 순간에 출발시키고, 각 작업의 예외(없으면 null)를 돌려준다
+    private fun runConcurrently(count: Int, task: (Int) -> Unit): List<Throwable?> {
+        val pool = Executors.newFixedThreadPool(count)
+        val start = CountDownLatch(1)
+
+        val futures = (0 until count).map { i ->
+            pool.submit(Callable<Throwable?> {
+                start.await()
+                try {
+                    task(i)
+                    null
+                } catch (e: Throwable) {
+                    e
+                }
+            })
+        }
+
+        start.countDown()
+        val results = futures.map { it.get(60, TimeUnit.SECONDS) }
+        pool.shutdown()
+
+        return results
+    }
+
+    @Test
+    @DisplayName("같은 글을 동시에 10번 구매해도 한 번만 성공하고 한 번만 차감")
+    fun sameBuyerSamePostRace() {
+        val author = newMember()
+        val buyer = newMember()
+        walletService.charge(buyer.id!!, BigDecimal(5000))
+        val post = postService.write(author, "동시구매", "본문입니다", 1000L)
+
+        val results = runConcurrently(10) {
+            purchaseService.purchase(buyer.id!!, post.id!!)
+        }
+
+        val successes = results.count { it == null }
+        assertThat(successes).isEqualTo(1)
+        assertThat(results.filterNotNull()).allMatch { it is ServiceException }
+        assertThat(walletService.balanceOf(buyer.id!!)).isEqualTo(4000L)
+        assertThat(walletService.balanceOf(author.id!!)).isEqualTo(900L)
+        assertThat(purchaseRepository.existsByMemberIdAndPostId(buyer.id!!, post.id!!)).isTrue()
+    }
+
+    @Test
+    @DisplayName("동시에 100원씩 20번 충전하면 2000원이 정확히 들어간다")
+    fun concurrentCharges() {
+        val member = newMember()
+
+        val results = runConcurrently(20) {
+            walletService.charge(member.id!!, BigDecimal(100))
+        }
+
+        assertThat(results.filterNotNull()).isEmpty()
+        assertThat(walletService.balanceOf(member.id!!)).isEqualTo(2000L)
+    }
+
+    @Test
+    @DisplayName("잔액 2500원으로 1000원짜리 5개를 동시에 사면 2개만 성공하고 잔액은 음수가 되지 않는다")
+    fun insufficientBalanceRace() {
+        val author = newMember()
+        val buyer = newMember()
+        walletService.charge(buyer.id!!, BigDecimal(2500))
+        val postIds = (0 until 5).map { i ->
+            postService.write(author, "동시$i", "본문입니다", 1000L).id!!
+        }
+
+        val results = runConcurrently(5) { i ->
+            purchaseService.purchase(buyer.id!!, postIds[i])
+        }
+
+        assertThat(results.count { it == null }).isEqualTo(2)
+        assertThat(results.filterNotNull()).allMatch { it is ServiceException }
+        assertThat(walletService.balanceOf(buyer.id!!)).isEqualTo(500L)
+        assertThat(walletService.balanceOf(author.id!!)).isEqualTo(1800L)
+    }
+}
