+
+    @Test
+    @DisplayName("잘못된 충전 금액은 거부하고 잔액은 그대로")
+    fun t4() {
+        val member = newMember()
+        charge(member, """{"amount": 1000}""").andExpect(status().isOk)
+
+        val invalidBodies = listOf(
+            """{"amount": 0}""",
+            """{"amount": -100}""",
+            """{"amount": 100001}""",
+            """{"amount": 1.5}""",
+            """{}""",
+        )
+
+        for (body in invalidBodies) {
+            charge(member, body).andExpect(status().isBadRequest)
+        }
+
+        assertThat(
+            memberBalance(member)
