+package com.rest1.domain.post.purchase.service
+
+import com.rest1.domain.post.post.entity.Post
+import com.rest1.domain.post.post.service.PostService
+import com.rest1.domain.post.purchase.entity.Purchase
+import com.rest1.domain.post.purchase.repository.PurchaseRepository
+import com.rest1.domain.wallet.wallet.service.WalletService
+import com.rest1.global.exception.ServiceException
+import org.springframework.dao.DataIntegrityViolationException
+import org.springframework.stereotype.Service
+import org.springframework.transaction.annotation.Transactional
+
+@Service
+class PurchaseService(
+    private val purchaseRepository: PurchaseRepository,
+    private val postService: PostService,
+    private val walletService: WalletService,
+) {
+    // 구매: 구매자·작성자 지갑을 잠그고(잔액 검사 + 차감 + 지급), 구매 기록을 남긴다.
+    // 어느 단계든 실패하면 전체가 롤백되어 돈이 한 번만 빠지거나 음수가 되지 않는다.
+    @Transactional
+    fun purchase(buyerId: Long, postId: Long): Purchase {
+        val post = postService.findById(postId) ?: throw NoSuchElementException()
+
+        if (post.price <= 0L) {
+            throw ServiceException("400-7", "무료 글은 구매할 수 없습니다.")
+        }
+
+        val authorId = post.author.id!!
+
+        if (authorId == buyerId) {
+            throw ServiceException("400-10", "자신이 작성한 글은 구매할 수 없습니다.")
+        }
+
+        // 잠금을 먼저 잡아야 같은 구매자의 중복 구매 검사가 직렬화된다
+        val wallets = walletService.lockWallets(listOf(buyerId, authorId))
+
+        if (purchaseRepository.existsByMemberIdAndPostId(buyerId, postId)) {
+            throw ServiceException("400-9", "이미 구매한 글입니다.")
+        }
+
+        val buyerWallet = wallets.getValue(buyerId)
+        val authorWallet = wallets.getValue(authorId)
+
+        buyerWallet.withdraw(post.price)
+        authorWallet.deposit(payoutOf(post.price))
+
+        try {
+            return purchaseRepository.saveAndFlush(Purchase(buyerId, postId))
+        } catch (e: DataIntegrityViolationException) {
+            throw ServiceException("400-9", "이미 구매한 글입니다.")
+        }
+    }
+
+    // 작성자 지급액: 가격의 90% (가격은 100원 단위이므로 정수로 정확히 나뉜다)
+    private fun payoutOf(price: Long): Long = price / 10 * 9
+
+    // 작성자와 구매자만 본문을 볼 수 있다. 무료 글은 로그인 사용자 누구나(인증은 시큐리티가 처리).
+    @Transactional(readOnly = true)
+    fun canViewContent(post: Post, viewerId: Long?): Boolean {
+        if (post.price == 0L) return true
+        if (viewerId == null) return false
+        if (post.author.id == viewerId) return true
+
+        return purchaseRepository.existsByMemberIdAndPostId(viewerId, post.id!!)
+    }
+
+    @Transactional(readOnly = true)
+    fun purchasedPostIds(viewerId: Long): Set<Long> = purchaseRepository.findPostIdsByMemberId(viewerId).toSet()
+}
