+import org.springframework.transaction.annotation.Transactional
+import java.math.BigDecimal
+
+@Service
+class WalletService(
+    private val walletRepository: WalletRepository,
+) {
+    companion object {
+        private val MIN_CHARGE = BigDecimal.ONE
+        private val MAX_CHARGE = BigDecimal("100000")
+    }
+
+    @Transactional
+    fun create(memberId: Long): Wallet = walletRepository.save(Wallet(memberId))
+
+    @Transactional(readOnly = true)
+    fun balanceOf(memberId: Long): Long = walletRepository.findByMemberId(memberId)?.balance ?: 0L
+
+    @Transactional
+    fun charge(memberId: Long, rawAmount: BigDecimal): Long {
+        val amount = validateChargeAmount(rawAmount)
+
+        val wallet = lockWallets(listOf(memberId)).getValue(memberId)
+        wallet.deposit(amount)
+
+        return wallet.balance
+    }
+
+    // 지갑을 잠근 상태로 돌려준다. 지갑이 없으면 만든다(가입 시 만들지만 방어적으로).
+    // 호출한 트랜잭션이 끝날 때까지 잠금이 유지된다.
+    @Transactional
+    fun lockWallets(memberIds: Collection<Long>): Map<Long, Wallet> {
+        val distinctIds = memberIds.distinct()
+        val found = walletRepository.findAllLockedByMemberIdIn(distinctIds).associateBy { it.memberId }
+
+        return distinctIds.associateWith { id -> found[id] ?: walletRepository.save(Wallet(id)) }
+    }
+
+    private fun validateChargeAmount(amount: BigDecimal): Long {
+        if (amount < MIN_CHARGE) {
+            throw ServiceException("400-3", "충전 금액은 1 이상이어야 합니다.")
+        }
+        if (amount.stripTrailingZeros().scale() > 0) {
+            throw ServiceException("400-4", "충전 금액은 정수여야 합니다.")
+        }
+        if (amount > MAX_CHARGE) {
+            throw ServiceException("400-5", "1회 충전 금액은 100,000 이하여야 합니다.")
+        }
+
+        return amount.toLong()
+    }
+}
