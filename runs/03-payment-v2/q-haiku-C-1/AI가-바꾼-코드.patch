+package com.rest1.domain.wallet.service
+
+import com.rest1.domain.post.post.dto.PostDto
+import com.rest1.domain.post.post.entity.Post
+import com.rest1.domain.wallet.entity.PostPurchase
+import com.rest1.domain.wallet.repository.PostPurchaseRepository
+import com.rest1.global.exception.ServiceException
+import org.springframework.stereotype.Service
+import org.springframework.transaction.annotation.Transactional
+
+@Service
+class PaymentService(
+    private val walletService: WalletService,
+    private val postPurchaseRepository: PostPurchaseRepository,
+) {
+    companion object {
+        // 플랫폼 수수료 10%: 작성자에게는 가격의 90%가 들어간다
+        private const val AUTHOR_SHARE_PERCENT = 90L
+    }
+
+    // 무료 글, 작성자, 구매자는 본문을 볼 수 있다
+    fun canReadContent(post: Post, viewerId: Long?): Boolean {
+        if (!post.isPaid) return true
+        if (viewerId == null) return false
+        if (post.author.id == viewerId) return true
+
+        return isPurchased(viewerId, post.id!!)
+    }
+
+    private fun isPurchased(buyerId: Long, postId: Long): Boolean =
+        postPurchaseRepository.existsByBuyerIdAndPostId(buyerId, postId)
+
+    // 목록 조회용: 구매 여부를 한 번의 쿼리로 모아서 판정한다
+    fun toDtos(posts: List<Post>, viewerId: Long?): List<PostDto> {
+        val purchasedPostIds: Set<Long> = viewerId
+            ?.let { postPurchaseRepository.findPostIdsByBuyerId(it).toSet() }
+            ?: emptySet()
+
+        return posts.map { post ->
+            val readable = !post.isPaid ||
+                    (viewerId != null && post.author.id == viewerId) ||
+                    purchasedPostIds.contains(post.id!!)
+            PostDto(post, readable)
+        }
+    }
+
+    @Transactional
+    fun purchase(buyerId: Long, post: Post) {
+        if (!post.isPaid) {
+            throw ServiceException("400-6", "무료 글은 구매할 수 없습니다.")
+        }
+
+        val authorId = post.author.id!!
+        if (authorId == buyerId) {
+            throw ServiceException("403-3", "본인 글은 구매할 수 없습니다.")
+        }
+
+        // 교차 구매로 인한 교착을 피하려고 회원 id 순서대로 잠근다
+        val wallets = listOf(buyerId, authorId).sorted().associateWith { walletService.lockWallet(it) }
+        val buyerWallet = wallets.getValue(buyerId)
+        val authorWallet = wallets.getValue(authorId)
+
+        if (postPurchaseRepository.existsByBuyerIdAndPostId(buyerId, post.id!!)) {
+            throw ServiceException("409-1", "이미 구매한 글입니다.")
+        }
+
+        buyerWallet.withdraw(post.price)
+        authorWallet.deposit(post.price * AUTHOR_SHARE_PERCENT / 100)
+
+        postPurchaseRepository.save(PostPurchase(buyerId, post.id!!, post.price))
+    }
+}
