+package com.rest1.domain.wallet.service
+
+import com.rest1.domain.wallet.entity.Wallet
+import com.rest1.domain.wallet.repository.WalletRepository
+import com.rest1.global.exception.ServiceException
+import org.springframework.stereotype.Service
+import org.springframework.transaction.annotation.Transactional
+
+@Service
+class WalletService(
+    private val walletRepository: WalletRepository,
+) {
+    companion object {
+        const val MAX_CHARGE_AMOUNT = 100_000L
+    }
+
+    // 회원 가입 시 호출한다. 이미 있으면 그대로 둔다
+    @Transactional
+    fun createWallet(memberId: Long) {
+        if (walletRepository.findByMemberId(memberId) == null) {
+            walletRepository.saveAndFlush(Wallet(memberId))
+        }
+    }
+
+    @Transactional(readOnly = true)
+    fun balanceOf(memberId: Long): Long = walletRepository.findByMemberId(memberId)?.balance ?: 0L
+
+    // 호출한 트랜잭션 안에서 지갑 행을 잠근 채로 돌려준다 (커밋 전까지 잠금 유지)
+    fun lockWallet(memberId: Long): Wallet {
+        walletRepository.findByMemberIdForUpdate(memberId)?.let { return it }
+        // 가입 전에 만들어진 회원 등 지갑이 없는 경우
+        createWallet(memberId)
+        return walletRepository.findByMemberIdForUpdate(memberId)!!
+    }
+
+    @Transactional
+    fun charge(memberId: Long, amount: Long?): Long {
+        if (amount == null || amount < 1) {
+            throw ServiceException("400-4", "충전 금액은 1 이상이어야 합니다.")
+        }
+        if (amount > MAX_CHARGE_AMOUNT) {
+            throw ServiceException("400-5", "1회 충전 금액은 100,000 이하여야 합니다.")
+        }
+
+        val wallet = lockWallet(memberId)
+        wallet.deposit(amount)
+
+        return wallet.balance
+    }
+}
