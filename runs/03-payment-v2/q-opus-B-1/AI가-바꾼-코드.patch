+package com.rest1.domain.wallet.wallet.repository
+
+import com.rest1.domain.wallet.wallet.entity.Wallet
+import org.springframework.data.jpa.repository.JpaRepository
+import org.springframework.data.jpa.repository.Modifying
+import org.springframework.data.jpa.repository.Query
+import org.springframework.data.repository.query.Param
+
+interface WalletRepository : JpaRepository<Wallet, Long> {
+    fun existsByMemberId(memberId: Long): Boolean
+
+    @Query("select w.balance from Wallet w where w.member.id = :memberId")
+    fun findBalanceByMemberId(@Param("memberId") memberId: Long): Long?
+
+    /** 원자적 입금. 갱신된 행 수(지갑이 있으면 1)를 돌려준다. */
+    @Modifying(flushAutomatically = true)
+    @Query("update Wallet w set w.balance = w.balance + :amount where w.member.id = :memberId")
+    fun increaseBalance(@Param("memberId") memberId: Long, @Param("amount") amount: Long): Int
+
+    /**
+     * 원자적 출금. 잔액이 amount 이상일 때만 차감한다.
+     * 0 을 돌려주면 잔액 부족(또는 지갑 없음)이고 아무것도 바뀌지 않는다. 그래서 잔액은 음수가 될 수 없다.
+     */
+    @Modifying(flushAutomatically = true)
+    @Query("update Wallet w set w.balance = w.balance - :amount where w.member.id = :memberId and w.balance >= :amount")
+    fun decreaseBalanceIfEnough(@Param("memberId") memberId: Long, @Param("amount") amount: Long): Int
+}
