@@ -0,0 +1,326 @@
+package com.rest1.domain.payment
+
+import com.fasterxml.jackson.databind.JsonNode
+import com.fasterxml.jackson.databind.ObjectMapper
+import com.rest1.domain.member.member.entity.Member
+import com.rest1.domain.member.member.service.MemberService
+import com.rest1.domain.post.purchase.repository.PurchaseRepository
+import org.assertj.core.api.Assertions.assertThat
+import org.junit.jupiter.api.DisplayName
+import org.junit.jupiter.api.Test
+import org.springframework.beans.factory.annotation.Autowired
+import org.springframework.boot.test.autoconfigure.web.servlet.AutoConfigureMockMvc
+import org.springframework.boot.test.context.SpringBootTest
+import org.springframework.http.MediaType
+import org.springframework.test.annotation.DirtiesContext
+import org.springframework.test.context.ActiveProfiles
+import org.springframework.test.web.servlet.MockMvc
+import org.springframework.test.web.servlet.request.MockHttpServletRequestBuilder
+import org.springframework.test.web.servlet.request.MockMvcRequestBuilders.delete
+import org.springframework.test.web.servlet.request.MockMvcRequestBuilders.get
+import org.springframework.test.web.servlet.request.MockMvcRequestBuilders.post
+import java.util.UUID
+import java.util.concurrent.Callable
+import java.util.concurrent.CountDownLatch
+import java.util.concurrent.Executors
+import java.util.concurrent.TimeUnit
+
+/**
+ * 유료 글 결제 기능 통합 테스트.
+ * 동시성 검증을 위해 실제 커밋이 일어나야 하므로 클래스에 @Transactional 을 붙이지 않는다.
+ * 대신 데이터가 다른 테스트 클래스에 섞이지 않도록 끝나면 컨텍스트(인메모리 DB)를 버린다.
+ */
+@SpringBootTest
+@ActiveProfiles("test")
+@AutoConfigureMockMvc
+@DirtiesContext(classMode = DirtiesContext.ClassMode.AFTER_CLASS)
+class PaymentFeatureTest {
+    @Autowired
+    private lateinit var mvc: MockMvc
+
+    @Autowired
+    private lateinit var memberService: MemberService
+
+    @Autowired
+    private lateinit var purchaseRepository: PurchaseRepository
+
+    @Autowired
+    private lateinit var objectMapper: ObjectMapper
+
+    private data class Res(val status: Int, val body: JsonNode?)
+
+    private fun newMember(): Member {
+        val username = "p" + UUID.randomUUID().toString().substring(0, 8)
+        return memberService.join(username, "1234", username)
+    }
+
+    private fun call(builder: MockHttpServletRequestBuilder, member: Member?, json: String? = null): Res {
+        if (member != null) builder.header("Authorization", "Bearer ${member.apiKey}")
+        if (json != null) builder.contentType(MediaType.APPLICATION_JSON).content(json)
+
+        val response = mvc.perform(builder).andReturn().response
+        val text = response.getContentAsString(Charsets.UTF_8)
+        val body = if (text.isBlank()) null else runCatching { objectMapper.readTree(text) }.getOrNull()
+
+        return Res(response.status, body)
+    }
+
+    private fun balance(member: Member): Long {
+        val res = call(get("/api/v1/wallet"), member)
+        assertThat(res.status).isEqualTo(200)
+        return res.body!!["balance"].asLong()
+    }
+
+    private fun charge(member: Member, amountJson: String): Res =
+        call(post("/api/v1/wallet/charge"), member, """{"amount": $amountJson}""")
+
+    private fun writePost(author: Member, price: String?): Res {
+        val priceField = if (price == null) "" else """, "price": $price"""
+        return call(post("/api/v1/posts"), author, """{"title": "유료글", "content": "비밀본문"$priceField}""")
+    }
+
+    private fun writePostId(author: Member, price: Long): Long {
+        val res = writePost(author, price.toString())
+        assertThat(res.status).isEqualTo(201)
+        return res.body!!["data"]["postDto"]["id"].asLong()
+    }
+
+    private fun purchase(buyer: Member, postId: Long): Res = call(post("/api/v1/posts/$postId/purchase"), buyer)
+
+    @Test
+    @DisplayName("지갑: 처음 잔액 0, 충전, 잘못된 충전 금액 거부")
+    fun wallet() {
+        val m = newMember()
+        assertThat(balance(m)).isEqualTo(0)
+
+        val ok = charge(m, "1000")
+        assertThat(ok.status).isEqualTo(200)
+        assertThat(ok.body!!["data"]["balance"].asLong()).isEqualTo(1000)
+        assertThat(balance(m)).isEqualTo(1000)
+
+        for (bad in listOf("0", "-1", "-1000", "100001", "1.5", "null", "\"abc\"", "99999999999999999999999")) {
+            val res = charge(m, bad)
+            assertThat(res.status).describedAs("amount=$bad").isBetween(400, 499)
+        }
+        assertThat(call(post("/api/v1/wallet/charge"), m, "{}").status).isBetween(400, 499)
+        assertThat(balance(m)).isEqualTo(1000)
+
+        assertThat(charge(m, "100000").status).isEqualTo(200)
+        assertThat(charge(m, "1").status).isEqualTo(200)
+        assertThat(balance(m)).isEqualTo(101001)
+
+        // 비로그인
+        assertThat(call(get("/api/v1/wallet"), null).status).isEqualTo(401)
+        assertThat(call(post("/api/v1/wallet/charge"), null, """{"amount": 100}""").status).isEqualTo(401)
+    }
+
+    @Test
+    @DisplayName("글 가격: 생략시 0, 0 이상 100원 단위만 허용")
+    fun price() {
+        val a = newMember()
+
+        val free = writePost(a, null)
+        assertThat(free.status).isEqualTo(201)
+        assertThat(free.body!!["data"]["postDto"]["price"].asLong()).isEqualTo(0)
+
+        for (okPrice in listOf("0", "100", "2500")) {
+            val res = writePost(a, okPrice)
+            assertThat(res.status).describedAs("price=$okPrice").isEqualTo(201)
+            assertThat(res.body!!["data"]["postDto"]["price"].asLong()).isEqualTo(okPrice.toLong())
+        }
+
+        for (badPrice in listOf("150", "-100", "50", "100.5", "1", "\"x\"")) {
+            assertThat(writePost(a, badPrice).status).describedAs("price=$badPrice").isBetween(400, 499)
+        }
+    }
+
+    @Test
+    @DisplayName("구매: 잔액 부족, 성공(작성자 90%), 중복, 자기 글, 무료 글")
+    fun purchaseRules() {
+        val author = newMember()
+        val buyer = newMember()
+        val postId = writePostId(author, 1000)
+
+        // 잔액 부족
+        charge(buyer, "999")
+        assertThat(purchase(buyer, postId).status).isBetween(400, 499)
+        assertThat(balance(buyer)).isEqualTo(999)
+        assertThat(balance(author)).isEqualTo(0)
+
+        // 성공
+        charge(buyer, "1")
+        val ok = purchase(buyer, postId)
+        assertThat(ok.status).isBetween(200, 299)
+        assertThat(balance(buyer)).isEqualTo(0)
+        assertThat(balance(author)).isEqualTo(900)
+
+        // 중복 구매
+        charge(buyer, "5000")
+        assertThat(purchase(buyer, postId).status).isBetween(400, 499)
+        assertThat(balance(buyer)).isEqualTo(5000)
+        assertThat(balance(author)).isEqualTo(900)
+
+        // 자기 글
+        charge(author, "5000")
+        assertThat(purchase(author, postId).status).isBetween(400, 499)
+        assertThat(balance(author)).isEqualTo(5900)
+
+        // 무료 글
+        val freeId = writePostId(author, 0)
+        assertThat(purchase(buyer, freeId).status).isBetween(400, 499)
+        assertThat(balance(buyer)).isEqualTo(5000)
+
+        // 없는 글
+        assertThat(purchase(buyer, 999999).status).isEqualTo(404)
+
+        // 비로그인
+        assertThat(call(post("/api/v1/posts/$postId/purchase"), null).status).isEqualTo(401)
+    }
+
+    @Test
+    @DisplayName("열람: 유료 글 본문은 작성자/구매자만, 목록·단건 조회에서도 숨김")
+    fun contentVisibility() {
+        val author = newMember()
+        val buyer = newMember()
+        val other = newMember()
+        val admin = memberService.findByUsername("admin")!!
+        val paidId = writePostId(author, 500)
+        val freeId = writePostId(author, 0)
+
+        fun content(m: Member?, id: Long) = call(get("/api/v1/posts/$id/content"), m)
+        fun item(m: Member?, id: Long) = call(get("/api/v1/posts/$id"), m)
+        fun listItem(m: Member?, id: Long): JsonNode {
+            val res = call(get("/api/v1/posts"), m)
+            assertThat(res.status).isEqualTo(200)
+            return res.body!!.first { it["id"].asLong() == id }
+        }
+
+        // 구매 전: 다른 사람, 관리자, 비로그인 모두 본문 불가
+        for (m in listOf(buyer, other, admin)) {
+            assertThat(content(m, paidId).status).isEqualTo(403)
+        }
+        assertThat(content(null, paidId).status).isEqualTo(401)
+        for (m in listOf(buyer, other, admin, null)) {
+            val single = item(m, paidId)
+            assertThat(single.status).isEqualTo(200)
+            assertThat(single.body!!["content"].isNull).isTrue()
+            assertThat(single.body!!["contentLocked"].asBoolean()).isTrue()
+            assertThat(listItem(m, paidId)["content"].isNull).isTrue()
+        }
+
+        // 작성자는 구매 없이 열람
+        val byAuthor = content(author, paidId)
+        assertThat(byAuthor.status).isEqualTo(200)
+        assertThat(byAuthor.body!!["content"].asText()).isEqualTo("비밀본문")
+        assertThat(item(author, paidId).body!!["content"].asText()).isEqualTo("비밀본문")
+        assertThat(listItem(author, paidId)["content"].asText()).isEqualTo("비밀본문")
+
+        // 구매 후 구매자는 열람, 다른 사람은 여전히 불가
+        charge(buyer, "500")
+        assertThat(purchase(buyer, paidId).status).isBetween(200, 299)
+        assertThat(content(buyer, paidId).body!!["content"].asText()).isEqualTo("비밀본문")
+        assertThat(item(buyer, paidId).body!!["content"].asText()).isEqualTo("비밀본문")
+        assertThat(listItem(buyer, paidId)["content"].asText()).isEqualTo("비밀본문")
+        assertThat(content(other, paidId).status).isEqualTo(403)
+        assertThat(item(other, paidId).body!!["content"].isNull).isTrue()
+
+        // 무료 글은 로그인한 누구나
+        for (m in listOf(author, buyer, other, admin)) {
+            val res = content(m, freeId)
+            assertThat(res.status).isEqualTo(200)
+            assertThat(res.body!!["content"].asText()).isEqualTo("비밀본문")
+        }
+    }
