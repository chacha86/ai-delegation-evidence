+package com.rest1.domain.wallet.wallet.controller
+
+import com.rest1.domain.wallet.wallet.service.WalletService
+import com.rest1.global.rq.Rq
+import com.rest1.global.rsData.RsData
+import com.rest1.standard.ut.Amounts
+import io.swagger.v3.oas.annotations.Operation
+import io.swagger.v3.oas.annotations.security.SecurityRequirement
+import io.swagger.v3.oas.annotations.tags.Tag
+import jakarta.validation.Valid
+import jakarta.validation.constraints.NotNull
+import org.springframework.web.bind.annotation.GetMapping
+import org.springframework.web.bind.annotation.PostMapping
+import org.springframework.web.bind.annotation.RequestBody
+import org.springframework.web.bind.annotation.RequestMapping
+import org.springframework.web.bind.annotation.RestController
+import java.math.BigDecimal
+
+// 트랜잭션은 WalletService 안에서 관리한다
+@RestController
+@RequestMapping("/api/v1/wallet")
+@Tag(name = "ApiV1WalletController", description = "지갑 API")
+@SecurityRequirement(name = "bearerAuth")
+class ApiV1WalletController(
+    private val walletService: WalletService,
+    private val rq: Rq,
+) {
+    data class WalletResBody(
+        val memberId: Long,
+        val balance: Long,
+    )
+
+    @GetMapping
+    @Operation(summary = "내 지갑 잔액 조회")
+    fun getMyWallet(): WalletResBody {
+        val actor = rq.actor
+
+        return WalletResBody(actor.id!!, walletService.getBalance(actor.id!!))
+    }
+
+    data class ChargeReqBody(
+        @field:NotNull
+        val amount: BigDecimal?,
+    )
+
+    @PostMapping("/charge")
+    @Operation(summary = "지갑 충전 (1회 1 ~ 100,000)")
+    fun charge(
+        @RequestBody @Valid reqBody: ChargeReqBody,
+    ): RsData<WalletResBody> {
+        val actor = rq.actor
+        val amount = Amounts.toLongExact(reqBody.amount!!, "amount")
+        val balance = walletService.charge(actor.id!!, amount)
+
+        return RsData(
+            "200-1",
+            "${amount}원이 충전되었습니다.",
+            WalletResBody(actor.id!!, balance),
+        )
+    }
+}
