--- /dev/null
+++ b/src/main/kotlin/com/rest1/domain/post/purchase/service/PurchaseService.kt
@@ -0,0 +1,139 @@
+package com.rest1.domain.post.purchase.service
+
+import com.rest1.domain.member.member.repository.MemberRepository
+import com.rest1.domain.post.post.entity.Post
+import com.rest1.domain.post.post.repository.PostRepository
+import com.rest1.domain.post.purchase.entity.Purchase
+import com.rest1.domain.post.purchase.repository.PurchaseRepository
+import com.rest1.domain.wallet.wallet.repository.WalletRepository
+import com.rest1.domain.wallet.wallet.service.WalletService
+import com.rest1.global.exception.ServiceException
+import org.springframework.dao.DataAccessException
+import org.springframework.data.repository.findByIdOrNull
+import org.springframework.stereotype.Service
+import org.springframework.transaction.PlatformTransactionManager
+import org.springframework.transaction.support.TransactionTemplate
+
+@Service
+class PurchaseService(
+    private val purchaseRepository: PurchaseRepository,
+    private val postRepository: PostRepository,
+    private val memberRepository: MemberRepository,
+    private val walletRepository: WalletRepository,
+    private val walletService: WalletService,
+    transactionManager: PlatformTransactionManager,
+) {
+    companion object {
+        /** 플랫폼 수수료율(%) */
+        const val PLATFORM_FEE_PERCENT = 10L
+    }
+
+    data class PurchaseResult(
+        val purchaseId: Long,
+        val postId: Long,
+        val price: Long,
+        val buyerBalance: Long,
+    )
+
+    private val tx = TransactionTemplate(transactionManager)
+
+    fun authorIncomeOf(price: Long): Long = price * (100 - PLATFORM_FEE_PERCENT) / 100
+
+    /**
+     * 유료 글 구매.
+     *
+     * 하나의 트랜잭션에서
+     *  1) 구매 기록 INSERT  - (buyer, post) 유니크 제약으로 중복 구매를 DB 가 막는다
+     *  2) 구매자 잔액 조건부 차감 (balance >= price 일 때만)  - 잔액 음수 불가
+     *  3) 작성자 잔액 입금 (가격의 90%)
+     * 를 수행하고, 하나라도 실패하면 전부 롤백된다.
+     * 두 지갑의 UPDATE 는 항상 회원 id 오름차순으로 실행해 교차 구매 시 교착(deadlock)을 피한다.
+     */
+    fun purchase(buyerId: Long, postId: Long): PurchaseResult {
+        val authorId = tx.execute {
+            val post = postRepository.findByIdOrNull(postId) ?: throw NoSuchElementException()
+            checkPurchasable(post, buyerId)
+            post.author.id!!
+        }!!
+
+        // 지갑 생성은 별도 트랜잭션이므로 구매 트랜잭션을 열기 전에 해 둔다
+        walletService.ensureWallet(buyerId)
+        walletService.ensureWallet(authorId)
+
+        return tx.execute {
+            val post = postRepository.findByIdOrNull(postId) ?: throw NoSuchElementException()
+            checkPurchasable(post, buyerId)
+
+            val price = post.price
+            val authorIncome = authorIncomeOf(price)
+            val platformFee = price - authorIncome
+
+            val purchase = try {
+                purchaseRepository.saveAndFlush(
+                    Purchase(
+                        memberRepository.getReferenceById(buyerId),
+                        post,
+                        price,
+                        authorIncome,
+                        platformFee,
+                    )
+                )
+            } catch (e: DataAccessException) {
+                // 동시에 들어온 같은 구매 요청 중 늦은 쪽 (유니크 제약 위반 / 잠금 충돌)
+                throw ServiceException("409-2", "이미 구매한 글입니다.")
+            }
+
+            val debit = {
+                if (walletRepository.decreaseBalanceIfEnough(buyerId, price) != 1) {
+                    throw ServiceException("400-5", "잔액이 부족합니다.")
+                }
+            }
+
+            val credit = {
+                if (walletRepository.increaseBalance(authorId, authorIncome) != 1) {
+                    throw ServiceException("500-1", "작성자 지갑을 찾을 수 없습니다.")
+                }
+            }
+
+            if (buyerId < authorId) {
+                debit()
+                credit()
+            } else {
+                credit()
+                debit()
+            }
+
+            PurchaseResult(
+                purchase.id!!,
+                postId,
+                price,
+                walletRepository.findBalanceByMemberId(buyerId)!!,
+            )
+        }!!
+    }
+
+    private fun checkPurchasable(post: Post, buyerId: Long) {
+        if (!post.isPaid) {
+            throw ServiceException("400-6", "무료 글은 구매할 수 없습니다.")
+        }
+
+        if (post.author.id == buyerId) {
+            throw ServiceException("403-3", "자신의 글은 구매할 수 없습니다.")
+        }
+
+        if (purchaseRepository.existsByBuyerIdAndPostId(buyerId, post.id!!)) {
+            throw ServiceException("409-2", "이미 구매한 글입니다.")
+        }
+    }
+
+    fun hasPurchased(memberId: Long, postId: Long): Boolean =
+        purchaseRepository.existsByBuyerIdAndPostId(memberId, postId)
+
+    fun findPurchasedPostIds(memberId: Long, postIds: Collection<Long>): Set<Long> {
+        if (postIds.isEmpty()) return emptySet()
+
+        return purchaseRepository.findPurchasedPostIds(memberId, postIds).toSet()
+    }
+
+    fun hasAnyPurchase(postId: Long): Boolean = purchaseRepository.existsByPostId(postId)
+}
