+package com.rest1.domain.post.purchase.repository
+
+import com.rest1.domain.post.purchase.entity.Purchase
+import org.springframework.data.jpa.repository.JpaRepository
+import org.springframework.data.jpa.repository.Query
+import org.springframework.data.repository.query.Param
+
+interface PurchaseRepository : JpaRepository<Purchase, Long> {
+    fun existsByBuyerIdAndPostId(buyerId: Long, postId: Long): Boolean
+
+    fun existsByPostId(postId: Long): Boolean
+
+    fun countByPostId(postId: Long): Long
+
+    @Query("select p.post.id from Purchase p where p.buyer.id = :buyerId and p.post.id in :postIds")
+    fun findPurchasedPostIds(
+        @Param("buyerId") buyerId: Long,
+        @Param("postIds") postIds: Collection<Long>,
+    ): List<Long>
+}
diff --git a/src/main/kotlin/com/rest1/domain/post/purchase/service/PurchaseService.kt b/src/main/kotlin/com/rest1/domain/post/purchase/service/PurchaseService.kt
new file mode 100644
