+package com.rest1.standard.ut
+
+import com.rest1.global.exception.ServiceException
+import java.math.BigDecimal
+
+object Amounts {
+    /**
+     * 요청 본문의 금액(숫자)을 Long 으로 바꾼다.
+     * Jackson 이 Long 필드에 1.5 같은 소수를 넣으면 조용히 버림(1)하므로, BigDecimal 로 받아 정수인지 직접 확인한다.
+     */
+    fun toLongExact(value: BigDecimal, fieldName: String): Long {
+        return try {
+            value.stripTrailingZeros().longValueExact()
+        } catch (e: ArithmeticException) {
+            throw ServiceException("400-2", "${fieldName}은(는) 정수여야 합니다.")
+        }
+    }
+}
