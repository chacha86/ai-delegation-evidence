+    @Test
+    @DisplayName("동시성: 같은 글 동시 구매는 한 번만 성공, 돈도 한 번만 빠진다")
+    fun concurrentSamePurchase() {
+        val author = newMember()
+        val buyer = newMember()
+        val postId = writePostId(author, 1000)
+        charge(buyer, "100000")
+
+        val statuses = runConcurrently(20) { purchase(buyer, postId).status }
+
+        assertThat(statuses.count { it in 200..299 }).isEqualTo(1)
+        assertThat(statuses.filter { it !in 200..299 }).allMatch { it in 400..499 }
+        assertThat(balance(buyer)).isEqualTo(99000)
+        assertThat(balance(author)).isEqualTo(900)
+        assertThat(purchaseRepository.countByPostId(postId)).isEqualTo(1)
+    }
