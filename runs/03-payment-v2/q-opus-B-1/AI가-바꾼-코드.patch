+package com.rest1.domain.wallet.wallet.service
+
+import com.rest1.domain.member.member.repository.MemberRepository
+import com.rest1.domain.wallet.wallet.entity.Wallet
+import com.rest1.domain.wallet.wallet.repository.WalletRepository
+import com.rest1.global.exception.ServiceException
+import org.springframework.dao.DataIntegrityViolationException
+import org.springframework.stereotype.Service
+import org.springframework.transaction.PlatformTransactionManager
+import org.springframework.transaction.TransactionDefinition
+import org.springframework.transaction.support.TransactionTemplate
+
+@Service
+class WalletService(
+    private val walletRepository: WalletRepository,
+    private val memberRepository: MemberRepository,
+    transactionManager: PlatformTransactionManager,
+) {
+    companion object {
+        const val MIN_CHARGE_AMOUNT = 1L
+        const val MAX_CHARGE_AMOUNT = 100_000L
+    }
+
+    private val tx = TransactionTemplate(transactionManager)
+
+    private val txNew = TransactionTemplate(transactionManager).apply {
+        propagationBehavior = TransactionDefinition.PROPAGATION_REQUIRES_NEW
+    }
+
+    /** 회원 가입과 같은 트랜잭션 안에서 지갑을 만든다 (잔액 0). */
+    fun createWallet(memberId: Long): Wallet {
+        return walletRepository.save(Wallet(memberRepository.getReferenceById(memberId)))
+    }
+
+    /**
+     * 지갑이 없으면 만든다 (이 기능 이전에 가입한 회원 대비).
+     * 동시에 두 요청이 만들려고 해도 member_id 유니크 제약 때문에 하나만 성공하고, 나머지는 실패를 무시한다.
+     * 별도 트랜잭션에서 실행되므로 바깥 트랜잭션이 열리기 전에 호출해야 한다.
+     */
+    fun ensureWallet(memberId: Long) {
+        if (walletRepository.existsByMemberId(memberId)) return
+
+        try {
+            txNew.executeWithoutResult {
+                if (!walletRepository.existsByMemberId(memberId)) {
+                    walletRepository.saveAndFlush(Wallet(memberRepository.getReferenceById(memberId)))
+                }
+            }
+        } catch (e: DataIntegrityViolationException) {
+            // 다른 요청이 먼저 만들었거나(유니크 위반) 회원이 없는 경우(FK 위반).
+            // 회원이 없는 경우는 이후 잔액 갱신이 0건이 되어 오류로 처리된다.
+        }
+    }
+
+    /** 지갑이 아직 없으면 0 */
+    fun getBalance(memberId: Long): Long {
+        return walletRepository.findBalanceByMemberId(memberId) ?: 0L
+    }
+
+    fun validateChargeAmount(amount: Long) {
+        if (amount < MIN_CHARGE_AMOUNT) {
+            throw ServiceException("400-3", "충전 금액은 ${MIN_CHARGE_AMOUNT}원 이상이어야 합니다.")
+        }
+
+        if (amount > MAX_CHARGE_AMOUNT) {
+            throw ServiceException("400-4", "1회 충전 금액은 ${MAX_CHARGE_AMOUNT}원 이하여야 합니다.")
+        }
+    }
+
+    /** 충전 후 잔액을 돌려준다. */
+    fun charge(memberId: Long, amount: Long): Long {
+        validateChargeAmount(amount)
+
+        ensureWallet(memberId)
+
+        return tx.execute {
+            val updated = walletRepository.increaseBalance(memberId, amount)
+
+            if (updated != 1) {
+                throw ServiceException("404-2", "지갑을 찾을 수 없습니다.")
+            }
+
+            walletRepository.findBalanceByMemberId(memberId)!!
+        }!!
+    }
+}
