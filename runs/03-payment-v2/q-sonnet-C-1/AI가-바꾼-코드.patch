+package com.rest1.domain.wallet.controller
+
+import com.rest1.domain.wallet.service.WalletService
+import com.rest1.global.exception.ServiceException
+import com.rest1.global.rq.Rq
+import com.rest1.global.rsData.RsData
+import io.swagger.v3.oas.annotations.Operation
+import io.swagger.v3.oas.annotations.security.SecurityRequirement
+import io.swagger.v3.oas.annotations.tags.Tag
+import org.springframework.web.bind.annotation.GetMapping
+import org.springframework.web.bind.annotation.PostMapping
+import org.springframework.web.bind.annotation.RequestBody
+import org.springframework.web.bind.annotation.RequestMapping
+import org.springframework.web.bind.annotation.RestController
+import java.math.BigDecimal
+
+@RestController
+@RequestMapping("/api/v1/wallet")
+@Tag(name = "ApiV1WalletController", description = "지갑 API")
+@SecurityRequirement(name = "bearerAuth")
+class ApiV1WalletController(
+    private val walletService: WalletService,
+    private val rq: Rq,
+) {
+    data class WalletDto(val balance: Long)
+
+    // 소수(1.5)가 Long 으로 조용히 잘리지 않도록 BigDecimal 로 받아 정수인지 직접 검사한다
+    data class ChargeReqBody(val amount: BigDecimal?)
+
+    @GetMapping
+    @Operation(summary = "잔액 조회")
+    fun getBalance(): WalletDto = WalletDto(walletService.balanceOf(rq.actor.id!!))
+
+    @PostMapping("/charge")
+    @Operation(summary = "충전")
+    fun charge(@RequestBody reqBody: ChargeReqBody): RsData<WalletDto> {
+        val amount = reqBody.amount
+            ?: throw ServiceException("400-3", "충전 금액이 필요합니다.")
+        if (amount.signum() != 0 && amount.stripTrailingZeros().scale() > 0)
+            throw ServiceException("400-3", "충전 금액은 정수여야 합니다.")
+        if (amount > BigDecimal(WalletService.MAX_CHARGE))
+            throw ServiceException("400-4", "1회 충전 금액은 ${WalletService.MAX_CHARGE} 이하여야 합니다.")
+        if (amount < BigDecimal.ONE)
+            throw ServiceException("400-3", "충전 금액은 1 이상이어야 합니다.")
+
+        val balance = walletService.charge(rq.actor.id!!, amount.toLong())
+        return RsData("200-1", "충전되었습니다.", WalletDto(balance))
+    }
+}
