+package com.rest1.domain.wallet.service
+
+import com.rest1.domain.post.post.entity.Post
+import com.rest1.domain.wallet.entity.PostPurchase
+import com.rest1.domain.wallet.entity.Wallet
+import com.rest1.domain.wallet.repository.PostPurchaseRepository
+import com.rest1.domain.wallet.repository.WalletRepository
+import com.rest1.global.exception.ServiceException
+import org.springframework.dao.DataIntegrityViolationException
+import org.springframework.stereotype.Component
+import org.springframework.stereotype.Service
+import org.springframework.transaction.annotation.Propagation
+import org.springframework.transaction.annotation.Transactional
+
+/** 지갑 행이 없을 때 별도 트랜잭션으로 만든다 (동시 생성 충돌은 unique 제약으로 막고 무시). */
+@Component
+class WalletCreator(private val walletRepository: WalletRepository) {
+    @Transactional(propagation = Propagation.REQUIRES_NEW)
+    fun create(memberId: Long) {
+        if (walletRepository.findByMemberId(memberId) != null) return
+        try {
+            walletRepository.saveAndFlush(Wallet(memberId))
+        } catch (e: DataIntegrityViolationException) {
+            // 다른 요청이 먼저 만들었다
+        }
+    }
+}
+
+@Service
+class WalletService(
+    private val walletRepository: WalletRepository,
+    private val purchaseRepository: PostPurchaseRepository,
+    private val walletCreator: WalletCreator,
+) {
+    companion object {
+        const val MAX_CHARGE = 100_000L
+        const val FEE_PERCENT = 10L
+    }
+
+    @Transactional(readOnly = true)
+    fun balanceOf(memberId: Long): Long = walletRepository.findByMemberId(memberId)?.balance ?: 0L
+
+    private fun lockedWallet(memberId: Long): Wallet {
+        walletRepository.findByMemberIdForUpdate(memberId)?.let { return it }
+        walletCreator.create(memberId)
+        return walletRepository.findByMemberIdForUpdate(memberId)!!
+    }
+
+    @Transactional
+    fun charge(memberId: Long, amount: Long): Long {
+        if (amount < 1) throw ServiceException("400-3", "충전 금액은 1 이상이어야 합니다.")
+        if (amount > MAX_CHARGE) throw ServiceException("400-4", "1회 충전 금액은 $MAX_CHARGE 이하여야 합니다.")
+        val wallet = lockedWallet(memberId)
+        wallet.deposit(amount)
+        return wallet.balance
+    }
+
+    @Transactional
+    fun purchase(buyerId: Long, post: Post) {
+        val authorId = post.author.id!!
+        val price = post.price
+        if (price <= 0) throw ServiceException("400-5", "무료 글은 구매할 수 없습니다.")
+        if (authorId == buyerId) throw ServiceException("403-3", "자신의 글은 구매할 수 없습니다.")
+
+        // 데드락 방지: 항상 id 오름차순으로 지갑 락을 잡는다. 구매자 락이 같은 구매자의 동시 구매를 직렬화한다.
+        val wallets = listOf(buyerId, authorId).sorted().associateWith { lockedWallet(it) }
+        val buyer = wallets.getValue(buyerId)
+        val author = wallets.getValue(authorId)
+
+        if (purchaseRepository.existsByBuyerIdAndPostId(buyerId, post.id!!))
+            throw ServiceException("409-1", "이미 구매한 글입니다.")
+        if (buyer.balance < price) throw ServiceException("400-6", "잔액이 부족합니다.")
+
+        buyer.withdraw(price)
+        author.deposit(price - price * FEE_PERCENT / 100)
+        purchaseRepository.save(PostPurchase(buyerId, post.id!!, price))
+    }
+
+    @Transactional(readOnly = true)
+    fun hasPurchased(buyerId: Long, postId: Long): Boolean =
+        purchaseRepository.existsByBuyerIdAndPostId(buyerId, postId)
+
+    @Transactional(readOnly = true)
+    fun purchasedPostIds(buyerId: Long): Set<Long> = purchaseRepository.findPostIdsByBuyerId(buyerId).toSet()
+}
