+package com.rest1.domain.wallet.wallet.service
+
+import com.rest1.domain.member.member.repository.MemberRepository
+import com.rest1.global.exception.ServiceException
+import org.springframework.stereotype.Service
+import org.springframework.transaction.annotation.Transactional
+
+@Service
+class WalletService(
+    private val memberRepository: MemberRepository,
+) {
+    companion object {
+        const val MAX_CHARGE_AMOUNT = 100_000L
+    }
+
+    // 충전 금액 검사 후 회원 행을 잠그고 더한다. 실패하면 잔액은 그대로다.
+    @Transactional
+    fun charge(memberId: Long, amount: Long): Long {
+        if (amount < 1) {
+            throw ServiceException("400-4", "충전 금액은 1 이상이어야 합니다.")
+        }
+
+        if (amount > MAX_CHARGE_AMOUNT) {
+            throw ServiceException("400-5", "1회 충전 금액은 100,000 이하여야 합니다.")
+        }
+
+        val member = memberRepository.findByIdForUpdate(memberId).orElseThrow { NoSuchElementException() }
+
+        member.charge(amount)
+
+        return member.balance
+    }
+
+    @Transactional(readOnly = true)
+    fun balance(memberId: Long): Long {
+        return memberRepository.findById(memberId).orElseThrow { NoSuchElementException() }.balance
+    }
+}
