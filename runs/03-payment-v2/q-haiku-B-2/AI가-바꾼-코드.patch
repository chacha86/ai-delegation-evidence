+package com.rest1.domain.wallet.wallet.service
+
+import com.rest1.domain.member.member.entity.Member
+import com.rest1.domain.member.member.repository.MemberRepository
+import com.rest1.domain.post.post.entity.Post
+import com.rest1.domain.post.post.repository.PostPurchaseRepository
+import com.rest1.domain.post.post.repository.PostRepository
+import com.rest1.domain.post.post.service.PostService
+import com.rest1.global.exception.ServiceException
+import org.assertj.core.api.Assertions.assertThat
+import org.junit.jupiter.api.DisplayName
+import org.junit.jupiter.api.Test
+import org.springframework.beans.factory.annotation.Autowired
+import org.springframework.boot.test.context.SpringBootTest
+import org.springframework.test.annotation.DirtiesContext
+import org.springframework.test.context.ActiveProfiles
+import org.springframework.test.context.TestPropertySource
+import java.util.UUID
+import java.util.concurrent.Callable
+import java.util.concurrent.CountDownLatch
+import java.util.concurrent.Executors
+import java.util.concurrent.TimeUnit
+
+// 트랜잭션 없이 실제로 커밋되는 동시 요청을 흉내 낸다.
+// 커밋된 데이터가 다른 테스트 클래스와 섞이지 않도록 별도 컨텍스트(별도 DB)를 쓰고 끝나면 닫는다.
+@SpringBootTest
+@ActiveProfiles("test")
+@TestPropertySource(properties = ["spring.datasource.url=jdbc:h2:mem:payment_concurrency;MODE=MySQL"])
+@DirtiesContext(classMode = DirtiesContext.ClassMode.AFTER_CLASS)
+class PaymentConcurrencyTest {
+    @Autowired
+    private lateinit var walletService: WalletService
+
+    @Autowired
+    private lateinit var postService: PostService
+
+    @Autowired
+    private lateinit var postRepository: PostRepository
+
+    @Autowired
+    private lateinit var postPurchaseRepository: PostPurchaseRepository
+
+    @Autowired
+    private lateinit var memberRepository: MemberRepository
+
+    private fun newMember(prefix: String, balance: Long = 0): Member {
+        val member = memberRepository.save(Member("$prefix-${UUID.randomUUID()}", "pw", "닉네임"))
+        if (balance > 0) walletService.charge(member.id!!, balance)
+        return member
+    }
+
+    private fun balanceOf(member: Member): Long = memberRepository.findById(member.id!!).get().balance
+
+    // 모든 작업이 같은 순간에 출발하도록 래치로 맞춘다. 각 작업의 성공/예외를 그대로 돌려준다.
+    private fun <T> runTogether(count: Int, task: (Int) -> T): List<Result<T>> {
+        val pool = Executors.newFixedThreadPool(count)
+        val start = CountDownLatch(1)
+        try {
+            val futures = (0 until count).map { i ->
+                pool.submit(Callable {
+                    start.await()
+                    runCatching { task(i) }
+                })
+            }
+            start.countDown()
+            return futures.map { it.get(60, TimeUnit.SECONDS) }
+        } finally {
+            pool.shutdownNow()
+        }
+    }
+
+    @Test
+    @DisplayName("동시에 충전해도 충전 금액이 누락되지 않는다")
+    fun concurrentCharge() {
+        val member = newMember("charge")
+
+        val results = runTogether(20) { walletService.charge(member.id!!, 100) }
+
+        assertThat(results).allMatch { it.isSuccess }
+        assertThat(balanceOf(member)).isEqualTo(2000)
+    }
+
+    @Test
+    @DisplayName("같은 회원이 같은 글을 동시에 여러 번 사도 한 번만 성공하고 한 번만 차감된다")
+    fun concurrentDuplicatePurchase() {
+        val author = newMember("author")
+        val buyer = newMember("buyer", balance = 10_000)
+        val post = postRepository.save(Post(author, "제목", "본문", 1000))
+
+        val results = runTogether(10) { postService.purchase(buyer.id!!, post.id!!) }
+
+        val successes = results.count { it.isSuccess }
+        assertThat(successes).isEqualTo(1)
+        results.filter { it.isFailure }.forEach {
+            assertThat(it.exceptionOrNull()).isInstanceOfSatisfying(ServiceException::class.java) { e ->
+                assertThat(e.resultCode).isEqualTo("409-2")
+            }
+        }
+
+        assertThat(balanceOf(buyer)).isEqualTo(9000)
+        assertThat(balanceOf(author)).isEqualTo(900)
+        assertThat(postPurchaseRepository.existsByPostIdAndBuyerId(post.id!!, buyer.id!!)).isTrue()
+    }
+
+    @Test
+    @DisplayName("잔액이 한 건 값만큼만 있을 때 동시에 여러 글을 사면 한 건만 성공하고 잔액은 음수가 되지 않는다")
+    fun concurrentInsufficientBalance() {
+        val author = newMember("author")
+        val buyer = newMember("buyer", balance = 1000)
+        val posts = (0 until 5).map { postRepository.save(Post(author, "제목$it", "본문", 800)) }
+
+        val results = runTogether(5) { i -> postService.purchase(buyer.id!!, posts[i].id!!) }
+
+        assertThat(results.count { it.isSuccess }).isEqualTo(1)
+        results.filter { it.isFailure }.forEach {
+            assertThat(it.exceptionOrNull()).isInstanceOfSatisfying(ServiceException::class.java) { e ->
+                assertThat(e.resultCode).isEqualTo("400-7")
+            }
+        }
+
+        assertThat(balanceOf(buyer)).isEqualTo(200)
+        assertThat(balanceOf(author)).isEqualTo(720)
+    }
+
+    @Test
+    @DisplayName("두 회원이 서로의 글을 동시에 사도 데드락 없이 모두 끝난다")
+    fun crossPurchaseNoDeadlock() {
+        val pairs = (0 until 10).map {
+            val a = newMember("pa", balance = 5000)
+            val b = newMember("pb", balance = 5000)
+            val postA = postRepository.save(Post(a, "A글", "본문", 1000))
+            val postB = postRepository.save(Post(b, "B글", "본문", 1000))
+            Triple(a, b, Pair(postA, postB))
+        }
+
+        // 쌍마다 두 요청(a→B글, b→A글)을 같은 시점에 날린다
+        val results = runTogether(pairs.size * 2) { i ->
+            val (a, b, posts) = pairs[i / 2]
+            if (i % 2 == 0) postService.purchase(a.id!!, posts.second.id!!)
+            else postService.purchase(b.id!!, posts.first.id!!)
+        }
+
+        assertThat(results).allMatch { it.isSuccess }
+        pairs.forEach { (a, b, _) ->
+            assertThat(balanceOf(a)).isEqualTo(4900)
+            assertThat(balanceOf(b)).isEqualTo(4900)
+        }
+    }
+}
