+
+@RestController
+@RequestMapping("/api/v1/wallet")
+@Tag(name = "ApiV1WalletController", description = "지갑 API")
+@SecurityRequirement(name = "bearerAuth")
+class ApiV1WalletController(
+    private val walletService: WalletService,
+    private val rq: Rq,
+) {
+    data class BalanceResBody(
+        val balance: Long,
+    )
+
+    @GetMapping
+    @Transactional(readOnly = true)
+    @Operation(summary = "잔액 조회")
+    fun getWallet(): BalanceResBody {
+        return BalanceResBody(walletService.balanceOf(rq.actor.id!!))
+    }
+
+    data class ChargeReqBody(
+        @field:NotNull
+        @field:Min(1)
+        val amount: Long?,
+    )
+
+    data class ChargeResBody(
+        val balance: Long,
+    )
+
+    @PostMapping("/charge")
+    @Operation(summary = "충전")
+    fun charge(
+        @RequestBody @Valid reqBody: ChargeReqBody,
+    ): RsData<ChargeResBody> {
+        val balance = walletService.charge(rq.actor.id!!, reqBody.amount!!)
+
+        return RsData(
+            "200-1",
+            "${reqBody.amount}원이 충전되었습니다.",
+            ChargeResBody(balance),
+        )
+    }
+}
