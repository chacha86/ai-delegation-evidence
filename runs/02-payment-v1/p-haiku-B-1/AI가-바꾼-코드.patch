+package com.rest1.domain.post.post.service
+
+import com.rest1.domain.member.member.entity.Member
+import com.rest1.domain.member.member.repository.MemberRepository
+import com.rest1.domain.post.post.entity.Post
+import com.rest1.domain.post.post.repository.PostPurchaseRepository
+import com.rest1.domain.post.post.repository.PostRepository
+import com.rest1.domain.wallet.service.WalletService
+import com.rest1.global.exception.ServiceException
+import org.assertj.core.api.Assertions.assertThat
+import org.junit.jupiter.api.AfterEach
+import org.junit.jupiter.api.DisplayName
+import org.junit.jupiter.api.Test
+import org.springframework.beans.factory.annotation.Autowired
+import org.springframework.boot.test.context.SpringBootTest
+import org.springframework.test.annotation.DirtiesContext
+import org.springframework.test.context.ActiveProfiles
+import java.util.concurrent.Callable
+import java.util.concurrent.CountDownLatch
+import java.util.concurrent.Executors
+import java.util.concurrent.TimeUnit
+
+// 실제로 여러 스레드가 동시에 호출하는 테스트라서 테스트 트랜잭션을 쓰지 않는다.
+// 대신 만든 데이터는 @AfterEach 에서 지워서 다른 테스트의 개수 검사에 영향을 주지 않게 한다.
+@SpringBootTest
+@DirtiesContext(classMode = DirtiesContext.ClassMode.AFTER_CLASS)
+@ActiveProfiles("test")
+class PostPurchaseConcurrencyTest {
+    @Autowired
+    private lateinit var postPurchaseService: PostPurchaseService
+
+    @Autowired
+    private lateinit var walletService: WalletService
+
+    @Autowired
+    private lateinit var memberRepository: MemberRepository
+
+    @Autowired
+    private lateinit var postRepository: PostRepository
+
+    @Autowired
+    private lateinit var postPurchaseRepository: PostPurchaseRepository
+
+    private val suffix = System.nanoTime()
+    private val memberIds = mutableListOf<Long>()
+    private val postIds = mutableListOf<Long>()
+
+    private fun newMember(name: String): Member {
+        val member = memberRepository.save(Member("conc-$name-$suffix", "pw", name))
+        memberIds.add(member.id!!)
+        return member
+    }
+
+    private fun newPaidPost(author: Member, price: Long): Post {
+        val post = postRepository.save(Post(author, "동시성", "본문", price))
+        postIds.add(post.id!!)
+        return post
+    }
+
+    private fun balance(member: Member): Long = memberRepository.findById(member.id!!).get().balance
+
+    @AfterEach
+    fun cleanup() {
+        postPurchaseRepository.findAll()
+            .filter { it.post.id in postIds }
+            .forEach { postPurchaseRepository.delete(it) }
+        postPurchaseRepository.flush()
+
+        postIds.forEach { id -> postRepository.findById(id).ifPresent { postRepository.delete(it) } }
+        memberIds.forEach { id -> memberRepository.findById(id).ifPresent { memberRepository.delete(it) } }
+        postIds.clear()
+        memberIds.clear()
+    }
+
+    // 모든 작업을 같은 순간에 출발시키고, 각 작업이 던진 예외(없으면 null)를 돌려준다
+    private fun runConcurrently(tasks: List<() -> Any?>): List<Throwable?> {
+        val pool = Executors.newFixedThreadPool(tasks.size)
+        try {
+            val start = CountDownLatch(1)
+            val futures = tasks.map { task ->
+                pool.submit(
+                    Callable<Throwable?> {
+                        start.await()
+                        try {
+                            task()
+                            null
+                        } catch (e: Throwable) {
+                            e
+                        }
+                    }
+                )
+            }
+            start.countDown()
+            return futures.map { it.get(90, TimeUnit.SECONDS) }
+        } finally {
+            pool.shutdown()
+        }
+    }
+
+    @Test
+    @DisplayName("같은 회원이 같은 글을 동시에 여러 번 사도 한 번만 차감된다")
+    fun sameBuyerSamePostOnlyOnce() {
+        val author = newMember("author")
+        val buyer = newMember("buyer")
+        val post = newPaidPost(author, 300)
+        walletService.charge(buyer.id!!, 1000)
+
+        val results = runConcurrently(
+            List(8) { { postPurchaseService.purchase(buyer.id!!, post.id!!) } }
+        )
+
+        val successes = results.count { it == null }
+        assertThat(successes).isEqualTo(1)
+        results.filterNotNull().forEach { assertThat(it).isInstanceOf(ServiceException::class.java) }
+        assertThat(balance(buyer)).isEqualTo(700L)
+        assertThat(balance(author)).isEqualTo(300L)
+    }
+
+    @Test
+    @DisplayName("동시에 여러 글을 사도 잔액이 음수가 되지 않고 성공한 만큼만 빠진다")
+    fun neverNegativeBalance() {
+        val author = newMember("author")
+        val buyer = newMember("buyer")
+        val posts = List(5) { newPaidPost(author, 300) }
+        walletService.charge(buyer.id!!, 1000)
+
+        // 같은 글 두 번씩, 총 10번 동시에 구매 시도 (잔액으로는 3번만 가능)
+        val tasks = (posts + posts).map { post -> { postPurchaseService.purchase(buyer.id!!, post.id!!) } }
+        val results = runConcurrently(tasks)
+
+        val successes = results.count { it == null }
+        assertThat(successes).isEqualTo(3)
+        assertThat(balance(buyer)).isEqualTo(100L)
+        assertThat(balance(author)).isEqualTo(900L)
+        assertThat(balance(buyer)).isGreaterThanOrEqualTo(0L)
+    }
+
+    @Test
+    @DisplayName("충전과 구매가 동시에 와도 충전액이 빠지지 않고 차감이 한 번씩만 된다")
+    fun chargesAndPurchasesDoNotLoseMoney() {
+        val author = newMember("author")
+        val buyer = newMember("buyer")
+        val posts = List(10) { newPaidPost(author, 50) }
+
+        val tasks = mutableListOf<() -> Any?>()
+        repeat(20) { tasks.add { walletService.charge(buyer.id!!, 10) } }
+        posts.forEach { post -> tasks.add { postPurchaseService.purchase(buyer.id!!, post.id!!) } }
+
+        val results = runConcurrently(tasks)
+
+        assertThat(results.filterNotNull().all { it is ServiceException }).isTrue()
+        val purchases = results.drop(20).count { it == null }
+        val finalBalance = balance(buyer)
+        // 충전 200 - 구매 50 * 성공 횟수
+        assertThat(finalBalance).isEqualTo(200L - 50L * purchases)
+        assertThat(finalBalance).isGreaterThanOrEqualTo(0L)
+        assertThat(balance(author)).isEqualTo(50L * purchases)
+    }
+
+    @Test
+    @DisplayName("두 회원이 서로의 글을 동시에 사도 교착 없이 끝나고 돈 합계는 그대로다")
+    fun crossedPurchasesDoNotDeadlock() {
+        val a = newMember("a")
+        val b = newMember("b")
+        val postOfA = newPaidPost(a, 100)
+        val postOfB = newPaidPost(b, 100)
+        walletService.charge(a.id!!, 100)
+        walletService.charge(b.id!!, 100)
+
+        val results = runConcurrently(
+            listOf(
+                { postPurchaseService.purchase(a.id!!, postOfB.id!!) },
+                { postPurchaseService.purchase(b.id!!, postOfA.id!!) },
+            )
+        )
+
+        // 교착이나 DB 잠금 시간 초과로 실패하면 ServiceException 이 아닌 예외가 나온다
+        results.filterNotNull().forEach { assertThat(it).isInstanceOf(ServiceException::class.java) }
+        assertThat(balance(a) + balance(b)).isEqualTo(200L)
+        assertThat(balance(a)).isGreaterThanOrEqualTo(0L)
+        assertThat(balance(b)).isGreaterThanOrEqualTo(0L)
+    }
+}
