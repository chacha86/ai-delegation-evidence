+package com.rest1.domain.post.post.service
+
+import com.rest1.domain.member.member.entity.Member
+import com.rest1.domain.member.member.repository.MemberRepository
+import com.rest1.domain.post.post.entity.Post
+import com.rest1.domain.post.post.entity.PostPurchase
+import com.rest1.domain.post.post.repository.PostPurchaseRepository
+import com.rest1.domain.post.post.repository.PostRepository
+import com.rest1.global.exception.ServiceException
+import org.springframework.data.repository.findByIdOrNull
+import org.springframework.stereotype.Service
+import org.springframework.transaction.annotation.Transactional
+
+@Service
+class PostPurchaseService(
+    private val postRepository: PostRepository,
+    private val memberRepository: MemberRepository,
+    private val postPurchaseRepository: PostPurchaseRepository,
+) {
+    // 구매 한 건을 하나의 트랜잭션으로 처리한다. 실패하면 잔액·구매 기록 모두 그대로다.
+    // 구매자와 작성자 행을 id 순서로 잠가서, 동시 요청이 와도 잔액 음수·중복 차감·충전 누락이 나지 않게 한다.
+    // 구매자 행 잠금이 같은 회원의 구매를 직렬화하므로 "이미 구매" 검사도 안전하다.
+    @Transactional
+    fun purchase(buyerId: Long, postId: Long): Long {
+        val post = postRepository.findByIdOrNull(postId) ?: throw NoSuchElementException()
+
+        if (!post.isPaid) {
+            throw ServiceException("400-4", "무료 글은 구매할 수 없습니다.")
+        }
+
+        val authorId = post.author.id!!
+
+        if (authorId == buyerId) {
+            throw ServiceException("403-3", "자신이 쓴 글은 구매할 수 없습니다.")
+        }
+
+        val members = memberRepository.findAllByIdForUpdate(listOf(buyerId, authorId)).associateBy { it.id }
+        val buyer = members[buyerId] ?: throw NoSuchElementException()
+        val author = members[authorId] ?: throw NoSuchElementException()
+
+        if (postPurchaseRepository.existsByPostIdAndBuyerId(postId, buyerId)) {
+            throw ServiceException("409-1", "이미 구매한 글입니다.")
+        }
+
+        if (buyer.balance < post.price) {
+            throw ServiceException("400-3", "잔액이 부족합니다.")
+        }
+
+        buyer.debit(post.price)
+        author.credit(post.price)
+        postPurchaseRepository.save(PostPurchase(post, buyer, post.price))
+
+        return buyer.balance
+    }
+
+    // 본문을 볼 수 있는지: 무료 글은 누구나(비로그인 포함), 유료 글은 작성자와 구매자만
+    @Transactional(readOnly = true)
+    fun canReadContent(post: Post, viewer: Member?): Boolean {
+        if (!post.isPaid) return true
+        if (viewer == null) return false
+
+        val viewerId = viewer.id!!
+
+        return post.author.id == viewerId || postPurchaseRepository.existsByPostIdAndBuyerId(post.id!!, viewerId)
+    }
+
+    // 목록 조회에서 한 번의 쿼리로 구매 여부를 판단하기 위해 회원이 산 글 id 집합을 만든다
+    @Transactional(readOnly = true)
+    fun purchasedPostIds(viewer: Member?): Set<Long> {
+        if (viewer == null) return emptySet()
+
+        return postPurchaseRepository.findPurchasedPostIds(viewer.id!!).toSet()
+    }
+
+    // purchasedPostIds 로 미리 받아 둔 집합으로 판단하는 버전 (목록 조회용, 쿼리 없음)
+    fun isReadable(post: Post, viewer: Member?, purchasedPostIds: Set<Long>): Boolean {
+        if (!post.isPaid) return true
+        if (viewer == null) return false
+
+        return post.author.id == viewer.id || post.id in purchasedPostIds
+    }
+
+    @Transactional(readOnly = true)
+    fun readContent(post: Post, viewer: Member?): String {
+        if (!canReadContent(post, viewer)) {
+            throw ServiceException("403-4", "구매 후 볼 수 있는 글입니다.")
+        }
+
+        return post.content
+    }
+}
