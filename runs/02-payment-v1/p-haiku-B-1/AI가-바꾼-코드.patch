+package com.rest1.domain.wallet.service
+
+import com.rest1.domain.member.member.repository.MemberRepository
+import com.rest1.global.exception.ServiceException
+import org.springframework.stereotype.Service
+import org.springframework.transaction.annotation.Transactional
+
+// 지갑 = 회원의 잔액 (Member.balance). 잔액 변경은 회원 행 잠금 안에서만 한다.
+@Service
+class WalletService(
+    private val memberRepository: MemberRepository,
+) {
+    @Transactional
+    fun charge(memberId: Long, amount: Long): Long {
+        if (amount < 1) {
+            throw ServiceException("400-3", "충전 금액은 1 이상이어야 합니다.")
+        }
+
+        val member = memberRepository.findAllByIdForUpdate(listOf(memberId)).firstOrNull()
+            ?: throw NoSuchElementException()
+
+        if (amount > Long.MAX_VALUE - member.balance) {
+            throw ServiceException("400-4", "충전 한도를 넘는 금액입니다.")
+        }
+
+        member.credit(amount)
+
+        return member.balance
+    }
+
+    @Transactional(readOnly = true)
+    fun balanceOf(memberId: Long): Long {
+        return memberRepository.findById(memberId).orElseThrow { NoSuchElementException() }.balance
+    }
+}
