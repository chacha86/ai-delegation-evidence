+package com.rest1.domain.wallet.repository
+
+import com.rest1.domain.wallet.entity.PostPurchase
+import org.springframework.data.jpa.repository.JpaRepository
+import org.springframework.data.jpa.repository.Query
+import org.springframework.data.repository.query.Param
+
+interface PostPurchaseRepository : JpaRepository<PostPurchase, Long> {
+    fun existsByBuyerIdAndPostId(buyerId: Long, postId: Long): Boolean
+
+    fun existsByPostId(postId: Long): Boolean
+
+    @Query("select p.postId from PostPurchase p where p.buyerId = :buyerId")
+    fun findPurchasedPostIds(@Param("buyerId") buyerId: Long): List<Long>
+}
