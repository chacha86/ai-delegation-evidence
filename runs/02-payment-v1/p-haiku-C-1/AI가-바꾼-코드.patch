@@ -0,0 +1,81 @@
+package com.rest1.domain.wallet.service
+
+import com.rest1.domain.post.post.entity.Post
+import com.rest1.domain.post.post.repository.PostRepository
+import com.rest1.domain.wallet.entity.PostPurchase
+import com.rest1.domain.wallet.entity.Wallet
+import com.rest1.domain.wallet.repository.PostPurchaseRepository
+import com.rest1.domain.wallet.repository.WalletRepository
+import com.rest1.global.exception.ServiceException
+import org.springframework.data.repository.findByIdOrNull
+import org.springframework.stereotype.Service
+import org.springframework.transaction.annotation.Transactional
+
+@Service
+class WalletService(
+    private val walletRepository: WalletRepository,
+    private val postRepository: PostRepository,
+    private val postPurchaseRepository: PostPurchaseRepository,
+) {
+    @Transactional
+    fun createWallet(memberId: Long): Wallet {
+        return walletRepository.save(Wallet(memberId))
+    }
+
+    @Transactional(readOnly = true)
+    fun balanceOf(memberId: Long): Long {
+        return walletRepository.findByMemberId(memberId)?.balance ?: 0L
+    }
+
+    @Transactional
+    fun charge(memberId: Long, amount: Long): Long {
+        if (amount < 1) {
+            throw ServiceException("400-6", "충전 금액은 1 이상이어야 합니다.")
+        }
+
+        val wallet = lockedWallet(memberId)
+        wallet.deposit(amount)
+
+        return wallet.balance
+    }
+
+    @Transactional
+    fun purchase(buyerId: Long, postId: Long): PostPurchase {
+        val post: Post = postRepository.findByIdOrNull(postId) ?: throw NoSuchElementException()
+
+        if (!post.isPaid) {
+            throw ServiceException("400-3", "무료 글은 구매할 수 없습니다.")
+        }
+
+        val authorId = post.author.id!!
+
+        if (authorId == buyerId) {
+            throw ServiceException("400-4", "작성자는 자기 글을 구매할 수 없습니다.")
+        }
+
+        // 관련된 두 지갑을 id 순서로 잠가 교차 구매끼리 교착되지 않게 한다
+        val wallets: Map<Long, Wallet> = listOf(buyerId, authorId)
+            .distinct()
+            .sorted()
+            .associateWith { lockedWallet(it) }
+
+        // 잠금을 잡은 뒤에 확인해야 먼저 끝난 구매를 본다
+        if (postPurchaseRepository.existsByBuyerIdAndPostId(buyerId, postId)) {
+            throw ServiceException("409-2", "이미 구매한 글입니다.")
+        }
+
+        wallets.getValue(buyerId).withdraw(post.price)
+        wallets.getValue(authorId).deposit(post.price)
+
+        return postPurchaseRepository.save(PostPurchase(buyerId, postId, post.price))
+    }
+
+    private fun lockedWallet(memberId: Long): Wallet {
+        walletRepository.findByMemberIdForUpdate(memberId)?.let { return it }
+
+        // 회원 가입 시 지갑을 만들므로 보통은 여기로 오지 않는다 (지갑 없는 기존 데이터 대비)
+        walletRepository.saveAndFlush(Wallet(memberId))
+
+        return walletRepository.findByMemberIdForUpdate(memberId)!!
+    }
+}
