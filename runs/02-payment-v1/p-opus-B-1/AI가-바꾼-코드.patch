+package com.rest1.domain.post.purchase.entity
+
+import com.rest1.domain.member.member.entity.Member
+import com.rest1.domain.post.post.entity.Post
+import com.rest1.global.jpa.entity.BaseEntity
+import jakarta.persistence.Column
+import jakarta.persistence.Entity
+import jakarta.persistence.FetchType
+import jakarta.persistence.JoinColumn
+import jakarta.persistence.ManyToOne
+import jakarta.persistence.Table
+import jakarta.persistence.UniqueConstraint
+
+/**
+ * 유료 글 구매 기록.
+ * (buyer_id, post_id) 유니크 제약으로 같은 글을 두 번 사는 것을 DB 수준에서 막는다.
+ * 동시에 두 구매 요청이 와도 하나만 INSERT 에 성공하고, 나머지는 트랜잭션 전체(차감 포함)가 롤백된다.
+ */
+@Entity
+@Table(
+    uniqueConstraints = [
+        UniqueConstraint(name = "uk_purchase_buyer_post", columnNames = ["buyer_id", "post_id"]),
+    ],
+)
+class Purchase(
+    @ManyToOne(fetch = FetchType.LAZY, optional = false)
+    @JoinColumn(name = "buyer_id", nullable = false, updatable = false)
+    val buyer: Member,
+    @ManyToOne(fetch = FetchType.LAZY, optional = false)
+    @JoinColumn(name = "post_id", nullable = false, updatable = false)
+    val post: Post,
+    // 구매 당시 가격
+    @Column(nullable = false, updatable = false)
+    val price: Long,
+) : BaseEntity()
