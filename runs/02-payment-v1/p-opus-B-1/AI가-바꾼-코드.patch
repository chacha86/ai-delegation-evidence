+package com.rest1.domain.wallet.wallet.controller
+
+import com.rest1.domain.wallet.wallet.dto.WalletDto
+import com.rest1.domain.wallet.wallet.service.WalletService
+import com.rest1.global.retry.retryOnConcurrencyFailure
+import com.rest1.global.rq.Rq
+import com.rest1.global.rsData.RsData
+import io.swagger.v3.oas.annotations.Operation
+import io.swagger.v3.oas.annotations.security.SecurityRequirement
+import io.swagger.v3.oas.annotations.tags.Tag
+import jakarta.validation.Valid
+import jakarta.validation.constraints.DecimalMax
+import jakarta.validation.constraints.DecimalMin
+import jakarta.validation.constraints.Digits
+import jakarta.validation.constraints.NotNull
+import org.springframework.web.bind.annotation.GetMapping
+import org.springframework.web.bind.annotation.PostMapping
+import org.springframework.web.bind.annotation.RequestBody
+import org.springframework.web.bind.annotation.RequestMapping
+import org.springframework.web.bind.annotation.RestController
+import java.math.BigDecimal
+
+// 트랜잭션은 서비스 메서드 단위로 건다 (충돌 시 재시도를 위해 컨트롤러에는 @Transactional 을 두지 않는다)
+@RestController
+@RequestMapping("/api/v1/wallet")
+@Tag(name = "ApiV1WalletController", description = "지갑 API")
+@SecurityRequirement(name = "bearerAuth")
+class ApiV1WalletController(
+    private val walletService: WalletService,
+    private val rq: Rq,
+) {
+    @GetMapping
+    @Operation(summary = "내 잔액 조회")
+    fun getMyWallet(): WalletDto {
+        val actor = rq.actor
+        val memberId = actor.id!!
+
+        return WalletDto(memberId, walletService.getBalance(memberId))
+    }
+
+    // BigDecimal 로 받는 이유: Long 으로 받으면 Jackson 이 1.5 를 1 로 잘라 받아들이기 때문.
+    // 정수가 아니거나 범위를 벗어나면 400-1 로 거부한다.
+    data class ChargeReqBody(
+        @field:NotNull
+        @field:DecimalMin("1")
+        @field:DecimalMax("100000000") // WalletService.MAX_CHARGE_AMOUNT
+        @field:Digits(integer = 18, fraction = 0)
+        val amount: BigDecimal?,
+    )
+
+    @PostMapping("/charge")
+    @Operation(summary = "충전")
+    fun charge(
+        @RequestBody @Valid reqBody: ChargeReqBody,
+    ): RsData<WalletDto> {
+        val actor = rq.actor
+        val memberId = actor.id!!
+        val amount = reqBody.amount!!.longValueExact()
+
+        val balance = retryOnConcurrencyFailure { walletService.charge(memberId, amount) }
+
+        return RsData(
+            "200-1",
+            "${amount}원이 충전되었습니다.",
+            WalletDto(memberId, balance),
+        )
+    }
+}
