+package com.rest1.domain.post.purchase
+
+import com.fasterxml.jackson.databind.ObjectMapper
+import com.rest1.domain.member.member.service.MemberService
+import org.assertj.core.api.Assertions.assertThat
+import org.junit.jupiter.api.DisplayName
+import org.junit.jupiter.api.Test
+import org.springframework.beans.factory.annotation.Autowired
+import org.springframework.boot.test.context.SpringBootTest
+import org.springframework.boot.test.web.server.LocalServerPort
+import org.springframework.test.context.ActiveProfiles
+import java.net.URI
+import java.net.http.HttpClient
+import java.net.http.HttpRequest
+import java.net.http.HttpResponse
+import java.util.UUID
+import java.util.concurrent.Callable
+import java.util.concurrent.CountDownLatch
+import java.util.concurrent.Executors
+
+/**
+ * 실제 HTTP 요청을 동시에 보내 동시성 규칙을 확인한다.
+ * 데이터가 커밋되므로 다른 테스트에 영향을 주지 않도록 별도 in-memory DB 를 쓴다.
+ */
+@SpringBootTest(
+    webEnvironment = SpringBootTest.WebEnvironment.RANDOM_PORT,
+    properties = ["spring.datasource.url=jdbc:h2:mem:payment_concurrency;MODE=MySQL"],
+)
+@ActiveProfiles("test")
+class PaymentConcurrencyTest {
+    @LocalServerPort
+    private var port: Int = 0
+
+    @Autowired
+    private lateinit var memberService: MemberService
+
+    @Autowired
+    private lateinit var objectMapper: ObjectMapper
+
+    private val http: HttpClient = HttpClient.newHttpClient()
+
+    private fun newMemberApiKey(): String {
+        val name = "c" + UUID.randomUUID().toString().take(8)
+        return memberService.join(name, "1234", name).apiKey!!
+    }
+
+    private fun send(method: String, path: String, apiKey: String, body: String? = null): Pair<Int, String> {
+        val req = HttpRequest.newBuilder(URI.create("http://localhost:$port$path"))
+            .header("Authorization", "Bearer $apiKey")
+            .header("Content-Type", "application/json")
+            .method(method, if (body == null) HttpRequest.BodyPublishers.noBody() else HttpRequest.BodyPublishers.ofString(body))
+            .build()
+        val res = http.send(req, HttpResponse.BodyHandlers.ofString())
+        return res.statusCode() to res.body()
+    }
+
+    private fun balance(apiKey: String): Long =
+        objectMapper.readTree(send("GET", "/api/v1/wallet", apiKey).second)["balance"].asLong()
+
+    private fun charge(apiKey: String, amount: Long): Int =
+        send("POST", "/api/v1/wallet/charge", apiKey, """{"amount": $amount}""").first
+
+    private fun writePaid(apiKey: String, price: Long): Long {
+        val (status, body) = send("POST", "/api/v1/posts", apiKey, """{"title": "유료글", "content": "비밀본문", "price": $price}""")
+        assertThat(status).isEqualTo(201)
+        return objectMapper.readTree(body)["data"]["postDto"]["id"].asLong()
+    }
+
+    private fun purchase(apiKey: String, postId: Long): Int =
+        send("POST", "/api/v1/posts/$postId/purchase", apiKey).first
+
+    /** 모든 작업을 동시에 출발시키고 결과(상태 코드)를 모은다. */
+    private fun concurrently(tasks: List<() -> Int>): List<Int> {
+        val pool = Executors.newFixedThreadPool(32)
+        val start = CountDownLatch(1)
+        try {
+            val futures = tasks.map { task ->
+                pool.submit(Callable {
+                    start.await()
+                    task()
+                })
+            }
+            start.countDown()
+            return futures.map { it.get() }
+        } finally {
+            pool.shutdown()
+        }
+    }
+
+    @Test
+    @DisplayName("동시 충전 100건: 누락 없이 모두 반영")
+    fun concurrentCharge() {
+        val key = newMemberApiKey()
+
+        val results = concurrently(List(100) { { charge(key, 7) } })
+
+        assertThat(results).allMatch { it == 200 }
+        assertThat(balance(key)).isEqualTo(700)
+    }
+
+    @Test
+    @DisplayName("잔액 1000, 가격 300 짜리 서로 다른 글 20개 동시 구매: 정확히 3개만 성공, 잔액 100")
+    fun concurrentPurchaseInsufficient() {
+        val author = newMemberApiKey()
+        val buyer = newMemberApiKey()
+        val postIds = List(20) { writePaid(author, 300) }
+        assertThat(charge(buyer, 1000)).isEqualTo(200)
+
+        val results = concurrently(postIds.map { id -> { purchase(buyer, id) } })
+
+        assertThat(results.count { it == 201 }).isEqualTo(3)
+        assertThat(results.filter { it != 201 }).allMatch { it == 400 }
+        assertThat(balance(buyer)).isEqualTo(100)
+        assertThat(balance(author)).isEqualTo(900)
+    }
+
+    @Test
+    @DisplayName("같은 글 동시 구매 30건: 1건만 성공, 한 번만 차감")
+    fun concurrentDuplicatePurchase() {
+        val author = newMemberApiKey()
+        val buyer = newMemberApiKey()
+        val postId = writePaid(author, 300)
+        assertThat(charge(buyer, 10_000)).isEqualTo(200)
+
+        val results = concurrently(List(30) { { purchase(buyer, postId) } })
+
+        assertThat(results.count { it == 201 }).isEqualTo(1)
+        assertThat(results.filter { it != 201 }).allMatch { it == 409 }
+        assertThat(balance(buyer)).isEqualTo(9_700)
+        assertThat(balance(author)).isEqualTo(300)
+    }
+
+    @Test
+    @DisplayName("서로의 글을 동시에 구매 + 동시 충전: 교착/누락 없이 총액 보존")
+    fun concurrentCrossPurchaseAndCharge() {
+        val a = newMemberApiKey()
+        val b = newMemberApiKey()
+        val aPosts = List(15) { writePaid(a, 100) }
+        val bPosts = List(15) { writePaid(b, 100) }
+        assertThat(charge(a, 1_000)).isEqualTo(200)
+        assertThat(charge(b, 1_000)).isEqualTo(200)
+
+        val tasks = mutableListOf<() -> Int>()
+        bPosts.forEach { id -> tasks.add { purchase(a, id) } }
+        aPosts.forEach { id -> tasks.add { purchase(b, id) } }
+        repeat(20) { tasks.add { charge(a, 10) } }
+        repeat(20) { tasks.add { charge(b, 10) } }
+
+        val results = concurrently(tasks.shuffled())
+
+        // 충전 40건은 모두 성공해야 한다
+        val purchaseResults = results // 순서가 섞였으므로 전체 기준으로 확인
+        assertThat(purchaseResults).allMatch { it == 200 || it == 201 || it == 400 }
+
+        val total = balance(a) + balance(b)
+        assertThat(total).isEqualTo(2_000 + 400)
+        assertThat(balance(a)).isGreaterThanOrEqualTo(0)
+        assertThat(balance(b)).isGreaterThanOrEqualTo(0)
+        assertThat(results.count { it == 200 }).isEqualTo(40)
+    }
+}
diff --git a/src/test/kotlin/com/rest1/domain/post/purchase/PaymentFeatureTest.kt b/src/test/kotlin/com/rest1/domain/post/purchase/PaymentFeatureTest.kt
