+package com.rest1.domain.wallet.wallet.service
+
+import com.rest1.domain.member.member.repository.MemberRepository
+import com.rest1.global.exception.ServiceException
+import org.springframework.stereotype.Service
+import org.springframework.transaction.annotation.Transactional
+
+/**
+ * 회원 지갑. 잔액은 Member.balance 컬럼에 있고, 변경은 원자적 UPDATE 쿼리로만 한다.
+ */
+@Service
+class WalletService(
+    private val memberRepository: MemberRepository,
+) {
+    companion object {
+        // 1회 충전 한도
+        const val MAX_CHARGE_AMOUNT = 100_000_000L
+
+        // 지갑 최대 잔액 (Long 오버플로 방지용 상한)
+        const val MAX_BALANCE = 1_000_000_000_000_000L
+    }
+
+    @Transactional(readOnly = true)
+    fun getBalance(memberId: Long): Long {
+        return memberRepository.findBalanceById(memberId) ?: throw NoSuchElementException()
+    }
+
+    /** 충전 후 잔액을 돌려준다. */
+    @Transactional
+    fun charge(memberId: Long, amount: Long): Long {
+        if (amount < 1) throw ServiceException("400-6", "충전 금액은 1 이상이어야 합니다.")
+        if (amount > MAX_CHARGE_AMOUNT) throw ServiceException("400-6", "1회 충전 금액은 ${MAX_CHARGE_AMOUNT} 이하여야 합니다.")
+
+        val updated = memberRepository.increaseBalance(memberId, amount, MAX_BALANCE)
+
+        if (updated == 0) {
+            if (!memberRepository.existsById(memberId)) throw NoSuchElementException()
+            throw ServiceException("400-7", "최대 보유 가능 잔액을 넘어 충전할 수 없습니다.")
+        }
+
+        return memberRepository.findBalanceById(memberId)!!
+    }
+
+    /** 잔액이 충분할 때만 차감한다. 부족하면 예외(잔액은 그대로). */
+    @Transactional
+    fun withdraw(memberId: Long, amount: Long) {
+        require(amount > 0)
+
+        if (memberRepository.decreaseBalanceIfEnough(memberId, amount) == 0) {
+            if (!memberRepository.existsById(memberId)) throw NoSuchElementException()
+            throw ServiceException("400-5", "잔액이 부족합니다.")
+        }
+    }
+
+    /** 판매 대금 입금. 상한 검사는 하지 않는다(가격 상한 x 현실적 거래량으로 Long 범위를 넘을 수 없음). */
+    @Transactional
+    fun deposit(memberId: Long, amount: Long) {
+        require(amount > 0)
+
+        if (memberRepository.increaseBalance(memberId, amount, Long.MAX_VALUE) == 0) {
+            throw NoSuchElementException()
+        }
+    }
+}
