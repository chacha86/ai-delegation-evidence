+import com.rest1.global.exception.ServiceException
+import org.springframework.data.repository.findByIdOrNull
+import org.springframework.stereotype.Service
+import org.springframework.transaction.annotation.Transactional
+
+@Service
+class PurchaseService(
+    private val purchaseRepository: PurchaseRepository,
+    private val postRepository: PostRepository,
+    private val memberRepository: MemberRepository,
+    private val walletService: WalletService,
+) {
+    /**
+     * 유료 글 구매. 하나의 트랜잭션에서
+     *  0) 구매자·작성자 회원 행을 id 오름차순으로 잠금 (SELECT ... FOR UPDATE)
+     *  1) 구매 기록 INSERT (buyer_id, post_id 유니크 제약으로 중복 구매 차단)
+     *  2) 구매자 잔액 조건부 차감 (잔액 부족이면 예외)
+     *  3) 작성자 잔액 입금
+     * 을 하고, 어느 단계든 실패하면 전부 롤백된다(잔액·구매 기록 모두 그대로).
+     *
+     * - 회원 행을 항상 같은 순서로 먼저 잠그므로 A 가 B 의 글을, B 가 A 의 글을 동시에 사도 교착 상태가 생기지 않는다.
+     * - 같은 구매자의 구매 요청은 구매자 행 잠금 때문에 하나씩 처리된다.
+     * - 그래도 동시에 같은 글 구매가 겹치면 INSERT 가 유니크 제약 위반(DataIntegrityViolationException)으로 실패한다.
+     *   호출하는 쪽(컨트롤러)에서 409 로 바꾼다.
+     */
+    @Transactional
+    fun purchase(buyer: Member, postId: Long): Purchase {
+        val buyerId = buyer.id!!
+        val post = postRepository.findByIdOrNull(postId) ?: throw NoSuchElementException()
+
+        if (!post.isPaid) throw ServiceException("400-4", "무료 글은 구매할 수 없습니다.")
+        if (post.isAuthor(buyer)) throw ServiceException("403-3", "자신의 글은 구매할 수 없습니다.")
+
+        val price = post.price
+        val authorId = post.author.id!!
+
+        // 0) 교착 상태를 피하려고 두 회원 행을 id 오름차순으로 먼저 잠근다.
+        val locked = memberRepository.findAllByIdInOrderByIdForUpdate(listOf(buyerId, authorId))
+        if (locked.none { it.id == buyerId }) throw NoSuchElementException()
+
+        if (purchaseRepository.existsByBuyerIdAndPostId(buyerId, postId)) {
+            throw ServiceException("409-1", "이미 구매한 글입니다.")
+        }
+
+        // 1) 구매 기록. 동시 중복 구매는 최종적으로 여기서 유니크 제약으로 걸린다.
+        val purchase = purchaseRepository.saveAndFlush(
+            Purchase(memberRepository.getReferenceById(buyerId), post, price)
+        )
+
+        // 2) 차감 (잔액 부족이면 예외 -> 구매 기록까지 롤백)
+        walletService.withdraw(buyerId, price)
+        // 3) 작성자 입금
+        walletService.deposit(authorId, price)
+
+        return purchase
+    }
+
+    /**
+     * 본문 열람 권한: 무료 글은 누구나, 유료 글은 작성자와 구매자만.
+     * viewer 가 null 이면(비로그인) 유료 글은 볼 수 없다.
+     */
+    @Transactional(readOnly = true)
+    fun canReadContent(viewer: Member?, post: Post): Boolean {
+        if (!post.isPaid) return true
+        if (viewer == null) return false
+        if (post.isAuthor(viewer)) return true
+
+        return purchaseRepository.existsByBuyerIdAndPostId(viewer.id!!, post.id!!)
+    }
+
+    @Transactional(readOnly = true)
+    fun findPurchasedPostIds(viewer: Member?): Set<Long> {
+        if (viewer == null) return emptySet()
+
+        return purchaseRepository.findPostIdsByBuyerId(viewer.id!!).toSet()
+    }
+
+    @Transactional(readOnly = true)
+    fun hasPurchases(post: Post): Boolean = purchaseRepository.existsByPostId(post.id!!)
+}
