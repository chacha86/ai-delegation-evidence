+package com.rest1.domain.post.purchase
+
+import com.fasterxml.jackson.databind.JsonNode
+import com.fasterxml.jackson.databind.ObjectMapper
+import com.rest1.domain.member.member.repository.MemberRepository
+import com.rest1.domain.member.member.service.MemberService
+import org.assertj.core.api.Assertions.assertThat
+import org.junit.jupiter.api.DisplayName
+import org.junit.jupiter.api.Test
+import org.springframework.beans.factory.annotation.Autowired
+import org.springframework.boot.test.autoconfigure.web.servlet.AutoConfigureMockMvc
+import org.springframework.boot.test.context.SpringBootTest
+import org.springframework.http.MediaType
+import org.springframework.test.context.ActiveProfiles
+import org.springframework.test.web.servlet.MockMvc
+import org.springframework.test.web.servlet.request.MockHttpServletRequestBuilder
+import org.springframework.test.web.servlet.request.MockMvcRequestBuilders.delete
+import org.springframework.test.web.servlet.request.MockMvcRequestBuilders.get
+import org.springframework.test.web.servlet.request.MockMvcRequestBuilders.post
+import org.springframework.transaction.support.TransactionTemplate
+import java.util.UUID
+
+/**
+ * 테스트 트랜잭션(@Transactional)으로 감싸지 않는다.
+ * 감싸면 구매 실패 시의 롤백이 테스트 트랜잭션에 묻혀 실제 동작과 달라지기 때문이다.
+ * 대신 데이터가 커밋되므로 다른 테스트(글 id 를 검사하는 기존 테스트)에 영향을 주지 않게 별도 in-memory DB 를 쓰고,
+ * 테스트마다 새 회원을 만들어 서로 간섭하지 않게 한다.
+ */
+@SpringBootTest(properties = ["spring.datasource.url=jdbc:h2:mem:payment_feature;MODE=MySQL"])
+@ActiveProfiles("test")
+@AutoConfigureMockMvc
+class PaymentFeatureTest {
+    @Autowired
+    private lateinit var mvc: MockMvc
+
+    @Autowired
+    private lateinit var objectMapper: ObjectMapper
+
+    @Autowired
+    private lateinit var memberRepository: MemberRepository
+
+    @Autowired
+    private lateinit var memberService: MemberService
+
+    @Autowired
+    private lateinit var transactionTemplate: TransactionTemplate
+
+    private fun newMember(): String {
+        val name = "p" + UUID.randomUUID().toString().take(8)
+        return memberService.join(name, "1234", name).apiKey!!
+    }
+
+    data class Res(val status: Int, val body: JsonNode?)
+
+    private fun call(builder: MockHttpServletRequestBuilder, apiKey: String?, body: String? = null): Res {
+        if (apiKey != null) builder.header("Authorization", "Bearer $apiKey")
+        if (body != null) builder.contentType(MediaType.APPLICATION_JSON).content(body)
+
+        val response = mvc.perform(builder).andReturn().response
+        val text = response.getContentAsString(Charsets.UTF_8)
+
+        return Res(response.status, if (text.isBlank()) null else objectMapper.readTree(text))
+    }
+
+    private fun balance(apiKey: String): Long {
+        val res = call(get("/api/v1/wallet"), apiKey)
+        assertThat(res.status).isEqualTo(200)
+        return res.body!!["balance"].asLong()
+    }
+
+    private fun charge(apiKey: String, amountJson: String): Res =
+        call(post("/api/v1/wallet/charge"), apiKey, """{"amount": $amountJson}""")
+
+    private fun write(apiKey: String, price: String?): Res {
+        val priceField = if (price == null) "" else """, "price": $price"""
+        return call(post("/api/v1/posts"), apiKey, """{"title": "유료글", "content": "비밀본문"$priceField}""")
+    }
+
+    private fun writePaid(apiKey: String, price: Long): Long {
+        val res = write(apiKey, price.toString())
+        assertThat(res.status).isEqualTo(201)
+        return res.body!!["data"]["postDto"]["id"].asLong()
+    }
+
+    private fun purchase(apiKey: String, postId: Long): Res = call(post("/api/v1/posts/$postId/purchase"), apiKey)
+
+    private fun content(apiKey: String?, postId: Long): Res = call(get("/api/v1/posts/$postId/content"), apiKey)
+
+    @Test
+    @DisplayName("지갑: 처음 잔액은 0, 충전하면 늘어난다")
+    fun wallet1() {
+        val user1 = newMember()
+        val user2 = newMember()
+        assertThat(balance(user1)).isEqualTo(0)
+
+        val res = charge(user1, "1000")
+        assertThat(res.status).isEqualTo(200)
+        assertThat(res.body!!["data"]["balance"].asLong()).isEqualTo(1000)
+
+        charge(user1, "500")
+        assertThat(balance(user1)).isEqualTo(1500)
+        assertThat(balance(user2)).isEqualTo(0)
+    }
+
+    @Test
+    @DisplayName("지갑: 0, 음수, 소수, 누락, 문자, 한도 초과 충전은 거부되고 잔액은 그대로")
+    fun wallet2() {
+        val user1 = newMember()
+        charge(user1, "100")
+
+        for (bad in listOf("0", "-1", "-1000", "1.5", "null", "\"abc\"", "100000001", "99999999999999999999999")) {
+            val res = charge(user1, bad)
+            assertThat(res.status).describedAs("amount=$bad").isEqualTo(400)
+        }
+
+        val missing = call(post("/api/v1/wallet/charge"), user1, "{}")
+        assertThat(missing.status).isEqualTo(400)
+
+        assertThat(balance(user1)).isEqualTo(100)
+    }
+
+    @Test
+    @DisplayName("지갑: 로그인하지 않으면 401")
+    fun wallet3() {
+        assertThat(call(get("/api/v1/wallet"), null).status).isEqualTo(401)
+        assertThat(charge(null.toString(), "100").status).isEqualTo(401) // 잘못된 API 키
+        assertThat(call(post("/api/v1/wallet/charge"), null, """{"amount": 100}""").status).isEqualTo(401)
+    }
+
+    @Test
+    @DisplayName("글 작성: price 생략 시 0, 음수/소수 가격은 거부")
+    fun write1() {
+        val user1 = newMember()
+        val free = write(user1, null)
+        assertThat(free.status).isEqualTo(201)
+        assertThat(free.body!!["data"]["postDto"]["price"].asLong()).isEqualTo(0)
+        assertThat(free.body["data"]["postDto"]["paid"].asBoolean()).isFalse()
+
+        val paid = write(user1, "300")
+        assertThat(paid.status).isEqualTo(201)
+        assertThat(paid.body!!["data"]["postDto"]["price"].asLong()).isEqualTo(300)
+        assertThat(paid.body["data"]["postDto"]["content"].asText()).isEqualTo("비밀본문")
+
+        assertThat(write(user1, "-1").status).isEqualTo(400)
+        assertThat(write(user1, "1.5").status).isEqualTo(400)
+        assertThat(write(user1, "\"x\"").status).isEqualTo(400)
+    }
+
+    @Test
+    @DisplayName("구매 성공: 구매자 잔액 차감, 작성자 잔액 증가, 본문 열람 가능")
+    fun purchase1() {
+        val user1 = newMember()
+        val user2 = newMember()
+        val postId = writePaid(user1, 300)
+        charge(user2, "1000")
+
+        assertThat(content(user2, postId).status).isEqualTo(403)
+
+        val res = purchase(user2, postId)
+        assertThat(res.status).isEqualTo(201)
+        assertThat(res.body!!["data"]["balance"].asLong()).isEqualTo(700)
+
+        assertThat(balance(user2)).isEqualTo(700)
+        assertThat(balance(user1)).isEqualTo(300)
+
+        val c = content(user2, postId)
+        assertThat(c.status).isEqualTo(200)
+        assertThat(c.body!!["content"].asText()).isEqualTo("비밀본문")
+    }
+
+    @Test
+    @DisplayName("구매 실패: 잔액 부족이면 실패하고 잔액 그대로")
+    fun purchase2() {
+        val user1 = newMember()
+        val user2 = newMember()
+        val user3 = newMember()
+        val postId = writePaid(user1, 300)
+        charge(user2, "299")
+
+        assertThat(purchase(user2, postId).status).isEqualTo(400)
+        assertThat(balance(user2)).isEqualTo(299)
+        assertThat(balance(user1)).isEqualTo(0)
+        assertThat(content(user2, postId).status).isEqualTo(403)
+
+        // 잔액 0 에서도 마찬가지
+        assertThat(purchase(user3, postId).status).isEqualTo(400)
+        assertThat(balance(user3)).isEqualTo(0)
+    }
+
+    @Test
+    @DisplayName("구매 실패: 같은 글 두 번째 구매는 실패하고 돈은 한 번만 빠진다")
+    fun purchase3() {
+        val user1 = newMember()
+        val user2 = newMember()
+        val postId = writePaid(user1, 300)
+        charge(user2, "1000")
+
+        assertThat(purchase(user2, postId).status).isEqualTo(201)
+        assertThat(purchase(user2, postId).status).isEqualTo(409)
+
+        assertThat(balance(user2)).isEqualTo(700)
+        assertThat(balance(user1)).isEqualTo(300)
+    }
+
+    @Test
+    @DisplayName("구매 실패: 작성자는 자기 글을 살 수 없지만 본문은 볼 수 있다")
+    fun purchase4() {
+        val user1 = newMember()
+        val postId = writePaid(user1, 300)
+        charge(user1, "1000")
+
+        assertThat(purchase(user1, postId).status).isEqualTo(403)
+        assertThat(balance(user1)).isEqualTo(1000)
+
+        val c = content(user1, postId)
+        assertThat(c.status).isEqualTo(200)
+        assertThat(c.body!!["content"].asText()).isEqualTo("비밀본문")
+    }
+
+    @Test
+    @DisplayName("구매 실패: 무료 글, 없는 글, 비로그인")
+    fun purchase5() {
+        val user2 = newMember()
+        charge(user2, "1000")
+
+        assertThat(purchase(user2, 1).status).isEqualTo(400) // 1번 글은 무료
+        assertThat(purchase(user2, 999999).status).isEqualTo(404)
+        assertThat(call(post("/api/v1/posts/1/purchase"), null).status).isEqualTo(401)
+
+        assertThat(balance(user2)).isEqualTo(1000)
+    }
+
+    @Test
+    @DisplayName("열람: 유료 글 본문은 목록/단건/본문 API 어디에서도 작성자·구매자 외에는 보이지 않는다")
+    fun read1() {
+        val user1 = newMember()
+        val user2 = newMember()
+        val user3 = newMember()
+        val postId = writePaid(user1, 300)
+
+        // 비로그인
+        val listAnon = call(get("/api/v1/posts"), null)
+        val itemAnon = listAnon.body!!.first { it["id"].asLong() == postId }
+        assertThat(itemAnon["content"].isNull).isTrue()
+        assertThat(itemAnon["contentLocked"].asBoolean()).isTrue()
+        assertThat(call(get("/api/v1/posts/$postId"), null).body!!["content"].isNull).isTrue()
+        assertThat(content(null, postId).status).isEqualTo(401)
+
+        // 로그인했지만 구매하지 않은 회원
+        val listUser2 = call(get("/api/v1/posts"), user2)
+        assertThat(listUser2.body!!.first { it["id"].asLong() == postId }["content"].isNull).isTrue()
+        assertThat(call(get("/api/v1/posts/$postId"), user2).body!!["content"].isNull).isTrue()
+        assertThat(content(user2, postId).status).isEqualTo(403)
+        // user2 는 아무것도 사지 않았으므로 목록의 모든 유료 글 본문이 가려져야 한다
+        assertThat(listUser2.body.filter { it["paid"].asBoolean() }).allMatch { it["content"].isNull }
+        assertThat(call(get("/api/v1/posts"), null).body!!.filter { it["paid"].asBoolean() }).allMatch { it["content"].isNull }
+
+        // 관리자도 예외 없음
+        assertThat(content("admin", postId).status).isEqualTo(403)
+        assertThat(call(get("/api/v1/posts/$postId"), "admin").body!!.toString()).doesNotContain("비밀본문")
+
+        // 작성자
+        assertThat(call(get("/api/v1/posts/$postId"), user1).body!!["content"].asText()).isEqualTo("비밀본문")
+        assertThat(
+            call(get("/api/v1/posts"), user1).body!!.first { it["id"].asLong() == postId }["content"].asText()
+        ).isEqualTo("비밀본문")
+
+        // 구매 후
+        charge(user2, "300")
+        assertThat(purchase(user2, postId).status).isEqualTo(201)
+        assertThat(call(get("/api/v1/posts/$postId"), user2).body!!["content"].asText()).isEqualTo("비밀본문")
+        assertThat(
+            call(get("/api/v1/posts"), user2).body!!.first { it["id"].asLong() == postId }["content"].asText()
+        ).isEqualTo("비밀본문")
+
+        // 다른 회원은 여전히 못 본다
+        assertThat(content(user3, postId).status).isEqualTo(403)
+        assertThat(call(get("/api/v1/posts/$postId"), user3).body!!["content"].isNull).isTrue()
+    }
+
+    @Test
+    @DisplayName("열람: 무료 글 본문은 로그인한 누구나 볼 수 있다")
+    fun read2() {
+        val user3 = newMember()
+        val c = content(user3, 1)
+        assertThat(c.status).isEqualTo(200)
+        assertThat(c.body!!["content"].asText()).isEqualTo("내용1")
+        assertThat(content(user3, 999999).status).isEqualTo(404)
+    }
+
+    @Test
+    @DisplayName("삭제: 구매자가 있는 유료 글은 삭제할 수 없다, 구매자가 없으면 삭제 가능")
+    fun delete1() {
+        val user1 = newMember()
+        val user2 = newMember()
+        val sold = writePaid(user1, 300)
+        val unsold = writePaid(user1, 300)
+        charge(user2, "300")
+        purchase(user2, sold)
+
+        assertThat(call(delete("/api/v1/posts/$sold"), user1).status).isEqualTo(409)
+        assertThat(call(delete("/api/v1/posts/$unsold"), user1).status).isEqualTo(200)
+        assertThat(content(user2, sold).status).isEqualTo(200)
+    }
+
+    @Test
+    @DisplayName("엔티티 저장으로 잔액이 덮어써지지 않는다 (balance 는 updatable=false)")
+    fun balanceNotOverwritten() {
+        val user1 = newMember()
+        charge(user1, "500")
+
+        // 잔액 500 일 때 읽어 둔 엔티티를, 다른 트랜잭션의 충전이 커밋된 뒤 수정해서 저장해도
+        // 잔액이 500 으로 덮어써지지 않아야 한다
+        transactionTemplate.executeWithoutResult {
+            val member = memberRepository.findByApiKey(user1).get()
+            assertThat(member.balance).isEqualTo(500)
+
+            // 다른 스레드 = 다른 트랜잭션에서 충전하고 커밋
+            val other = Thread { assertThat(charge(user1, "500").status).isEqualTo(200) }
+            other.start()
+            other.join()
+
+            member.nickname = "새닉네임" // dirty checking 유도 -> 커밋 시 UPDATE
+        }
+
+        assertThat(memberRepository.findByApiKey(user1).get().nickname).isEqualTo("새닉네임")
+        assertThat(balance(user1)).isEqualTo(1000)
+    }
+}
