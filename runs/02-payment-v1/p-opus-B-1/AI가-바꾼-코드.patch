+package com.rest1.domain.post.purchase.controller
+
+import com.rest1.domain.post.purchase.dto.PurchaseDto
+import com.rest1.domain.post.purchase.service.PurchaseService
+import com.rest1.domain.wallet.wallet.service.WalletService
+import com.rest1.global.exception.ServiceException
+import com.rest1.global.retry.retryOnConcurrencyFailure
+import com.rest1.global.rq.Rq
+import com.rest1.global.rsData.RsData
+import io.swagger.v3.oas.annotations.Operation
+import io.swagger.v3.oas.annotations.security.SecurityRequirement
+import io.swagger.v3.oas.annotations.tags.Tag
+import org.springframework.dao.DataIntegrityViolationException
+import org.springframework.web.bind.annotation.PathVariable
+import org.springframework.web.bind.annotation.PostMapping
+import org.springframework.web.bind.annotation.RequestMapping
+import org.springframework.web.bind.annotation.RestController
+
+// 트랜잭션은 PurchaseService.purchase 단위로 건다 (컨트롤러에 @Transactional 을 두지 않는다)
+@RestController
+@RequestMapping("/api/v1/posts")
+@Tag(name = "ApiV1PostPurchaseController", description = "유료 글 구매 API")
+@SecurityRequirement(name = "bearerAuth")
+class ApiV1PostPurchaseController(
+    private val purchaseService: PurchaseService,
+    private val walletService: WalletService,
+    private val rq: Rq,
+) {
+    data class PurchaseResBody(
+        val purchase: PurchaseDto,
+        val balance: Long,
+    )
+
+    @PostMapping("/{id}/purchase")
+    @Operation(summary = "유료 글 구매")
+    fun purchase(
+        @PathVariable id: Long,
+    ): RsData<PurchaseResBody> {
+        val actor = rq.actor
+        val buyerId = actor.id!!
+
+        val purchase = try {
+            retryOnConcurrencyFailure { purchaseService.purchase(actor, id) }
+        } catch (e: DataIntegrityViolationException) {
+            // 같은 글을 동시에 두 번 구매하려 한 경우 (buyer_id, post_id 유니크 제약 위반)
+            // 또는 구매 도중 글이 삭제된 경우. 트랜잭션은 이미 전부 롤백되어 잔액은 그대로다.
+            throw ServiceException("409-1", "이미 구매한 글이거나 구매할 수 없는 글입니다.")
+        }
+
+        return RsData(
+            "201-1",
+            "${id}번 글을 구매했습니다.",
+            PurchaseResBody(
+                PurchaseDto(purchase, id, buyerId),
+                walletService.getBalance(buyerId),
+            ),
+        )
+    }
+}
