+import org.springframework.data.jpa.repository.JpaRepository
+import org.springframework.data.jpa.repository.Query
+import org.springframework.data.repository.query.Param
+
+interface PurchaseRepository : JpaRepository<Purchase, Long> {
+    fun existsByBuyerIdAndPostId(buyerId: Long, postId: Long): Boolean
+
+    fun existsByPostId(postId: Long): Boolean
+
+    @Query("select p.post.id from Purchase p where p.buyer.id = :buyerId")
+    fun findPostIdsByBuyerId(@Param("buyerId") buyerId: Long): List<Long>
