+package com.rest1.global.retry
+
+import com.rest1.global.exception.ServiceException
+import org.springframework.dao.ConcurrencyFailureException
+
+/**
+ * 잠금 대기 시간 초과·교착 상태(ConcurrencyFailureException) 가 나면 block 을 다시 실행한다.
+ * block 은 @Transactional 서비스 메서드를 호출해야 한다(시도마다 새 트랜잭션, 실패 시 전부 롤백).
+ * 따라서 이 함수를 부르는 쪽은 트랜잭션 밖이어야 한다.
+ */
+fun <T> retryOnConcurrencyFailure(maxAttempts: Int = 5, block: () -> T): T {
+    var attempt = 0
+
+    while (true) {
+        attempt++
+
+        try {
+            return block()
+        } catch (e: ConcurrencyFailureException) {
+            if (attempt >= maxAttempts) {
+                throw ServiceException("409-3", "동시에 처리 중인 요청이 많습니다. 잠시 후 다시 시도해주세요.")
+            }
+
+            Thread.sleep(20L * attempt)
+        }
+    }
+}
