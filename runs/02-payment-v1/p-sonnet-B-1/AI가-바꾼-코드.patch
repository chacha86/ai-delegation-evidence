@@ -0,0 +1,93 @@
+package com.rest1.domain.post.post.service
+
+import com.rest1.domain.member.member.repository.MemberRepository
+import com.rest1.domain.post.post.entity.Post
+import com.rest1.domain.post.post.entity.Purchase
+import com.rest1.domain.post.post.repository.PurchaseRepository
+import com.rest1.global.exception.ServiceException
+import org.springframework.dao.DataIntegrityViolationException
+import org.springframework.stereotype.Service
+import org.springframework.transaction.annotation.Transactional
+
+@Service
+class PurchaseService(
+    private val memberRepository: MemberRepository,
+    private val purchaseRepository: PurchaseRepository,
+) {
+    companion object {
+        const val MAX_AMOUNT = 1_000_000_000_000L // 1회 충전/가격 상한
+        const val MAX_BALANCE = 1_000_000_000_000_000L // 잔액 상한 (Long 오버플로 방지)
+    }
+
+    fun balanceOf(memberId: Long): Long =
+        memberRepository.findBalanceById(memberId) ?: throw ServiceException("404-2", "존재하지 않는 회원입니다.")
+
+    @Transactional
+    fun charge(memberId: Long, amount: Long): Long {
+        if (amount < 1) throw ServiceException("400-3", "충전 금액은 1 이상이어야 합니다.")
+        if (amount > MAX_AMOUNT) throw ServiceException("400-4", "충전 금액이 너무 큽니다.")
+
+        val updated = memberRepository.addBalance(memberId, amount, MAX_BALANCE - amount)
+
+        if (updated == 0) {
+            balanceOf(memberId) // 회원이 없으면 404
+            throw ServiceException("400-5", "잔액 한도를 초과합니다.")
+        }
+
+        return balanceOf(memberId)
+    }
+
+    fun isPaid(post: Post): Boolean = post.price > 0
+
+    fun canRead(post: Post, viewerId: Long?): Boolean {
+        if (!isPaid(post)) return true
+        if (viewerId == null) return false
+        if (post.author.id == viewerId) return true
+
+        return purchaseRepository.existsByPostIdAndBuyerId(post.id!!, viewerId)
+    }
+
+    // 목록 조회용: 구매한 글 id 집합을 한 번에 가져온다
+    fun purchasedPostIds(viewerId: Long?): Set<Long> =
+        if (viewerId == null) emptySet() else purchaseRepository.findPostIdsByBuyerId(viewerId).toSet()
+
+    @Transactional
+    fun purchase(buyerId: Long, post: Post) {
+        val authorId = post.author.id!!
+
+        if (!isPaid(post)) throw ServiceException("400-6", "무료 글은 구매할 수 없습니다.")
+        if (authorId == buyerId) throw ServiceException("403-4", "자신의 글은 구매할 수 없습니다.")
+        if (purchaseRepository.existsByPostIdAndBuyerId(post.id!!, buyerId)) {
+            throw ServiceException("409-2", "이미 구매한 글입니다.")
+        }
+
+        // 1) 구매 기록 먼저: 동시에 같은 구매가 오면 유니크 제약이 하나만 통과시킨다
+        //    (실패한 쪽은 예외로 트랜잭션 전체가 롤백되어 차감도 취소된다)
+        try {
+            purchaseRepository.saveAndFlush(Purchase(post.id!!, buyerId, post.price))
+        } catch (e: DataIntegrityViolationException) {
+            throw ServiceException("409-2", "이미 구매한 글입니다.")
+        }
+
+        // 2) 지갑 갱신은 항상 id 오름차순으로 락을 잡아 교차 구매 시 데드락을 막는다
+        if (buyerId < authorId) {
+            debit(buyerId, post.price)
+            credit(authorId, post.price)
+        } else {
+            credit(authorId, post.price)
+            debit(buyerId, post.price)
+        }
+    }
+
+    private fun debit(buyerId: Long, price: Long) {
+        if (memberRepository.subtractBalance(buyerId, price) == 0) {
+            throw ServiceException("402-1", "잔액이 부족합니다.")
+        }
+    }
+
+    private fun credit(authorId: Long, price: Long) {
+        if (memberRepository.addBalance(authorId, price, MAX_BALANCE - price) == 0) {
+            throw ServiceException("500-1", "판매자 지갑에 입금할 수 없습니다.")
+        }
+    }
+}
