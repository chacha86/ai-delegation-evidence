+            mvc.perform(json(get("/api/v1/posts/$id"), k))
+                .andExpect(status().isOk).andExpect(jsonPath("$.content").doesNotExist())
+            val list = mvc.perform(json(get("/api/v1/posts"), k)).andReturn().response.contentAsString
+            assertThat(list).doesNotContain("비밀본문")
+        }
+        mvc.perform(json(get("/api/v1/posts/$id/content"), author))
+            .andExpect(status().isOk).andExpect(jsonPath("$.content").value("비밀본문입니다"))
+        mvc.perform(json(get("/api/v1/posts/$id"), author)).andExpect(jsonPath("$.content").value("비밀본문입니다"))
+
+        // 잔액 부족
+        charge(buyer, "299")
