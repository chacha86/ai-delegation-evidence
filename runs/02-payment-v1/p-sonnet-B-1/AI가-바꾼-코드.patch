+    fun crossPurchase() {
+        val a = write(author, "10")
+        val b = write(buyer, "10")
+        charge(author, "1000")
+        charge(buyer, "1000")
+        parallel(20) { if (it % 2 == 0) purchase(author, b) else purchase(buyer, a) }
