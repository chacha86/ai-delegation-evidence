+import org.springframework.web.bind.annotation.RestController
+import java.math.BigDecimal
+
+@RestController
+@RequestMapping("/api/v1/wallet")
+@Tag(name = "ApiV1WalletController", description = "지갑 API")
+@SecurityRequirement(name = "bearerAuth")
+class ApiV1WalletController(
+    private val walletService: WalletService,
+    private val rq: Rq,
+) {
+    @GetMapping
+    @Operation(summary = "내 지갑(잔액) 조회")
+    fun getMyWallet(): WalletDto {
+        val actorId = rq.actor.id!!
+
+        return WalletDto(actorId, walletService.getBalance(actorId))
+    }
+
+    // BigDecimal 로 받는 이유: Long 으로 받으면 Jackson 이 1.5 를 1 로 잘라 버린다. 소수는 거부한다.
+    data class ChargeReqBody(
+        @field:NotNull
+        @field:DecimalMin("1")
+        @field:DecimalMax("1000000000")
+        @field:Digits(integer = 10, fraction = 0)
+        val amount: BigDecimal?,
+    )
+
+    @PostMapping("/charge")
+    @Operation(summary = "충전")
+    fun charge(
+        @RequestBody @Valid reqBody: ChargeReqBody,
+    ): RsData<WalletDto> {
+        val actorId = rq.actor.id!!
+        val amount = reqBody.amount!!.longValueExact()
+
+        val balance = walletService.charge(actorId, amount)
+
+        return RsData(
+            "200-1",
+            "${amount}원이 충전되었습니다.",
+            WalletDto(actorId, balance),
+        )
+    }
+}
