+package com.rest1.domain.wallet.repository
+
+import com.rest1.domain.wallet.entity.Wallet
+import org.springframework.data.jpa.repository.JpaRepository
+import org.springframework.data.jpa.repository.Modifying
+import org.springframework.data.jpa.repository.Query
+import org.springframework.data.repository.query.Param
+import java.time.LocalDateTime
+
+interface WalletRepository : JpaRepository<Wallet, Long> {
+    fun existsByMemberId(memberId: Long): Boolean
+
+    // 스칼라 조회라 영속성 컨텍스트의 캐시된 엔티티가 아니라 항상 DB 값을 읽는다
+    @Query("select w.balance from Wallet w where w.memberId = :memberId")
+    fun findBalanceByMemberId(@Param("memberId") memberId: Long): Long?
+
+    /**
+     * 잔액을 늘린다. 늘린 뒤 잔액이 상한을 넘으면 갱신하지 않는다(0 반환).
+     * maxBalanceBefore = 상한 - amount
+     */
+    @Modifying(flushAutomatically = true, clearAutomatically = false)
+    @Query(
+        """
+        update Wallet w
+        set w.balance = w.balance + :amount, w.modifyDate = :now
+        where w.memberId = :memberId and w.balance <= :maxBalanceBefore
+        """
+    )
+    fun increaseBalance(
+        @Param("memberId") memberId: Long,
+        @Param("amount") amount: Long,
+        @Param("maxBalanceBefore") maxBalanceBefore: Long,
+        @Param("now") now: LocalDateTime,
+    ): Int
+
+    /**
+     * 잔액이 amount 이상일 때만 줄인다(0 반환이면 잔액 부족). 잔액이 음수가 되는 일은 없다.
+     */
+    @Modifying(flushAutomatically = true, clearAutomatically = false)
+    @Query(
+        """
+        update Wallet w
+        set w.balance = w.balance - :amount, w.modifyDate = :now
+        where w.memberId = :memberId and w.balance >= :amount
+        """
+    )
+    fun decreaseBalance(
+        @Param("memberId") memberId: Long,
+        @Param("amount") amount: Long,
+        @Param("now") now: LocalDateTime,
+    ): Int
+}
diff --git a/src/main/kotlin/com/rest1/domain/wallet/service/WalletService.kt b/src/main/kotlin/com/rest1/domain/wallet/service/WalletService.kt
