@@ -0,0 +1,85 @@
+package com.rest1.domain.wallet.service
+
+import com.rest1.domain.member.member.repository.MemberRepository
+import com.rest1.domain.wallet.entity.Wallet
+import com.rest1.domain.wallet.repository.WalletRepository
+import com.rest1.global.exception.ServiceException
+import org.springframework.stereotype.Service
+import org.springframework.transaction.annotation.Propagation
+import org.springframework.transaction.annotation.Transactional
+import java.time.LocalDateTime
+
+/**
+ * 동시성 규칙
+ * - 한 회원의 지갑을 바꾸는 모든 작업은 먼저 그 회원(Member) 행을 SELECT ... FOR UPDATE 로 잠근다.
+ *   그래서 같은 회원에 대한 충전/구매/지갑 생성이 한 번에 하나씩만 진행된다.
+ * - 여러 회원을 잠글 때는 항상 id 오름차순으로 잠가 교착상태를 피한다.
+ * - 잔액 변경은 조건부 UPDATE(잔액 >= 금액, 상한 이하)로 해서, 잠금이 없더라도 음수가 될 수 없다.
+ */
+@Service
+class WalletService(
+    private val walletRepository: WalletRepository,
+    private val memberRepository: MemberRepository,
+) {
+    companion object {
+        const val MIN_CHARGE_AMOUNT = 1L
+        const val MAX_CHARGE_AMOUNT = 1_000_000_000L // 1회 충전 상한 10억
+        const val MAX_BALANCE = 1_000_000_000_000_000L // 잔액 상한 10^15 (Long 오버플로 방지)
+    }
+
+    @Transactional(readOnly = true)
+    fun getBalance(memberId: Long): Long = walletRepository.findBalanceByMemberId(memberId) ?: 0L
+
+    @Transactional
+    fun charge(memberId: Long, amount: Long): Long {
+        if (amount < MIN_CHARGE_AMOUNT || amount > MAX_CHARGE_AMOUNT) {
+            throw ServiceException("400-3", "충전 금액은 $MIN_CHARGE_AMOUNT 이상 $MAX_CHARGE_AMOUNT 이하여야 합니다.")
+        }
+
+        lockWallets(memberId)
+        deposit(memberId, amount)
+
+        return walletRepository.findBalanceByMemberId(memberId)!!
+    }
+
+    /**
+     * 주어진 회원들의 행을 id 오름차순으로 잠그고, 지갑이 없으면 만든다.
+     * 반드시 바깥 트랜잭션 안에서 불러야 한다(잠금은 트랜잭션이 끝날 때 풀린다).
+     */
+    @Transactional(propagation = Propagation.MANDATORY)
+    fun lockWallets(vararg memberIds: Long) {
+        memberIds.distinct().sorted().forEach { memberId ->
+            memberRepository.findByIdForUpdate(memberId)
+                ?: throw ServiceException("404-2", "존재하지 않는 회원입니다.")
+
+            // 회원 행을 잠근 뒤라 같은 회원의 지갑을 동시에 두 번 만들 일은 없다
+            if (!walletRepository.existsByMemberId(memberId)) {
+                walletRepository.saveAndFlush(Wallet(memberId))
+            }
+        }
+    }
+
+    /** lockWallets 로 잠근 뒤에 부른다. */
+    @Transactional(propagation = Propagation.MANDATORY)
+    fun deposit(memberId: Long, amount: Long) {
+        require(amount > 0)
+
+        val updated = walletRepository.increaseBalance(memberId, amount, MAX_BALANCE - amount, LocalDateTime.now())
+
+        if (updated == 0) {
+            throw ServiceException("400-4", "잔액 한도($MAX_BALANCE)를 넘을 수 없습니다.")
+        }
+    }
+
+    /** lockWallets 로 잠근 뒤에 부른다. */
+    @Transactional(propagation = Propagation.MANDATORY)
+    fun withdraw(memberId: Long, amount: Long) {
+        require(amount > 0)
+
+        val updated = walletRepository.decreaseBalance(memberId, amount, LocalDateTime.now())
+
+        if (updated == 0) {
+            throw ServiceException("400-5", "잔액이 부족합니다.")
+        }
+    }
+}
