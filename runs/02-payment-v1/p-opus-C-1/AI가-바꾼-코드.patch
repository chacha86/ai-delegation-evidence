+package com.rest1.domain.post.purchase.service
+
+import com.rest1.domain.member.member.repository.MemberRepository
+import com.rest1.domain.post.post.entity.Post
+import com.rest1.domain.post.post.repository.PostRepository
+import com.rest1.domain.post.purchase.entity.PostPurchase
+import com.rest1.domain.post.purchase.repository.PostPurchaseRepository
+import com.rest1.domain.wallet.repository.WalletRepository
+import com.rest1.domain.wallet.service.WalletService
+import com.rest1.global.exception.ServiceException
+import org.springframework.stereotype.Service
+import org.springframework.transaction.annotation.Transactional
+
+@Service
+class PostPurchaseService(
+    private val postRepository: PostRepository,
+    private val memberRepository: MemberRepository,
+    private val postPurchaseRepository: PostPurchaseRepository,
+    private val walletService: WalletService,
+    private val walletRepository: WalletRepository,
+) {
+    data class PurchaseResult(
+        val purchase: PostPurchase,
+        val buyerBalance: Long,
+    )
+
+    /**
+     * 잠금 순서: 글 행 -> 회원 행(id 오름차순). 글 삭제도 글 행을 먼저 잠그므로 순서가 엇갈리지 않는다.
+     * 중간에 실패하면(예외) 트랜잭션 전체가 롤백되어 잔액은 그대로다.
+     */
+    @Transactional
+    fun purchase(postId: Long, buyerId: Long): PurchaseResult {
+        val post = postRepository.findByIdForUpdate(postId) ?: throw NoSuchElementException()
+
+        if (!post.isPaid) {
+            throw ServiceException("400-6", "무료 글은 구매할 수 없습니다.")
+        }
+
+        val authorId = post.author.id!!
+
+        if (authorId == buyerId) {
+            throw ServiceException("403-3", "자신의 글은 구매할 수 없습니다.")
+        }
+
+        walletService.lockWallets(buyerId, authorId)
+
+        // 구매자 행을 잠근 뒤에 확인하므로, 같은 구매자의 동시 요청은 여기서 한 줄로 선다
+        if (postPurchaseRepository.existsByPostIdAndBuyerId(postId, buyerId)) {
+            throw ServiceException("409-2", "이미 구매한 글입니다.")
+        }
+
+        walletService.withdraw(buyerId, post.price)
+        walletService.deposit(authorId, post.price)
+
+        val purchase = postPurchaseRepository.saveAndFlush(
+            PostPurchase(post, memberRepository.getReferenceById(buyerId), post.price)
+        )
+
+        return PurchaseResult(purchase, walletRepository.findBalanceByMemberId(buyerId)!!)
+    }
+
+    /**
+     * 본문 열람 권한.
+     * - 무료 글: 누구나 (기존 글 목록/단건 조회가 비로그인에게도 본문을 보여 주던 동작 유지)
+     * - 유료 글: 작성자 또는 구매자만
+     */
+    @Transactional(readOnly = true)
+    fun canReadContent(post: Post, actorId: Long?): Boolean {
+        if (!post.isPaid) return true
+        if (actorId == null) return false
+        if (post.author.id == actorId) return true
+
+        return postPurchaseRepository.existsByPostIdAndBuyerId(post.id!!, actorId)
+    }
+
+    /** 목록 조회용. 본문을 볼 수 있는 글 id 집합을 쿼리 한 번으로 구한다. */
+    @Transactional(readOnly = true)
+    fun readablePostIds(posts: List<Post>, actorId: Long?): Set<Long> {
+        val readable = posts
+            .filter { !it.isPaid || (actorId != null && it.author.id == actorId) }
+            .mapNotNull { it.id }
+            .toMutableSet()
+
+        if (actorId == null) return readable
+
+        val candidates = posts
+            .filter { it.isPaid && it.author.id != actorId }
+            .mapNotNull { it.id }
+
+        if (candidates.isNotEmpty()) {
+            readable += postPurchaseRepository.findPurchasedPostIds(actorId, candidates)
+        }
+
+        return readable
+    }
+}
