+package com.rest1.domain.post.purchase.repository
+
+import com.rest1.domain.post.purchase.entity.PostPurchase
+import org.springframework.data.jpa.repository.JpaRepository
+import org.springframework.data.jpa.repository.Query
+import org.springframework.data.repository.query.Param
+
+interface PostPurchaseRepository : JpaRepository<PostPurchase, Long> {
+    @Query("select count(p) > 0 from PostPurchase p where p.post.id = :postId and p.buyer.id = :buyerId")
+    fun existsByPostIdAndBuyerId(@Param("postId") postId: Long, @Param("buyerId") buyerId: Long): Boolean
+
+    @Query("select count(p) > 0 from PostPurchase p where p.post.id = :postId")
+    fun existsByPostId(@Param("postId") postId: Long): Boolean
+
+    @Query("select p.post.id from PostPurchase p where p.buyer.id = :buyerId and p.post.id in :postIds")
+    fun findPurchasedPostIds(
+        @Param("buyerId") buyerId: Long,
+        @Param("postIds") postIds: Collection<Long>,
+    ): List<Long>
+}
