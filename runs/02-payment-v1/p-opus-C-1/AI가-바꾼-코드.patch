+package com.rest1.domain.wallet.entity
+
+import com.rest1.global.jpa.entity.BaseEntity
+import jakarta.persistence.Column
+import jakarta.persistence.Entity
+import org.hibernate.annotations.Check
+
+/**
+ * 회원 1명당 지갑 1개. 처음 잔액은 0.
+ *
+ * 잔액 변경은 엔티티 상태(dirty checking)가 아니라 WalletRepository 의 조건부 UPDATE 로만 한다.
+ * (영속성 컨텍스트에 남은 오래된 값으로 덮어쓰는 일을 막기 위함)
+ * DB 에도 balance >= 0 체크 제약을 걸어 둔다(테이블을 새로 만들 때만 적용됨).
+ */
+@Entity
+@Check(constraints = "balance >= 0")
+class Wallet(
+    @Column(unique = true, nullable = false)
+    val memberId: Long,
+) : BaseEntity() {
+    @Column(nullable = false)
+    var balance: Long = 0
+        protected set
+}
