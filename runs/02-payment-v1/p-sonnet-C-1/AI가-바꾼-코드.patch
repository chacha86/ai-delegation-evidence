+import java.util.concurrent.Executors
+
+/** PaymentPolicyTest 가 다루지 않는 경계·동시성 케이스 (직접 추가한 테스트). */
+@SpringBootTest(webEnvironment = SpringBootTest.WebEnvironment.RANDOM_PORT)
+@ActiveProfiles("test")
+class PaymentExtraTest {
+    @LocalServerPort
+    private var port: Int = 0
+    private val http = HttpClient.newHttpClient()
+    private val om = ObjectMapper()
+
+    private fun call(method: String, path: String, key: String? = null, body: String? = null): Pair<Int, String> {
+        val b = HttpRequest.newBuilder(URI.create("http://localhost:$port$path"))
+            .header("Content-Type", "application/json")
+            .method(method, if (body == null) HttpRequest.BodyPublishers.noBody() else HttpRequest.BodyPublishers.ofString(body))
+        if (key != null) b.header("Authorization", "Bearer $key")
+        val r = http.send(b.build(), HttpResponse.BodyHandlers.ofString())
+        return r.statusCode() to r.body()
+    }
+
+    private fun find(n: JsonNode?, k: String): JsonNode? {
+        if (n == null) return null
+        if (n.has(k)) return n.get(k)
+        n.elements().forEach { c -> find(c, k)?.let { return it } }
+        return null
+    }
+
+    private fun user(): String {
+        val name = "x" + UUID.randomUUID().toString().take(8)
+        call("POST", "/api/v1/members/join", null, """{"username":"$name","password":"1234","nickname":"$name"}""")
+        val r = call("POST", "/api/v1/members/login", null, """{"username":"$name","password":"1234"}""")
+        return find(om.readTree(r.second), "apiKey")!!.asText()
+    }
+
+    private fun bal(k: String) = find(om.readTree(call("GET", "/api/v1/wallet", k).second), "balance")!!.asLong()
+    private fun charge(k: String, a: String) = call("POST", "/api/v1/wallet/charge", k, """{"amount":$a}""")
+    private fun post(k: String, price: String, content: String = "비밀-" + UUID.randomUUID().toString().take(6)): Pair<Long, String> {
+        val r = call("POST", "/api/v1/posts", k, """{"title":"제목입니다","content":"$content","price":$price}""")
+        return find(om.readTree(r.second), "id")!!.asLong() to content
+    }
+
+    private fun <T> par(n: Int, f: (Int) -> T): List<T> {
+        val pool = Executors.newFixedThreadPool(n)
+        val r = pool.invokeAll((0 until n).map { i -> Callable { f(i) } }).map { it.get() }
+        pool.shutdown()
+        return r
+    }
+
+    @Test
+    fun `새 회원 잔액은 0, 소수 음수 문자열 충전은 거부`() {
+        val u = user()
+        assertThat(bal(u)).isEqualTo(0)
+        for (a in listOf("1.5", "-5", "\"abc\"", "null", "99999999999999999999")) {
+            assertThat(charge(u, a).first).isGreaterThanOrEqualTo(400)
+        }
+        assertThat(bal(u)).isEqualTo(0)
+    }
+
+    @Test
+    fun `유료 본문은 비로그인 목록과 단건에서도 숨겨지고 구매자 작성자에게만 보인다`() {
+        val a = user(); val b = user(); val c = user()
+        val (id, content) = post(a, "100")
+        charge(b, "100"); b.let { call("POST", "/api/v1/posts/$id/purchase", it) }
+        assertThat(call("GET", "/api/v1/posts").second).doesNotContain(content)
+        assertThat(call("GET", "/api/v1/posts/$id").second).doesNotContain(content)
+        assertThat(call("GET", "/api/v1/posts", c).second).doesNotContain(content)
+        assertThat(call("GET", "/api/v1/posts/$id/content", c).first).isEqualTo(403)
+        assertThat(call("GET", "/api/v1/posts/$id/content").first).isEqualTo(401)
+        assertThat(call("GET", "/api/v1/posts", b).second).contains(content)
+        assertThat(call("GET", "/api/v1/posts/$id", a).second).contains(content)
+    }
+
+    @Test
+    fun `가격 생략은 무료 소수 가격은 거부 무료 글은 구매 불가`() {
+        val a = user(); val b = user()
+        val r = call("POST", "/api/v1/posts", a, """{"title":"제목입니다","content":"공개 본문"}""")
+        val id = find(om.readTree(r.second), "id")!!.asLong()
+        assertThat(call("GET", "/api/v1/posts/$id/content", b).first).isEqualTo(200)
+        charge(b, "10")
+        assertThat(call("POST", "/api/v1/posts/$id/purchase", b).first).isGreaterThanOrEqualTo(400)
+        assertThat(bal(b)).isEqualTo(10)
+        assertThat(call("POST", "/api/v1/posts", a, """{"title":"제목입니다","content":"본문입니다","price":1.5}""").first).isGreaterThanOrEqualTo(400)
+    }
+
+    @Test
+    fun `잔액이 한 번 분만 있을 때 동시 구매는 한 번만 성공하고 음수가 되지 않는다`() {
+        val a = user(); val b = user()
+        val (id, _) = post(a, "200")
+        charge(b, "300")
+        val res = par(6) { call("POST", "/api/v1/posts/$id/purchase", b).first }
+        assertThat(res.count { it in 200..299 }).isEqualTo(1)
+        assertThat(bal(b)).isEqualTo(100)
+        assertThat(bal(a)).isEqualTo(200)
+    }
+
+    @Test
+    fun `여러 구매자가 동시에 사면 작성자 잔액이 정확하다`() {
+        val a = user()
+        val (id, _) = post(a, "50")
+        val buyers = (1..5).map { user().also { k -> charge(k, "100") } }
+        par(5) { call("POST", "/api/v1/posts/$id/purchase", buyers[it]).first }
+        assertThat(bal(a)).isEqualTo(250)
+        buyers.forEach { assertThat(bal(it)).isEqualTo(50) }
+    }
+
+    @Test
+    fun `서로의 글을 동시에 사도 교착 없이 처리된다`() {
+        val a = user(); val b = user()
+        val (ia, _) = post(a, "10"); val (ib, _) = post(b, "10")
+        charge(a, "100"); charge(b, "100")
+        val res = par(2) { if (it == 0) call("POST", "/api/v1/posts/$ib/purchase", a).first else call("POST", "/api/v1/posts/$ia/purchase", b).first }
+        assertThat(res).allMatch { it in 200..299 }
+        assertThat(bal(a)).isEqualTo(100); assertThat(bal(b)).isEqualTo(100)
+    }
