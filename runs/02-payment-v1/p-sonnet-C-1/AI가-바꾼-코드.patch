+package com.rest1.domain.wallet.controller
+
+import com.rest1.domain.wallet.service.WalletService
+import com.rest1.global.exception.ServiceException
+import com.rest1.global.rq.Rq
+import com.rest1.global.rsData.RsData
+import io.swagger.v3.oas.annotations.Operation
+import io.swagger.v3.oas.annotations.security.SecurityRequirement
+import io.swagger.v3.oas.annotations.tags.Tag
+import org.springframework.web.bind.annotation.GetMapping
+import org.springframework.web.bind.annotation.PostMapping
+import org.springframework.web.bind.annotation.RequestBody
+import org.springframework.web.bind.annotation.RequestMapping
+import org.springframework.web.bind.annotation.RestController
+
+@RestController
+@RequestMapping("/api/v1/wallet")
+@Tag(name = "ApiV1WalletController", description = "지갑 API")
+@SecurityRequirement(name = "bearerAuth")
+class ApiV1WalletController(
+    private val walletService: WalletService,
+    private val rq: Rq,
+) {
+    data class WalletResBody(val balance: Long)
+
+    // amount 를 Number 로 받아 1.5 같은 소수가 조용히 1 로 잘리는 것을 막는다.
+    data class ChargeReqBody(val amount: Number?)
+
+    @GetMapping
+    @Operation(summary = "잔액 조회")
+    fun getBalance(): WalletResBody = WalletResBody(walletService.balanceOf(rq.actor.id!!))
+
+    @PostMapping("/charge")
+    @Operation(summary = "충전")
+    fun charge(@RequestBody reqBody: ChargeReqBody): RsData<WalletResBody> {
+        val amount = asLong(reqBody.amount)
+            ?: throw ServiceException("400-3", "충전 금액은 1 이상의 정수여야 합니다.")
+        val balance = walletService.charge(rq.actor.id!!, amount)
+        return RsData("200-1", "충전되었습니다.", WalletResBody(balance))
+    }
+
+    private fun asLong(n: Number?): Long? = when (n) {
+        is Int -> n.toLong()
+        is Long -> n
+        else -> null
+    }
+}
