+package com.rest1.domain.wallet.repository
+
+import com.rest1.domain.wallet.entity.Wallet
+import org.springframework.data.jpa.repository.JpaRepository
+import org.springframework.data.jpa.repository.Modifying
+import org.springframework.data.jpa.repository.Query
+
+interface WalletRepository : JpaRepository<Wallet, Long> {
+    fun findByMemberId(memberId: Long): Wallet?
+
+    // 행 락을 잡는 no-op 갱신. 항상 회원 id 오름차순으로 호출해 교착을 막는다.
+    @Modifying
+    @Query("update Wallet w set w.balance = w.balance where w.memberId = :memberId")
+    fun lockRow(memberId: Long): Int
+
+    @Modifying
+    @Query("update Wallet w set w.balance = w.balance + :amount where w.memberId = :memberId and w.balance <= :maxBefore")
+    fun credit(memberId: Long, amount: Long, maxBefore: Long): Int
+
+    @Modifying
+    @Query("update Wallet w set w.balance = w.balance - :amount where w.memberId = :memberId and w.balance >= :amount")
+    fun debit(memberId: Long, amount: Long): Int
+}
diff --git a/src/main/kotlin/com/rest1/domain/wallet/service/WalletService.kt b/src/main/kotlin/com/rest1/domain/wallet/service/WalletService.kt
