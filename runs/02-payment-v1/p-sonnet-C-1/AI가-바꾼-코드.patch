@@ -0,0 +1,92 @@
+package com.rest1.domain.wallet.service
+
+import com.rest1.domain.post.post.entity.Post
+import com.rest1.domain.wallet.entity.Purchase
+import com.rest1.domain.wallet.entity.Wallet
+import com.rest1.domain.wallet.repository.PurchaseRepository
+import com.rest1.domain.wallet.repository.WalletRepository
+import com.rest1.global.exception.ServiceException
+import org.springframework.dao.DataIntegrityViolationException
+import org.springframework.stereotype.Service
+import org.springframework.transaction.PlatformTransactionManager
+import org.springframework.transaction.support.TransactionTemplate
+
+/**
+ * 동시성 전략: 잔액 변경은 읽고-쓰기가 아니라 DB 의 원자적 UPDATE(balance = balance +/- x)로만 한다.
+ * 구매는 한 트랜잭션에서 지갑 행을 id 오름차순으로 먼저 잠가(교착 방지) 검사·차감·지급·구매기록을 처리한다.
+ * 중복 구매는 Purchase 유니크 제약이 최종적으로 막는다.
+ * 트랜잭션은 TransactionTemplate 으로 직접 경계를 잡는다(중첩 커넥션 사용을 피하려고 순서대로 실행).
+ */
+@Service
+class WalletService(
+    private val walletRepository: WalletRepository,
+    private val purchaseRepository: PurchaseRepository,
+    txManager: PlatformTransactionManager,
+) {
+    private val tx = TransactionTemplate(txManager)
+
+    private fun ensureWallet(memberId: Long) {
+        if (tx.execute { walletRepository.findByMemberId(memberId) } != null) return
+        try {
+            tx.execute { walletRepository.saveAndFlush(Wallet(memberId)) }
+        } catch (e: DataIntegrityViolationException) {
+            // 동시에 다른 요청이 먼저 만들었다. 정상.
+        }
+    }
+
+    fun balanceOf(memberId: Long): Long =
+        tx.execute { walletRepository.findByMemberId(memberId)?.balance } ?: 0L
+
+    fun charge(memberId: Long, amount: Long): Long {
+        if (amount < 1) throw ServiceException("400-3", "충전 금액은 1 이상이어야 합니다.")
+        ensureWallet(memberId)
+        return tx.execute {
+            credit(memberId, amount)
+            walletRepository.findByMemberId(memberId)!!.balance
+        }!!
+    }
+
+    fun purchase(buyerId: Long, post: Post) {
+        val postId = post.id!!
+        val authorId = post.author.id!!
+        val price = post.price
+        if (price <= 0) throw ServiceException("400-4", "무료 글은 구매할 수 없습니다.")
+        if (authorId == buyerId) throw ServiceException("403-4", "자기 글은 구매할 수 없습니다.")
+
+        ensureWallet(buyerId)
+        ensureWallet(authorId)
+
+        try {
+            tx.execute {
+                // 두 지갑 행을 id 순서로 잠근다. 같은 구매자의 동시 요청은 여기서 직렬화된다.
+                listOf(buyerId, authorId).sorted().forEach { walletRepository.lockRow(it) }
+
+                if (purchaseRepository.existsByBuyerIdAndPostId(buyerId, postId)) {
+                    throw ServiceException("409-2", "이미 구매한 글입니다.")
+                }
+                // 잔액 >= 가격 조건이 붙은 원자적 차감. 0행이면 잔액 부족.
+                if (walletRepository.debit(buyerId, price) != 1) {
+                    throw ServiceException("400-5", "잔액이 부족합니다.")
+                }
+                credit(authorId, price)
+                purchaseRepository.saveAndFlush(Purchase(buyerId, postId, price))
+            }
+        } catch (e: DataIntegrityViolationException) {
+            // 유니크 제약 위반 = 동시에 같은 글을 샀다. 트랜잭션은 롤백되어 돈은 빠지지 않았다.
+            throw ServiceException("409-2", "이미 구매한 글입니다.")
+        }
+    }
+
+    private fun credit(memberId: Long, amount: Long) {
+        // balance + amount 가 Long 범위를 넘지 않을 때만 반영
+        if (walletRepository.credit(memberId, amount, Long.MAX_VALUE - amount) != 1) {
+            throw ServiceException("400-6", "잔액 한도를 초과합니다.")
+        }
+    }
+
+    fun hasPurchased(buyerId: Long, postId: Long): Boolean =
+        purchaseRepository.existsByBuyerIdAndPostId(buyerId, postId)
+
+    fun purchasedPostIds(buyerId: Long, postIds: Collection<Long>): Set<Long> =
+        if (postIds.isEmpty()) emptySet() else purchaseRepository.findPurchasedPostIds(buyerId, postIds).toSet()
+}
