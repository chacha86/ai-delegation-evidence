+package com.rest1.domain.post.purchase.service
+
+import com.rest1.domain.member.member.repository.MemberRepository
+import com.rest1.domain.post.post.repository.PostRepository
+import com.rest1.domain.post.post.service.PostService
+import com.rest1.domain.post.purchase.repository.PostPurchaseRepository
+import com.rest1.domain.wallet.wallet.repository.WalletRepository
+import com.rest1.domain.wallet.wallet.service.WalletService
+import com.rest1.global.exception.ServiceException
+import org.assertj.core.api.Assertions.assertThat
+import org.junit.jupiter.api.AfterEach
+import org.junit.jupiter.api.DisplayName
+import org.junit.jupiter.api.Test
+import org.springframework.beans.factory.annotation.Autowired
+import org.springframework.boot.test.context.SpringBootTest
+import org.springframework.test.context.ActiveProfiles
+import org.springframework.transaction.support.TransactionTemplate
+import java.util.Collections
+import java.util.concurrent.CountDownLatch
+import java.util.concurrent.Executors
+import java.util.concurrent.TimeUnit
+import java.util.concurrent.atomic.AtomicInteger
+
+// 실제 커밋이 일어나야 잠금을 검증할 수 있으므로 클래스에 @Transactional 을 붙이지 않는다.
+// 다른 테스트에 영향이 없도록 만든 데이터(구매, 글, 지갑)는 @AfterEach 에서 지운다.
+@SpringBootTest
+@ActiveProfiles("test")
+class PaymentConcurrencyTest {
+    @Autowired private lateinit var walletService: WalletService
+    @Autowired private lateinit var postPurchaseService: PostPurchaseService
+    @Autowired private lateinit var postService: PostService
+    @Autowired private lateinit var memberRepository: MemberRepository
+    @Autowired private lateinit var postRepository: PostRepository
+    @Autowired private lateinit var walletRepository: WalletRepository
+    @Autowired private lateinit var postPurchaseRepository: PostPurchaseRepository
+    @Autowired private lateinit var tx: TransactionTemplate
+
+    private val createdPostIds = mutableListOf<Long>()
+
+    @AfterEach
+    fun cleanUp() {
+        tx.executeWithoutResult {
+            postPurchaseRepository.deleteAll()
+            createdPostIds.forEach { postRepository.deleteById(it) }
+            walletRepository.deleteAll()
+        }
+        createdPostIds.clear()
+    }
+
+    private fun memberId(username: String): Long = memberRepository.findByUsername(username).get().id!!
+
+    private fun runConcurrently(threads: Int, task: () -> Unit): List<Throwable> {
+        val pool = Executors.newFixedThreadPool(threads)
+        val start = CountDownLatch(1)
+        val errors = Collections.synchronizedList(mutableListOf<Throwable>())
+        repeat(threads) {
+            pool.submit {
+                start.await()
+                try {
+                    task()
+                } catch (e: Throwable) {
+                    errors.add(e)
+                }
+            }
+        }
+        start.countDown()
+        pool.shutdown()
+        assertThat(pool.awaitTermination(60, TimeUnit.SECONDS)).isTrue()
+        return errors
+    }
+
+    @Test
+    @DisplayName("지갑이 없는 회원에게 동시에 충전해도 지갑은 하나, 금액은 모두 반영된다")
+    fun concurrentCharge() {
+        val user2Id = memberId("user2")
+
+        val errors = runConcurrently(8) { walletService.charge(user2Id, 100) }
+
+        assertThat(errors).isEmpty()
+        assertThat(walletService.findBalance(user2Id)).isEqualTo(800)
+        assertThat(walletRepository.findAll().count { it.member.id == user2Id }).isEqualTo(1)
+    }
+
+    @Test
+    @DisplayName("같은 회원이 같은 글을 동시에 여러 번 구매해도 한 번만 결제된다")
+    fun concurrentDuplicatePurchase() {
+        val user1Id = memberId("user1")
+        val user3Id = memberId("user3")
+        val postId = tx.execute {
+            val author = memberRepository.findById(user1Id).get()
+            postService.write(author, "동시성", "동시성 본문", 300).id!!
+        }!!
+        createdPostIds.add(postId)
+        walletService.charge(user3Id, 10_000)
+
+        val success = AtomicInteger()
+        val errors = runConcurrently(8) {
+            postPurchaseService.purchase(user3Id, postId)
+            success.incrementAndGet()
+        }
+
+        assertThat(success.get()).isEqualTo(1)
+        assertThat(errors).hasSize(7)
+        assertThat(errors).allSatisfy {
+            assertThat(it).isInstanceOf(ServiceException::class.java)
+            assertThat((it as ServiceException).resultCode).isEqualTo("409-2")
+        }
+        assertThat(walletService.findBalance(user3Id)).isEqualTo(9_700)
+        assertThat(walletService.findBalance(user1Id)).isEqualTo(300)
+        assertThat(postPurchaseRepository.count()).isEqualTo(1)
+    }
+
+    @Test
+    @DisplayName("잔액이 1건 값뿐일 때 서로 다른 글 두 개를 동시에 사도 잔액이 음수가 되지 않는다")
+    fun concurrentPurchaseOverdraft() {
+        val user1Id = memberId("user1")
+        val user2Id = memberId("user2")
+        val user3Id = memberId("user3")
+        val postIds = tx.execute {
+            listOf(
+                postService.write(memberRepository.findById(user1Id).get(), "글A", "본문A", 500).id!!,
+                postService.write(memberRepository.findById(user2Id).get(), "글B", "본문B", 500).id!!,
+            )
+        }!!
+        createdPostIds.addAll(postIds)
+        walletService.charge(user3Id, 500)
+
+        val index = AtomicInteger()
+        val success = AtomicInteger()
+        val errors = runConcurrently(2) {
+            postPurchaseService.purchase(user3Id, postIds[index.getAndIncrement()])
+            success.incrementAndGet()
+        }
+
+        assertThat(success.get()).isEqualTo(1)
+        assertThat(errors).hasSize(1)
+        assertThat((errors[0] as ServiceException).resultCode).isEqualTo("400-5")
+        assertThat(walletService.findBalance(user3Id)).isEqualTo(0)
+        assertThat(walletService.findBalance(user1Id) + walletService.findBalance(user2Id)).isEqualTo(500)
+    }
+}
