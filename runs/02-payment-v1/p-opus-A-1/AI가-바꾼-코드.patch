+package com.rest1.domain.post.purchase.service
+
+import com.rest1.domain.member.member.entity.Member
+import com.rest1.domain.post.post.entity.Post
+import com.rest1.domain.post.post.repository.PostRepository
+import com.rest1.domain.post.purchase.entity.PostPurchase
+import com.rest1.domain.post.purchase.repository.PostPurchaseRepository
+import com.rest1.domain.wallet.wallet.service.WalletService
+import com.rest1.global.exception.ServiceException
+import org.springframework.data.repository.findByIdOrNull
+import org.springframework.stereotype.Service
+import org.springframework.transaction.annotation.Transactional
+
+@Service
+class PostPurchaseService(
+    private val postRepository: PostRepository,
+    private val postPurchaseRepository: PostPurchaseRepository,
+    private val walletService: WalletService,
+) {
+    data class PurchaseResult(
+        val purchase: PostPurchase,
+        val buyerBalance: Long,
+    )
+
+    @Transactional
+    fun purchase(buyerId: Long, postId: Long): PurchaseResult {
+        val post = postRepository.findByIdOrNull(postId) ?: throw NoSuchElementException()
+
+        if (!post.isPaid) {
+            throw ServiceException("400-3", "무료 글은 구매할 필요가 없습니다.")
+        }
+
+        val authorId = post.author.id!!
+
+        if (authorId == buyerId) {
+            throw ServiceException("400-4", "자신의 글은 구매할 수 없습니다.")
+        }
+
+        // 구매자·작성자 지갑을 항상 회원 id 오름차순으로 잠가 교착(deadlock)을 피한다
+        val wallets = listOf(buyerId, authorId)
+            .sorted()
+            .associateWith { walletService.lockWallet(it) }
+
+        // 구매자 행을 잠근 뒤에 확인하므로, 같은 구매자의 동시 중복 구매는 여기서 걸러진다
+        if (postPurchaseRepository.existsByBuyerIdAndPostId(buyerId, postId)) {
+            throw ServiceException("409-2", "이미 구매한 글입니다.")
+        }
+
+        val buyerWallet = wallets.getValue(buyerId)
+        val authorWallet = wallets.getValue(authorId)
+        val price = post.price
+
+        buyerWallet.withdraw(price) // 잔액 부족 시 400-5, 트랜잭션 전체 롤백
+        authorWallet.deposit(price) // 판매 대금은 작성자 지갑으로
+
+        val purchase = postPurchaseRepository.save(PostPurchase(buyerWallet.member, post, price))
+
+        return PurchaseResult(purchase, buyerWallet.balance)
+    }
+
+    // 무료 글은 누구나, 유료 글은 작성자·관리자·구매자만 본문을 열람할 수 있다
+    @Transactional(readOnly = true)
+    fun canReadContent(actor: Member?, post: Post): Boolean {
+        if (!post.isPaid) return true
+        if (actor == null) return false
+        if (post.isAuthor(actor) || actor.isAdmin) return true
+
+        return postPurchaseRepository.existsByBuyerIdAndPostId(actor.id!!, post.id!!)
+    }
+
+    @Transactional(readOnly = true)
+    fun hasPurchases(post: Post): Boolean = postPurchaseRepository.existsByPostId(post.id!!)
+}
