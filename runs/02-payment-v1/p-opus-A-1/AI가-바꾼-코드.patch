+package com.rest1.domain.wallet.wallet.service
+
+import com.rest1.domain.member.member.repository.MemberRepository
+import com.rest1.domain.wallet.wallet.entity.Wallet
+import com.rest1.domain.wallet.wallet.repository.WalletRepository
+import com.rest1.global.exception.ServiceException
+import org.springframework.stereotype.Service
+import org.springframework.transaction.annotation.Propagation
+import org.springframework.transaction.annotation.Transactional
+
+@Service
+class WalletService(
+    private val memberRepository: MemberRepository,
+    private val walletRepository: WalletRepository,
+) {
+    companion object {
+        // 1회 충전 한도 (요청 검증에서도 같은 값을 쓴다)
+        const val MAX_CHARGE_AMOUNT = 1_000_000L
+
+        // 보유 가능 잔액 한도 (충전으로 이 값을 넘길 수 없다)
+        const val MAX_BALANCE = 1_000_000_000L
+    }
+
+    // 지갑이 아직 없으면(한 번도 충전/판매하지 않은 회원) 잔액 0 으로 본다. 조회만으로는 지갑을 만들지 않는다.
+    @Transactional(readOnly = true)
+    fun findBalance(memberId: Long): Long = walletRepository.findByMemberId(memberId)?.balance ?: 0L
+
+    @Transactional
+    fun charge(memberId: Long, amount: Long): Wallet {
+        if (amount <= 0 || amount > MAX_CHARGE_AMOUNT) {
+            throw ServiceException("400-6", "충전 금액은 1 이상 ${MAX_CHARGE_AMOUNT} 이하여야 합니다.")
+        }
+
+        val wallet = lockWallet(memberId)
+
+        if (wallet.balance > MAX_BALANCE - amount) {
+            throw ServiceException("400-7", "잔액은 ${MAX_BALANCE} 를 넘을 수 없습니다.")
+        }
+
+        wallet.deposit(amount)
+
+        return wallet
+    }
+
+    /**
+     * 회원 행을 SELECT ... FOR UPDATE 로 잠근 뒤 지갑을 돌려준다(없으면 만든다).
+     * 같은 회원의 지갑 생성·잔액 변경이 동시에 일어나도 순서대로 처리되도록 하기 위함.
+     * 반드시 쓰기 트랜잭션 안에서 호출해야 한다.
+     */
+    @Transactional(propagation = Propagation.MANDATORY)
+    fun lockWallet(memberId: Long): Wallet {
+        val member = memberRepository.findByIdForUpdate(memberId) ?: throw NoSuchElementException()
+
+        return walletRepository.findByMemberId(memberId)
+            ?: walletRepository.save(Wallet(member))
+    }
+}
