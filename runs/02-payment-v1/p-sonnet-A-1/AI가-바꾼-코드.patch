+package com.rest1.domain.post.post.service
+
+import com.rest1.domain.post.post.entity.Post
+import com.rest1.domain.post.post.entity.PostPurchase
+import com.rest1.domain.post.post.repository.PostPurchaseRepository
+import com.rest1.domain.wallet.wallet.service.WalletService
+import com.rest1.global.exception.ServiceException
+import org.springframework.stereotype.Service
+import org.springframework.transaction.annotation.Transactional
+
+@Service
+class PostPurchaseService(
+    private val walletService: WalletService,
+    private val purchaseRepository: PostPurchaseRepository,
+) {
+    // 구매: 구매자 지갑에서 차감, 작성자 지갑에 입금, 구매 기록. 한 트랜잭션(실패 시 전부 롤백).
+    // 반환: 구매 후 구매자 잔액
+    @Transactional
+    fun purchase(buyerId: Long, post: Post): Long {
+        val price = post.price
+        val authorId = post.author.id!!
+
+        if (price <= 0) throw ServiceException("400-5", "무료 글은 구매할 수 없습니다.")
+        if (authorId == buyerId) throw ServiceException("400-7", "자신의 글은 구매할 수 없습니다.")
+
+        // 지갑 잠금 이후에 중복 검사를 해야 같은 회원의 동시 요청이 직렬화된다
+        val (buyer, seller) = walletService.lockPair(buyerId, authorId)
+
+        if (purchaseRepository.existsByBuyerIdAndPostId(buyerId, post.id!!)) {
+            throw ServiceException("409-2", "이미 구매한 글입니다.")
+        }
+
+        buyer.withdraw(price)
+        seller.deposit(price)
+        purchaseRepository.save(PostPurchase(buyerId, post.id!!, price))
+
+        return buyer.balance
+    }
+
+    fun canRead(memberId: Long, post: Post): Boolean =
+        post.price <= 0 ||
+            post.author.id == memberId ||
+            purchaseRepository.existsByBuyerIdAndPostId(memberId, post.id!!)
+}
