+package com.rest1.global.exception
+
+const val MAX_MONEY = 100_000_000L
+
+// JSON 숫자를 정수로만 받는다. 1.5, 1e3, 범위 초과 정수는 400 (Jackson 기본은 1.5 를 1 로 잘라버린다)
+fun Number.toStrictLong(field: String): Long {
+    val ok = this is Int || this is Long || this is Short || this is Byte
+    if (!ok) throw ServiceException("400-4", "$field 은(는) 정수여야 합니다.")
+    return this.toLong()
+}
