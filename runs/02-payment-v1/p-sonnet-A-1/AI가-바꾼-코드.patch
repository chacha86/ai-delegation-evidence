+package com.rest1.domain.wallet.wallet.service
+
+import com.rest1.domain.wallet.wallet.entity.Wallet
+import com.rest1.domain.wallet.wallet.repository.WalletRepository
+import org.springframework.stereotype.Service
+import org.springframework.transaction.annotation.Transactional
+
+@Service
+class WalletService(
+    private val walletRepository: WalletRepository,
+) {
+    fun createFor(memberId: Long) {
+        walletRepository.save(Wallet(memberId))
+    }
+
+    // 지갑 행을 잠그고 가져온다. 없으면(지갑 도입 전에 가입한 기존 회원) 0원 지갑을 만든다.
+    @Transactional
+    fun lock(memberId: Long): Wallet {
+        if (!walletRepository.existsByMemberId(memberId)) {
+            walletRepository.saveAndFlush(Wallet(memberId))
+        }
+        return walletRepository.findForUpdate(memberId)!!
+    }
+
+    @Transactional
+    fun balance(memberId: Long): Long = lock(memberId).balance
+
+    @Transactional
+    fun charge(memberId: Long, amount: Long): Long {
+        val wallet = lock(memberId)
+        wallet.deposit(amount)
+        return wallet.balance
+    }
+
+    // 교차 구매 시 교착을 막기 위해 id 오름차순으로 잠근다. 반환: (구매자 지갑, 판매자 지갑)
+    @Transactional
+    fun lockPair(buyerId: Long, sellerId: Long): Pair<Wallet, Wallet> {
+        if (buyerId == sellerId) {
+            val w = lock(buyerId)
+            return w to w
+        }
+        return if (buyerId < sellerId) {
+            val b = lock(buyerId)
+            b to lock(sellerId)
+        } else {
+            val s = lock(sellerId)
+            lock(buyerId) to s
+        }
+    }
+}
