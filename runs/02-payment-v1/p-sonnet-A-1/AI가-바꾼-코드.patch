+package com.rest1.domain.wallet.wallet.controller
+
+import com.rest1.domain.wallet.wallet.service.WalletService
+import com.rest1.global.exception.MAX_MONEY
+import com.rest1.global.exception.ServiceException
+import com.rest1.global.exception.toStrictLong
+import com.rest1.global.rq.Rq
+import com.rest1.global.rsData.RsData
+import io.swagger.v3.oas.annotations.Operation
+import io.swagger.v3.oas.annotations.security.SecurityRequirement
+import io.swagger.v3.oas.annotations.tags.Tag
+import org.springframework.web.bind.annotation.GetMapping
+import org.springframework.web.bind.annotation.PostMapping
+import org.springframework.web.bind.annotation.RequestBody
+import org.springframework.web.bind.annotation.RequestMapping
+import org.springframework.web.bind.annotation.RestController
+
+@RestController
+@RequestMapping("/api/v1/wallet")
+@Tag(name = "ApiV1WalletController", description = "지갑 API")
+@SecurityRequirement(name = "bearerAuth")
+class ApiV1WalletController(
+    private val walletService: WalletService,
+    private val rq: Rq,
+) {
+    data class WalletDto(val balance: Long)
+
+    @GetMapping
+    @Operation(summary = "잔액 조회")
+    fun getBalance(): WalletDto = WalletDto(walletService.balance(rq.actor.id!!))
+
+    data class ChargeReqBody(val amount: Number?)
+
+    @PostMapping("/charge")
+    @Operation(summary = "충전")
+    fun charge(@RequestBody reqBody: ChargeReqBody): RsData<WalletDto> {
+        val amount = reqBody.amount?.toStrictLong("amount")
+            ?: throw ServiceException("400-1", "amount-NotNull-필수 입력값입니다.")
+        if (amount < 1 || amount > MAX_MONEY) {
+            throw ServiceException("400-1", "amount-Range-1 이상 $MAX_MONEY 이하여야 합니다.")
+        }
+
+        val balance = walletService.charge(rq.actor.id!!, amount)
+
+        return RsData("200-1", "${amount}원이 충전되었습니다.", WalletDto(balance))
+    }
+}
