+package com.rest1.domain.post.purchase.service
+
+import com.rest1.domain.member.member.entity.Member
+import com.rest1.domain.post.post.entity.Post
+import com.rest1.domain.post.purchase.entity.PostPurchase
+import com.rest1.domain.post.purchase.repository.PostPurchaseRepository
+import com.rest1.domain.wallet.service.WalletService
+import com.rest1.global.exception.ServiceException
+import org.springframework.stereotype.Service
+import org.springframework.transaction.annotation.Transactional
+
+@Service
+class PostPurchaseService(
+    private val postPurchaseRepository: PostPurchaseRepository,
+    private val walletService: WalletService,
+) {
+    // 구매자의 지갑 행을 잠근 뒤 중복 구매와 잔액을 확인한다. 같은 회원의 동시 구매는 한 건씩 처리된다.
+    // 구매 금액은 판매자에게 입금하지 않는다(요구사항에 없음).
+    @Transactional
+    fun purchase(buyer: Member, post: Post): Long {
+        if (!post.isPaid) {
+            throw ServiceException("400-3", "무료 글은 구매할 수 없습니다.")
+        }
+
+        if (post.author.id == buyer.id) {
+            throw ServiceException("400-5", "본인이 작성한 글은 구매할 수 없습니다.")
+        }
+
+        val wallet = walletService.findForUpdate(buyer)
+
+        if (postPurchaseRepository.existsByMemberIdAndPostId(buyer.id!!, post.id!!)) {
+            throw ServiceException("409-1", "이미 구매한 글입니다.")
+        }
+
+        wallet.withdraw(post.price)
+        postPurchaseRepository.save(PostPurchase(buyer, post))
+
+        return wallet.balance
+    }
+
+    // 무료 글은 누구나, 유료 글은 작성자와 구매한 회원만 본문을 볼 수 있다
+    @Transactional(readOnly = true)
+    fun canRead(member: Member?, post: Post): Boolean {
+        if (!post.isPaid) return true
+        if (member == null) return false
+        if (post.author.id == member.id) return true
+
+        return postPurchaseRepository.existsByMemberIdAndPostId(member.id!!, post.id!!)
+    }
+}
