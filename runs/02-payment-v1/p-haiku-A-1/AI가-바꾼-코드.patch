+package com.rest1.domain.wallet.service
+
+import com.rest1.domain.member.member.entity.Member
+import com.rest1.domain.wallet.entity.Wallet
+import com.rest1.domain.wallet.repository.WalletRepository
+import org.springframework.stereotype.Service
+import org.springframework.transaction.annotation.Transactional
+
+@Service
+class WalletService(
+    private val walletRepository: WalletRepository,
+) {
+    // 지갑이 없는 회원(지갑 기능 도입 전 가입자)은 처음 접근할 때 만든다
+    @Transactional
+    fun findForUpdate(member: Member): Wallet {
+        return walletRepository.findByMemberIdForUpdate(member.id!!)
+            ?: walletRepository.save(Wallet(member))
+    }
+
+    @Transactional(readOnly = true)
+    fun balanceOf(member: Member): Long {
+        return walletRepository.findByMemberId(member.id!!)?.balance ?: 0
+    }
+
+    @Transactional
+    fun charge(member: Member, amount: Long): Long {
+        val wallet = findForUpdate(member)
+        wallet.charge(amount)
+
+        return wallet.balance
+    }
+}
