+package com.rest1.domain.wallet.controller
+
+import com.rest1.domain.wallet.service.WalletService
+import com.rest1.global.rq.Rq
+import com.rest1.global.rsData.RsData
+import io.swagger.v3.oas.annotations.Operation
+import io.swagger.v3.oas.annotations.security.SecurityRequirement
+import io.swagger.v3.oas.annotations.tags.Tag
+import jakarta.validation.Valid
+import jakarta.validation.constraints.Min
+import jakarta.validation.constraints.NotNull
+import org.springframework.transaction.annotation.Transactional
+import org.springframework.web.bind.annotation.GetMapping
+import org.springframework.web.bind.annotation.PostMapping
+import org.springframework.web.bind.annotation.RequestBody
+import org.springframework.web.bind.annotation.RequestMapping
+import org.springframework.web.bind.annotation.RestController
+
+@RestController
+@RequestMapping("/api/v1/wallet")
+@Tag(name = "ApiV1WalletController", description = "지갑 API")
+@SecurityRequirement(name = "bearerAuth")
+class ApiV1WalletController(
+    private val walletService: WalletService,
+    private val rq: Rq,
+) {
+    data class WalletResBody(
+        val balance: Long,
+    )
+
+    @GetMapping
+    @Transactional(readOnly = true)
+    @Operation(summary = "내 지갑 잔액 조회")
+    fun getWallet(): WalletResBody {
+        return WalletResBody(walletService.balanceOf(rq.actor))
+    }
+
+    // 실제 결제 연동 없이 잔액만 늘리는 충전이다
+    data class ChargeReqBody(
+        @field:NotNull
+        @field:Min(1)
+        val amount: Long?,
+    )
+
+    data class ChargeResBody(
+        val balance: Long,
+    )
+
+    @PostMapping("/charge")
+    @Transactional
+    @Operation(summary = "지갑 충전")
+    fun charge(
+        @RequestBody @Valid reqBody: ChargeReqBody,
+    ): RsData<ChargeResBody> {
+        val balance = walletService.charge(rq.actor, reqBody.amount!!)
+
+        return RsData(
+            "200-1",
+            "${reqBody.amount}원이 충전되었습니다.",
+            ChargeResBody(balance),
+        )
+    }
+}
