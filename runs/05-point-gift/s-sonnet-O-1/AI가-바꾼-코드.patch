+package com.rest1.domain.point.point.repository
+
+import com.rest1.domain.point.point.entity.PointTransfer
+import org.springframework.data.jpa.repository.JpaRepository
+import org.springframework.data.jpa.repository.Query
+import java.time.LocalDateTime
+
+interface PointTransferRepository : JpaRepository<PointTransfer, Long> {
+    @Query(
+        "select coalesce(sum(t.amount), 0) from PointTransfer t " +
+                "where t.fromMemberId = :memberId and t.transferDate >= :start and t.transferDate < :end"
+    )
+    fun sumAmount(memberId: Long, start: LocalDateTime, end: LocalDateTime): Long
+}
