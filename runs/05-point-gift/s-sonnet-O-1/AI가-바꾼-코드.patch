+package com.rest1.domain.point.point.entity
+
+import com.rest1.global.jpa.entity.BaseEntity
+import jakarta.persistence.Column
+import jakarta.persistence.Entity
+import jakarta.persistence.Index
+import jakarta.persistence.Table
+import java.time.LocalDateTime
+
+// 포인트 선물 내역. 1일 한도 계산과 감사 용도.
+@Entity
+@Table(indexes = [Index(columnList = "fromMemberId, transferDate")])
+class PointTransfer(
+    @Column(nullable = false) val fromMemberId: Long,
+    @Column(nullable = false) val toMemberId: Long,
+    @Column(nullable = false) val amount: Long,
+    @Column(nullable = false) val fee: Long,
+    @Column(nullable = false) val transferDate: LocalDateTime,
+) : BaseEntity()
