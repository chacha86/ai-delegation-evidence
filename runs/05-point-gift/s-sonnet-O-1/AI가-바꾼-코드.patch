+package com.rest1.domain.point.point.controller
+
+import com.rest1.domain.point.point.service.PointService
+import com.rest1.global.rq.Rq
+import com.rest1.global.rsData.RsData
+import jakarta.validation.Valid
+import jakarta.validation.constraints.NotBlank
+import jakarta.validation.constraints.NotNull
+import org.springframework.web.bind.annotation.GetMapping
+import org.springframework.web.bind.annotation.PostMapping
+import org.springframework.web.bind.annotation.RequestBody
+import org.springframework.web.bind.annotation.RequestMapping
+import org.springframework.web.bind.annotation.RestController
+
+@RestController
+@RequestMapping("/api/v1/points")
+class ApiV1PointController(
+    private val pointService: PointService,
+    private val rq: Rq,
+) {
+    data class BalanceResBody(val balance: Long)
+
+    // 기획서: 응답 JSON 최상위에 balance 필드가 있어야 하므로 RsData 로 감싸지 않는다
+    @GetMapping
+    fun balance(): BalanceResBody = BalanceResBody(pointService.balance(rq.actor.id!!))
+
+    data class ChargeReqBody(
+        @field:NotNull val amount: Long?,
+    )
+
+    @PostMapping("/charge")
+    fun charge(@RequestBody @Valid reqBody: ChargeReqBody): RsData<BalanceResBody> {
+        val balance = pointService.charge(rq.actor.id!!, reqBody.amount!!)
+
+        return RsData("200-2", "${reqBody.amount}P 가 충전되었습니다.", BalanceResBody(balance))
+    }
+
+    data class TransferReqBody(
+        @field:NotBlank val toUsername: String?,
+        @field:NotNull val amount: Long?,
+    )
+
+    data class TransferResBody(val amount: Long, val fee: Long, val balance: Long)
+
+    @PostMapping("/transfer")
+    fun transfer(@RequestBody @Valid reqBody: TransferReqBody): RsData<TransferResBody> {
+        val r = pointService.transfer(rq.actor.id!!, reqBody.toUsername!!, reqBody.amount!!)
+
+        return RsData("200-3", "포인트를 선물했습니다.", TransferResBody(r.amount, r.fee, r.balance))
+    }
+}
