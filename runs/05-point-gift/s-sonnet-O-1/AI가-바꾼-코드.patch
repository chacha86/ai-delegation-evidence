+package com.rest1.domain.point.point.service
+
+import com.rest1.domain.member.member.entity.Member
+import com.rest1.domain.member.member.repository.MemberRepository
+import com.rest1.domain.point.point.entity.PointTransfer
+import com.rest1.domain.point.point.repository.PointTransferRepository
+import com.rest1.global.exception.ServiceException
+import org.springframework.stereotype.Service
+import org.springframework.transaction.annotation.Transactional
+import java.time.LocalDate
+import java.time.LocalDateTime
+
+@Service
+class PointService(
+    private val memberRepository: MemberRepository,
+    private val pointTransferRepository: PointTransferRepository,
+) {
+    companion object {
+        const val MIN_TRANSFER_AMOUNT = 1_000L
+        const val DAILY_TRANSFER_LIMIT = 10_000_000L
+        const val MAX_CHARGE_AMOUNT = 100_000_000L
+
+        // 수수료: 1만P 까지 500P, 10만P 까지 1,000P, 그 이상은 0.1% (최대 5,000P), 10P 미만 절사
+        fun calcFee(amount: Long): Long = when {
+            amount <= 10_000 -> 500
+            amount <= 100_000 -> 1_000
+            else -> minOf(amount / 10_000 * 10, 5_000L)
+        }
+    }
+
+    @Transactional
+    fun charge(memberId: Long, amount: Long): Long {
+        if (amount <= 0 || amount > MAX_CHARGE_AMOUNT) {
+            throw ServiceException("400-3", "충전 금액은 1P 이상 ${MAX_CHARGE_AMOUNT}P 이하여야 합니다.")
+        }
+
+        val member = lock(memberId)
+        member.increasePoint(amount)
+
+        return member.point
+    }
+
+    @Transactional(readOnly = true)
+    fun balance(memberId: Long): Long =
+        memberRepository.findById(memberId).orElseThrow { ServiceException("404-1", "존재하지 않는 회원입니다.") }.point
+
+    data class TransferResult(val amount: Long, val fee: Long, val balance: Long)
+
+    @Transactional
+    fun transfer(fromId: Long, toUsername: String, amount: Long): TransferResult {
+        if (amount < MIN_TRANSFER_AMOUNT) {
+            throw ServiceException("400-4", "최소 선물 금액은 ${MIN_TRANSFER_AMOUNT}P 입니다.")
+        }
+
+        val toId = memberRepository.findByUsername(toUsername).orElse(null)?.id
+            ?: throw ServiceException("404-2", "받는 회원을 찾을 수 없습니다.")
+
+        if (toId == fromId) {
+            throw ServiceException("400-5", "자기 자신에게는 선물할 수 없습니다.")
+        }
+
+        // 데드락 방지를 위해 id 오름차순으로 락을 잡는다
+        val locked = listOf(fromId, toId).sorted().associateWith { lock(it) }
+        val from = locked.getValue(fromId)
+        val to = locked.getValue(toId)
+
+        val today = LocalDate.now()
+        val sentToday = pointTransferRepository.sumAmount(fromId, today.atStartOfDay(), today.plusDays(1).atStartOfDay())
+        if (sentToday + amount > DAILY_TRANSFER_LIMIT) {
+            throw ServiceException("400-6", "1일 선물 한도(${DAILY_TRANSFER_LIMIT}P)를 초과했습니다.")
+        }
+
+        val fee = calcFee(amount)
+        if (from.point < amount + fee) {
+            throw ServiceException("400-7", "포인트 잔액이 부족합니다.")
+        }
+
+        from.decreasePoint(amount + fee)
+        to.increasePoint(amount)
+        pointTransferRepository.save(PointTransfer(fromId, toId, amount, fee, LocalDateTime.now()))
+
+        return TransferResult(amount, fee, from.point)
+    }
+
+    private fun lock(memberId: Long): Member =
+        memberRepository.findByIdForUpdate(memberId)
+            ?: throw ServiceException("404-1", "존재하지 않는 회원입니다.")
+}
