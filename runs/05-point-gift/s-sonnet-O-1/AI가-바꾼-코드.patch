+package com.rest1.domain.point.point.controller
+
+import com.rest1.domain.point.point.service.PointService
+import org.junit.jupiter.api.Assertions.assertEquals
+import org.junit.jupiter.api.DisplayName
+import org.junit.jupiter.api.Test
+import org.springframework.beans.factory.annotation.Autowired
+import org.springframework.boot.test.autoconfigure.web.servlet.AutoConfigureMockMvc
+import org.springframework.boot.test.context.SpringBootTest
+import org.springframework.http.MediaType
+import org.springframework.test.context.ActiveProfiles
+import org.springframework.test.web.servlet.MockMvc
+import org.springframework.test.web.servlet.request.MockMvcRequestBuilders.get
+import org.springframework.test.web.servlet.request.MockMvcRequestBuilders.post
+import org.springframework.test.web.servlet.result.MockMvcResultMatchers.jsonPath
+import org.springframework.test.web.servlet.result.MockMvcResultMatchers.status
+import org.springframework.transaction.annotation.Transactional
+
+@SpringBootTest
+@ActiveProfiles("test")
+@AutoConfigureMockMvc
+@Transactional
+class ApiV1PointControllerTest {
+    @Autowired
+    private lateinit var mvc: MockMvc
+
+    private fun charge(user: String, amount: Long) = mvc.perform(
+        post("/api/v1/points/charge").header("Authorization", "Bearer $user")
+            .contentType(MediaType.APPLICATION_JSON).content("""{"amount": $amount}""")
+    )
+
+    private fun transfer(user: String, to: String, amount: Long) = mvc.perform(
+        post("/api/v1/points/transfer").header("Authorization", "Bearer $user")
+            .contentType(MediaType.APPLICATION_JSON).content("""{"toUsername": "$to", "amount": $amount}""")
+    )
+
+    private fun balance(user: String) = mvc.perform(
+        get("/api/v1/points").header("Authorization", "Bearer $user")
+    )
+
+    @Test
+    @DisplayName("수수료 계산")
+    fun fee() {
+        assertEquals(500, PointService.calcFee(1_000))
+        assertEquals(500, PointService.calcFee(10_000))
+        assertEquals(1_000, PointService.calcFee(10_001))
+        assertEquals(1_000, PointService.calcFee(100_000))
+        assertEquals(100, PointService.calcFee(100_001))
+        assertEquals(1_230, PointService.calcFee(1_234_567))
+        assertEquals(5_000, PointService.calcFee(5_000_000))
+        assertEquals(5_000, PointService.calcFee(9_999_999))
+    }
+
+    @Test
+    @DisplayName("충전, 선물, 잔액 조회")
+    fun flow() {
+        charge("user1", 50_000).andExpect(status().isOk)
+        transfer("user1", "user2", 10_000).andExpect(status().isOk)
+            .andExpect(jsonPath("$.data.fee").value(500))
+        balance("user1").andExpect(status().isOk).andExpect(jsonPath("$.balance").value(39_500))
+        balance("user2").andExpect(jsonPath("$.balance").value(10_000))
+    }
+
+    @Test
+    @DisplayName("거절 케이스")
+    fun rejects() {
+        charge("user1", 20_000)
+        transfer("user1", "user1", 1_000).andExpect(status().isBadRequest)
+        transfer("user1", "user2", 999).andExpect(status().isBadRequest)
+        transfer("user1", "nobody", 1_000).andExpect(status().isNotFound)
+        // 잔액 20,000 < 19,600 + 1,000
+        transfer("user1", "user2", 19_600).andExpect(status().isBadRequest)
+        transfer("user1", "user2", 19_000).andExpect(status().isOk)
+        balance("user1").andExpect(jsonPath("$.balance").value(0))
+    }
+
+    @Test
+    @DisplayName("1일 한도")
+    fun dailyLimit() {
+        charge("user1", 100_000_000)
+        transfer("user1", "user2", 9_000_000).andExpect(status().isOk)
+        transfer("user1", "user2", 1_000_001).andExpect(status().isBadRequest)
+        transfer("user1", "user2", 1_000_000).andExpect(status().isOk)
+    }
+}
