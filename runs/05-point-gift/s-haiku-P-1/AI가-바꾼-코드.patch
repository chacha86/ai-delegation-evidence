+    fun balanceStartsAtZero() {
+        mvc.perform(get("/api/v1/points").header("Authorization", "Bearer user1"))
+            .andExpect(status().isOk)
+            .andExpect(jsonPath("$.resultCode").value("200-1"))
+            .andExpect(jsonPath("$.data.balance").value(0))
+    }
+
+    @Test
+    @DisplayName("비로그인 잔액 조회는 401")
