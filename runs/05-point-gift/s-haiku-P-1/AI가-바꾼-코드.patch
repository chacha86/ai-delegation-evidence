+package com.rest1.domain.point.point.service
+
+import org.assertj.core.api.Assertions.assertThat
+import org.junit.jupiter.api.DisplayName
+import org.junit.jupiter.api.Test
+
+class PointPolicyTest {
+    @Test
+    @DisplayName("수수료 구간별 계산과 경계값")
+    fun feeTiers() {
+        // 1만P 이하: 500P
+        assertThat(PointPolicy.calcFee(1_000L)).isEqualTo(500L)
+        assertThat(PointPolicy.calcFee(10_000L)).isEqualTo(500L)
+
+        // 1만P 초과 10만P 이하: 1,000P
+        assertThat(PointPolicy.calcFee(10_001L)).isEqualTo(1_000L)
+        assertThat(PointPolicy.calcFee(100_000L)).isEqualTo(1_000L)
+
+        // 10만P 초과: 0.1%, 최대 5,000P
+        assertThat(PointPolicy.calcFee(100_001L)).isEqualTo(100L)
+        assertThat(PointPolicy.calcFee(1_000_000L)).isEqualTo(1_000L)
+        assertThat(PointPolicy.calcFee(5_000_000L)).isEqualTo(5_000L)
