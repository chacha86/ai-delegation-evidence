+package com.rest1.domain.point.point.service
+
+// 포인트 선물 정책 상수와 수수료 계산
+object PointPolicy {
+    // 최소 선물 금액 (수수료 제외 금액 기준)
+    const val MIN_TRANSFER_AMOUNT: Long = 1_000L
+
+    // 1일 선물 한도 (보낸 금액 합계 기준, 수수료 제외)
+    const val DAILY_TRANSFER_LIMIT: Long = 10_000_000L
+
+    private const val FEE_TRUNCATE_UNIT: Long = 10L
+
+    // 수수료: 1만P 이하 500P, 10만P 이하 1,000P, 그 이상은 금액의 0.1% (최대 5,000P).
+    // 계산 결과는 10P 미만을 절사한다.
+    fun calcFee(amount: Long): Long {
+        val rawFee = when {
+            amount <= 10_000L -> 500L
+            amount <= 100_000L -> 1_000L
+            else -> minOf(amount / 1_000L, 5_000L)
+        }
+
+        return rawFee / FEE_TRUNCATE_UNIT * FEE_TRUNCATE_UNIT
+    }
+}
