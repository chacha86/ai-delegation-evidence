+package com.rest1.domain.point.point.service
+
+import com.rest1.domain.member.member.repository.MemberRepository
+import com.rest1.domain.member.member.service.MemberService
+import com.rest1.domain.point.point.entity.PointTransfer
+import com.rest1.domain.point.point.repository.PointTransferRepository
+import com.rest1.global.exception.ServiceException
+import org.springframework.stereotype.Service
+import org.springframework.transaction.annotation.Transactional
+import java.time.LocalDate
+
+@Service
+class PointService(
+    private val memberRepository: MemberRepository,
+    private val memberService: MemberService,
+    private val pointTransferRepository: PointTransferRepository,
+) {
+    data class TransferResult(
+        val id: Long,
+        val toUsername: String,
+        val amount: Long,
+        val fee: Long,
+        val balance: Long,
+    )
+
+    fun balanceOf(memberId: Long): Long {
+        return memberService.findById(memberId)?.point ?: throw NoSuchElementException()
+    }
+
+    // 테스트용 충전
+    @Transactional
+    fun charge(memberId: Long, amount: Long): Long {
+        val member = lockMember(memberId)
+
+        if (amount > Long.MAX_VALUE - member.point) {
+            throw ServiceException("400-15", "보유 가능한 포인트를 초과합니다.")
+        }
+
+        member.point += amount
+
+        return member.point
+    }
+
+    @Transactional
+    fun transfer(senderId: Long, toUsername: String, amount: Long): TransferResult {
+        if (amount < PointPolicy.MIN_TRANSFER_AMOUNT) {
+            throw ServiceException("400-11", "최소 ${PointPolicy.MIN_TRANSFER_AMOUNT}P 이상 선물할 수 있습니다.")
+        }
+
+        val receiverId = memberService.findByUsername(toUsername)?.id
+            ?: throw ServiceException("404-2", "존재하지 않는 아이디입니다.")
+
+        if (receiverId == senderId) {
+            throw ServiceException("400-12", "자기 자신에게는 선물할 수 없습니다.")
+        }
+
+        // 교착을 피하려고 두 회원 행을 id 오름차순으로 잠근다
+        val lockedMembers = listOf(senderId, receiverId).sorted().associateWith { lockMember(it) }
+        val sender = lockedMembers.getValue(senderId)
+        val receiver = lockedMembers.getValue(receiverId)
+
+        // 잠근 뒤에 합계를 계산해야 동시 선물이 한도를 넘기지 못한다
+        val today = LocalDate.now()
+        val sentToday = pointTransferRepository
+            .findBySenderIdAndCreateDateGreaterThanEqualAndCreateDateLessThan(
+                senderId,
+                today.atStartOfDay(),
+                today.plusDays(1).atStartOfDay(),
+            )
+            .sumOf { it.amount }
+
+        // 덧셈 대신 뺄셈으로 비교해 큰 금액에서도 오버플로가 나지 않게 한다
+        if (amount > PointPolicy.DAILY_TRANSFER_LIMIT - sentToday) {
+            throw ServiceException("400-14", "1일 선물 한도를 초과했습니다.")
+        }
+
+        val fee = PointPolicy.calcFee(amount)
+
+        if (amount > sender.point - fee) {
+            throw ServiceException("400-13", "잔액이 부족합니다.")
+        }
+
+        sender.point -= amount + fee
+        receiver.point += amount
+
+        val transfer = pointTransferRepository.save(PointTransfer(sender, receiver, amount, fee))
+
+        return TransferResult(
+            id = transfer.id!!,
+            toUsername = receiver.username,
+            amount = amount,
+            fee = fee,
+            balance = sender.point,
+        )
+    }
+
+    private fun lockMember(memberId: Long) =
+        memberRepository.findByIdForUpdate(memberId) ?: throw NoSuchElementException()
+}
