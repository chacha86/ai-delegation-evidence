+
+    @Test
+    @DisplayName("잔액이 금액 + 수수료보다 적으면 400-13")
+    fun transferInsufficientBalance() {
+        // 금액 1,000P 는 잔액 1,000P 로 충분하지만 수수료 500P 가 더 필요하다
+        chargeAs("user1", 1_000)
+
+        transferAs("user1", "user2", 1_000)
+            .andExpect(status().isBadRequest)
+            .andExpect(jsonPath("$.resultCode").value("400-13"))
+
+        assertThat(balanceOf("user1")).isEqualTo(1_000L)
+        assertThat(balanceOf("user2")).isEqualTo(0L)
+    }
+
+    @Test
+    @DisplayName("1일 선물 한도(1,000만P)를 넘으면 400-14")
+    fun transferOverDailyLimit() {
+        chargeAs("user1", 30_000_000)
+
+        transferAs("user1", "user2", 10_000_000)
+            .andExpect(status().isCreated)
