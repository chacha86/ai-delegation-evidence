+package com.rest1.domain.point.point.controller
+
+import com.rest1.domain.point.point.service.PointService
+import com.rest1.global.rq.Rq
+import com.rest1.global.rsData.RsData
+import io.swagger.v3.oas.annotations.Operation
+import io.swagger.v3.oas.annotations.security.SecurityRequirement
+import io.swagger.v3.oas.annotations.tags.Tag
+import jakarta.validation.Valid
+import jakarta.validation.constraints.Min
+import jakarta.validation.constraints.NotBlank
+import jakarta.validation.constraints.NotNull
+import org.springframework.web.bind.annotation.GetMapping
+import org.springframework.web.bind.annotation.PostMapping
+import org.springframework.web.bind.annotation.RequestBody
+import org.springframework.web.bind.annotation.RequestMapping
+import org.springframework.web.bind.annotation.RestController
+
+@RestController
+@RequestMapping("/api/v1/points")
+@Tag(name = "ApiV1PointController", description = "포인트 API")
+@SecurityRequirement(name = "bearerAuth")
+class ApiV1PointController(
+    private val pointService: PointService,
+    private val rq: Rq,
+) {
+    data class BalanceResBody(
+        val balance: Long,
+    )
+
+    @GetMapping
+    @Operation(summary = "내 포인트 잔액 조회")
+    fun balance(): RsData<BalanceResBody> {
+        val balance = pointService.balanceOf(rq.actor.id!!)
+
+        return RsData(
+            "200-1",
+            "OK",
+            BalanceResBody(balance),
+        )
+    }
+
+    // 필드를 nullable 로 두는 이유는 ApiV1MemberController.JoinReqBody 주석 참고
+    data class ChargeReqBody(
+        @field:NotNull
+        @field:Min(1)
+        val amount: Long?,
+    )
+
+    @PostMapping("/charge")
+    @Operation(summary = "포인트 충전 (테스트용)")
+    fun charge(
+        @RequestBody @Valid reqBody: ChargeReqBody,
+    ): RsData<BalanceResBody> {
+        val balance = pointService.charge(rq.actor.id!!, reqBody.amount!!)
+
+        return RsData(
+            "200-1",
+            "${reqBody.amount}P 충전되었습니다.",
+            BalanceResBody(balance),
+        )
+    }
+
+    data class TransferReqBody(
+        @field:NotBlank
+        val toUsername: String?,
+        @field:NotNull
+        @field:Min(1)
+        val amount: Long?,
+    )
+
+    data class TransferResBody(
+        val id: Long,
+        val toUsername: String,
+        val amount: Long,
+        val fee: Long,
+        val balance: Long,
+    )
+
+    @PostMapping("/transfer")
+    @Operation(summary = "포인트 선물하기")
+    fun transfer(
+        @RequestBody @Valid reqBody: TransferReqBody,
+    ): RsData<TransferResBody> {
+        val result = pointService.transfer(rq.actor.id!!, reqBody.toUsername!!, reqBody.amount!!)
+
+        return RsData(
+            "201-1",
+            "${result.toUsername}님에게 ${result.amount}P를 선물했습니다.",
+            TransferResBody(
+                id = result.id,
+                toUsername = result.toUsername,
+                amount = result.amount,
+                fee = result.fee,
+                balance = result.balance,
+            ),
+        )
+    }
+}
