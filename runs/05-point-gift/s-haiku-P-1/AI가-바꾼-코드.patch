+
+        transferAs("user1", "user1", 1_000)
+            .andExpect(status().isBadRequest)
+            .andExpect(jsonPath("$.resultCode").value("400-12"))
+    }
+
+    @Test
+    @DisplayName("없는 아이디에게 선물하면 404-2")
+    fun transferToUnknownUser() {
+        chargeAs("user1", 50_000)
+
+        transferAs("user1", "nobody", 1_000)
+            .andExpect(status().isNotFound)
+            .andExpect(jsonPath("$.resultCode").value("404-2"))
