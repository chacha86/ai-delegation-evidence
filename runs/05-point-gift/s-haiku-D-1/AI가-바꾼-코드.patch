@@ -0,0 +1,78 @@
+package com.rest1.domain.point.point.service
+
+import com.rest1.domain.member.member.repository.MemberRepository
+import com.rest1.domain.point.point.entity.PointGift
+import com.rest1.domain.point.point.policy.PointGiftPolicy
+import com.rest1.domain.point.point.repository.PointGiftRepository
+import com.rest1.global.exception.ServiceException
+import org.springframework.stereotype.Service
+import org.springframework.transaction.annotation.Transactional
+
+@Service
+class PointService(
+    private val memberRepository: MemberRepository,
+    private val pointGiftRepository: PointGiftRepository,
+) {
+    data class GiftResult(
+        val gift: PointGift,
+        val toUsername: String,
+        val senderBalance: Long,
+    )
+
+    @Transactional
+    fun charge(memberId: Long, amount: Long): Long {
+        val member = memberRepository.findByIdForUpdate(memberId).orElseThrow { NoSuchElementException() }
+        member.addPoint(amount)
+
+        return member.point
+    }
+
+    @Transactional(readOnly = true)
+    fun balance(memberId: Long): Long {
+        return memberRepository.findById(memberId).orElseThrow { NoSuchElementException() }.point
+    }
+
+    // 보내는 사람은 금액+수수료를 내고, 받는 사람은 금액 전액을 받는다.
+    // 실패하면 예외로 롤백되며, 잔액 변경은 모든 검증을 통과한 뒤에만 한다.
+    @Transactional
+    fun gift(senderId: Long, toUsername: String, amount: Long): GiftResult {
+        if (amount < PointGiftPolicy.MIN_GIFT_AMOUNT) {
+            throw ServiceException("400-3", "최소 선물 금액은 1,000P 입니다.")
+        }
+
+        // 받는 사람은 id 만 조회한다. 엔티티를 먼저 올리면 잠금 조회가 잠금 전 값을 돌려준다.
+        val receiverId = memberRepository.findIdByUsername(toUsername)
+            ?: throw ServiceException("404-2", "존재하지 않는 아이디입니다.")
+
+        if (receiverId == senderId) {
+            throw ServiceException("400-4", "자기 자신에게는 선물할 수 없습니다.")
+        }
+
+        // 교착을 피하려고 항상 id 오름차순으로 잠근다. 보내는 사람 행 잠금이 같은 사람의 선물을 직렬화한다.
+        val locked = listOf(senderId, receiverId).sorted().associateWith { id ->
+            memberRepository.findByIdForUpdate(id).orElseThrow { NoSuchElementException() }
+        }
+        val sender = locked.getValue(senderId)
+        val receiver = locked.getValue(receiverId)
+
+        val fee = PointGiftPolicy.fee(amount)
+        val totalCost = amount + fee
+
+        if (sender.point < totalCost) {
+            throw ServiceException("400-5", "포인트가 부족합니다.")
+        }
+
+        val today = PointGiftPolicy.today()
+        val sentToday = pointGiftRepository.sumAmountBySenderAndDate(senderId, today) ?: 0L
+        if (sentToday + amount > PointGiftPolicy.DAILY_GIFT_LIMIT) {
+            throw ServiceException("400-6", "1일 선물 한도(1,000만P)를 초과합니다.")
+        }
+
+        sender.subtractPoint(totalCost)
+        receiver.addPoint(amount)
+
+        val gift = pointGiftRepository.save(PointGift(senderId, receiverId, amount, fee, today))
+
+        return GiftResult(gift, receiver.username, sender.point)
+    }
+}
