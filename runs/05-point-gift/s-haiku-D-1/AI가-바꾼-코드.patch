+package com.rest1.domain.point.point.policy
+
+import java.time.LocalDate
+import java.time.ZoneId
+
+object PointGiftPolicy {
+    const val MIN_GIFT_AMOUNT = 1_000L
+    const val DAILY_GIFT_LIMIT = 10_000_000L
+    const val MAX_FEE = 5_000L
+
+    // 1일 한도 기준 날짜는 한국 시간(KST)으로 본다
+    val GIFT_ZONE: ZoneId = ZoneId.of("Asia/Seoul")
+
+    fun today(): LocalDate = LocalDate.now(GIFT_ZONE)
+
+    // 1만P 이하 500P, 10만P 이하 1,000P, 10만P 초과 0.1% (최대 5,000P). 10P 미만은 절사한다.
+    fun fee(amount: Long): Long {
+        val raw = when {
+            amount <= 10_000L -> 500L
+            amount <= 100_000L -> 1_000L
+            else -> minOf(amount / 1_000L, MAX_FEE)
+        }
+        return raw / 10L * 10L
+    }
+}
