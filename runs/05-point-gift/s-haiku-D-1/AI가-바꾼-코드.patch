+package com.rest1.domain.point.point.policy
+
+import org.assertj.core.api.Assertions.assertThat
+import org.junit.jupiter.api.Test
+
+class PointGiftFeeTest {
+    @Test
+    fun `구간별 수수료와 경계값`() {
+        assertThat(PointGiftPolicy.fee(1_000)).isEqualTo(500)
+        assertThat(PointGiftPolicy.fee(10_000)).isEqualTo(500)
+        assertThat(PointGiftPolicy.fee(10_001)).isEqualTo(1_000)
+        assertThat(PointGiftPolicy.fee(100_000)).isEqualTo(1_000)
+        // 10만P 초과부터 0.1%. 기획 보강 사항대로 적용하므로 수수료가 1,000P 에서 100P 로 내려간다.
+        assertThat(PointGiftPolicy.fee(100_001)).isEqualTo(100)
+    }
+
+    @Test
+    fun `0_1퍼센트 계산, 10P 미만 절사, 최대 5천P`() {
+        assertThat(PointGiftPolicy.fee(345_670)).isEqualTo(340)
+        assertThat(PointGiftPolicy.fee(1_000_000)).isEqualTo(1_000)
+        assertThat(PointGiftPolicy.fee(4_999_999)).isEqualTo(4_990)
+        assertThat(PointGiftPolicy.fee(5_000_000)).isEqualTo(5_000)
+        assertThat(PointGiftPolicy.fee(10_000_000)).isEqualTo(5_000)
+    }
+}
