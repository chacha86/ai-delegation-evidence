+package com.rest1.domain.point.point.repository
+
+import com.rest1.domain.point.point.entity.PointGift
+import org.springframework.data.jpa.repository.JpaRepository
+import org.springframework.data.jpa.repository.Query
+import org.springframework.data.repository.query.Param
+import java.time.LocalDate
+
+interface PointGiftRepository : JpaRepository<PointGift, Long> {
+    // 해당 날짜에 보낸 선물 금액 합계(수수료 제외). 기록이 없으면 null
+    @Query("select sum(g.amount) from PointGift g where g.senderId = :senderId and g.giftDate = :giftDate")
+    fun sumAmountBySenderAndDate(
+        @Param("senderId") senderId: Long,
+        @Param("giftDate") giftDate: LocalDate,
+    ): Long?
+}
