+package com.rest1.domain.point.point.controller
+
+import com.rest1.domain.point.point.service.PointService
+import com.rest1.global.rq.Rq
+import com.rest1.global.rsData.RsData
+import jakarta.validation.Valid
+import jakarta.validation.constraints.Min
+import jakarta.validation.constraints.NotBlank
+import jakarta.validation.constraints.NotNull
+import org.springframework.web.bind.annotation.GetMapping
+import org.springframework.web.bind.annotation.PostMapping
+import org.springframework.web.bind.annotation.RequestBody
+import org.springframework.web.bind.annotation.RequestMapping
+import org.springframework.web.bind.annotation.RestController
+
+@RestController
+@RequestMapping("/api/v1/points")
+class ApiV1PointController(
+    private val pointService: PointService,
+    private val rq: Rq,
+) {
+    // 요청 바디 필드는 nullable 로 둔다. 이유는 ApiV1MemberController.JoinReqBody 주석 참고
+    data class ChargeReqBody(
+        @field:NotNull
+        @field:Min(1)
+        val amount: Long?,
+    )
+
+    data class ChargeResBody(
+        val balance: Long,
+    )
+
+    // 테스트용 충전
+    @PostMapping("/charge")
+    fun charge(
+        @RequestBody @Valid reqBody: ChargeReqBody,
+    ): RsData<ChargeResBody> {
+        val balance = pointService.charge(rq.actor.id!!, reqBody.amount!!)
+
+        return RsData(
+            "200-1",
+            "${reqBody.amount}P 가 충전되었습니다.",
+            ChargeResBody(balance),
+        )
+    }
+
+    data class BalanceResBody(
+        val balance: Long,
+    )
+
+    @GetMapping
+    fun balance(): RsData<BalanceResBody> {
+        val balance = pointService.balance(rq.actor.id!!)
+
+        return RsData(
+            "200-1",
+            "OK",
+            BalanceResBody(balance),
+        )
+    }
+
+    data class TransferReqBody(
+        @field:NotBlank
+        val toUsername: String?,
+        @field:NotNull
+        @field:Min(1)
+        val amount: Long?,
+    )
+
+    data class TransferResBody(
+        val giftId: Long,
+        val toUsername: String,
+        val amount: Long,
+        val fee: Long,
+        val totalPaid: Long,
+        val balance: Long,
+    )
+
+    @PostMapping("/transfer")
+    fun transfer(
+        @RequestBody @Valid reqBody: TransferReqBody,
+    ): RsData<TransferResBody> {
+        val amount = reqBody.amount!!
+        val result = pointService.gift(rq.actor.id!!, reqBody.toUsername!!, amount)
+
+        return RsData(
+            "201-1",
+            "${result.toUsername}님에게 ${amount}P 를 선물했습니다.",
+            TransferResBody(
+                giftId = result.gift.id!!,
+                toUsername = result.toUsername,
+                amount = result.gift.amount,
+                fee = result.gift.fee,
+                totalPaid = result.gift.amount + result.gift.fee,
+                balance = result.senderBalance,
+            ),
+        )
+    }
+}
