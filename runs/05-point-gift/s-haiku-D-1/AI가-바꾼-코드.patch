+package com.rest1.domain.point.point.entity
+
+import com.rest1.global.jpa.entity.BaseEntity
+import jakarta.persistence.Column
+import jakarta.persistence.Entity
+import jakarta.persistence.Index
+import jakarta.persistence.Table
+import java.time.LocalDate
+
+// 성공한 선물만 기록한다. 1일 한도 집계에 사용한다.
+@Entity
+@Table(indexes = [Index(name = "idx_point_gift_sender_date", columnList = "senderId, giftDate")])
+class PointGift(
+    @Column(nullable = false)
+    val senderId: Long,
+    @Column(nullable = false)
+    val receiverId: Long,
+    // 선물 금액(받는 사람이 받는 금액, 수수료 제외)
+    @Column(nullable = false)
+    val amount: Long,
+    @Column(nullable = false)
+    val fee: Long,
+    @Column(nullable = false)
+    val giftDate: LocalDate,
+) : BaseEntity()
