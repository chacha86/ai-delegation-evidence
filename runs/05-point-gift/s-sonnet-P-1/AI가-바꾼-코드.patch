+package com.rest1.domain.point.service
+
+object PointFee {
+    const val MIN_AMOUNT = 1_000L
+    const val DAILY_LIMIT = 10_000_000L
+
+    // 1만P까지 500, 10만P까지 1,000, 초과는 0.1% (최대 5,000). 10P 미만 절사.
+    // 초과 구간은 0.1% 가 1,000 보다 작아지는 역전(10만 초과인데 수수료가 줄어듦)을 막기 위해 최소 1,000 으로 둔다.
+    fun calculate(amount: Long): Long {
+        val raw = when {
+            amount <= 10_000 -> 500L
+            amount <= 100_000 -> 1_000L
+            else -> (amount / 1000).coerceIn(1_000L, 5_000L)
+        }
+        return raw / 10 * 10
+    }
+}
