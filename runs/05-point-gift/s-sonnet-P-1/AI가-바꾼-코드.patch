+package com.rest1.domain.point.controller
+
+import com.rest1.domain.point.service.PointService
+import com.rest1.global.exception.ServiceException
+import com.rest1.global.rq.Rq
+import jakarta.validation.Valid
+import jakarta.validation.constraints.NotBlank
+import jakarta.validation.constraints.NotNull
+import org.springframework.web.bind.annotation.GetMapping
+import org.springframework.web.bind.annotation.PostMapping
+import org.springframework.web.bind.annotation.RequestBody
+import org.springframework.web.bind.annotation.RequestMapping
+import org.springframework.web.bind.annotation.RestController
+import java.math.BigDecimal
+
+@RestController
+@RequestMapping("/api/v1/points")
+class ApiV1PointController(
+    private val pointService: PointService,
+    private val rq: Rq,
+) {
+    // balance 는 최상위와 data 양쪽에 둔다.
+    data class BalanceData(val balance: Long)
+    data class BalanceRes(val resultCode: String, val msg: String, val balance: Long, val data: BalanceData)
+
+    // 금액은 BigDecimal 로 받아 소수(1000.5)가 조용히 잘리는 일을 막는다.
+    data class ChargeReqBody(@field:NotNull val amount: BigDecimal?)
+
+    data class TransferReqBody(
+        @field:NotBlank val toUsername: String?,
+        @field:NotNull val amount: BigDecimal?,
+    )
+
+    data class TransferData(val toUsername: String, val amount: Long, val fee: Long, val balance: Long)
+    data class TransferRes(val resultCode: String, val msg: String, val balance: Long, val data: TransferData)
+
+    private fun toLong(v: BigDecimal): Long = try {
+        v.longValueExact()
+    } catch (e: ArithmeticException) {
+        throw ServiceException("400-2", "금액은 정수여야 합니다.")
+    }
+
+    @GetMapping
+    fun balance(): BalanceRes {
+        val balance = pointService.getBalance(rq.actor.id!!)
+        return BalanceRes("200-1", "OK", balance, BalanceData(balance))
+    }
+
+    @PostMapping("/charge")
+    fun charge(@RequestBody @Valid reqBody: ChargeReqBody): BalanceRes {
+        val balance = pointService.charge(rq.actor.id!!, toLong(reqBody.amount!!))
+        return BalanceRes("200-1", "충전되었습니다.", balance, BalanceData(balance))
+    }
+
+    @PostMapping("/transfer")
+    fun transfer(@RequestBody @Valid reqBody: TransferReqBody): TransferRes {
+        val r = pointService.transfer(rq.actor.id!!, reqBody.toUsername!!, toLong(reqBody.amount!!))
+        return TransferRes(
+            "200-1", "선물했습니다.", r.balance,
+            TransferData(reqBody.toUsername, r.amount, r.fee, r.balance),
+        )
+    }
+}
