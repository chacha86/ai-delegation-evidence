+package com.rest1.domain.point.service
+
+import com.rest1.domain.member.member.repository.MemberRepository
+import com.rest1.domain.point.entity.PointTransfer
+import com.rest1.domain.point.repository.PointTransferRepository
+import com.rest1.global.exception.ServiceException
+import org.springframework.stereotype.Service
+import org.springframework.transaction.annotation.Transactional
+import java.time.LocalDate
+import java.time.LocalDateTime
+
+@Service
+class PointService(
+    private val memberRepository: MemberRepository,
+    private val pointTransferRepository: PointTransferRepository,
+) {
+    data class TransferResult(val amount: Long, val fee: Long, val balance: Long)
+
+    @Transactional(readOnly = true)
+    fun getBalance(memberId: Long): Long =
+        memberRepository.findById(memberId).orElseThrow { NoSuchElementException() }.point
+
+    @Transactional
+    fun charge(memberId: Long, amount: Long): Long {
+        if (amount < 1) throw ServiceException("400-3", "충전 금액은 1P 이상이어야 합니다.")
+        if (amount > MAX_CHARGE) throw ServiceException("400-4", "1회 충전 한도는 ${MAX_CHARGE}P 입니다.")
+
+        val member = memberRepository.findAllByIdForUpdate(listOf(memberId)).firstOrNull()
+            ?: throw NoSuchElementException()
+        try {
+            member.addPoint(amount)
+        } catch (e: ArithmeticException) {
+            throw ServiceException("400-5", "보유 가능한 포인트를 초과합니다.")
+        }
+        return member.point
+    }
+
+    @Transactional
+    fun transfer(fromId: Long, toUsername: String, amount: Long): TransferResult {
+        if (amount < PointFee.MIN_AMOUNT) {
+            throw ServiceException("400-6", "최소 선물 금액은 ${PointFee.MIN_AMOUNT}P 입니다.")
+        }
+
+        val target = memberRepository.findByUsername(toUsername).orElse(null)
+            ?: throw ServiceException("404-2", "받는 사람을 찾을 수 없습니다.")
+        val toId = target.id!!
+        if (toId == fromId) throw ServiceException("400-7", "자기 자신에게는 선물할 수 없습니다.")
+
+        // 두 회원 행을 id 순으로 잠근다. 같은 보내는 사람의 동시 요청(한도/잔액 검사)도 여기서 직렬화된다.
+        val locked = memberRepository.findAllByIdForUpdate(listOf(fromId, toId)).associateBy { it.id }
+        val from = locked[fromId] ?: throw NoSuchElementException()
+        val to = locked[toId] ?: throw NoSuchElementException()
+
+        val now = LocalDateTime.now()
+        val today = LocalDate.now()
+        val sentToday = pointTransferRepository.sumAmount(fromId, today.atStartOfDay(), today.plusDays(1).atStartOfDay())
+        if (sentToday + amount > PointFee.DAILY_LIMIT) {
+            throw ServiceException("400-8", "1일 선물 한도(${PointFee.DAILY_LIMIT}P)를 초과합니다.")
+        }
+
+        val fee = PointFee.calculate(amount)
+        if (from.point < amount + fee) {
+            throw ServiceException("400-9", "포인트가 부족합니다. (필요: ${amount + fee}P)")
+        }
+
+        from.subtractPoint(amount + fee)
+        to.addPoint(amount)
+        pointTransferRepository.save(PointTransfer(fromId, toId, amount, fee, now))
+
+        return TransferResult(amount, fee, from.point)
+    }
+
+    companion object {
+        const val MAX_CHARGE = 100_000_000L
+    }
+}
