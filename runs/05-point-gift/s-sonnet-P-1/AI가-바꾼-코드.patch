+package com.rest1.domain.point.repository
+
+import com.rest1.domain.point.entity.PointTransfer
+import org.springframework.data.jpa.repository.JpaRepository
+import org.springframework.data.jpa.repository.Query
+import java.time.LocalDateTime
+
+interface PointTransferRepository : JpaRepository<PointTransfer, Long> {
+    @Query(
+        "select coalesce(sum(t.amount), 0) from PointTransfer t " +
+                "where t.fromMemberId = :memberId and t.transferredAt >= :from and t.transferredAt < :to"
+    )
+    fun sumAmount(memberId: Long, from: LocalDateTime, to: LocalDateTime): Long
+}
