+package com.rest1.domain.point.controller
+
+import com.rest1.domain.point.service.PointFee
+import org.assertj.core.api.Assertions.assertThat
+import org.junit.jupiter.api.DisplayName
+import org.junit.jupiter.api.Test
+import org.springframework.beans.factory.annotation.Autowired
+import org.springframework.boot.test.autoconfigure.web.servlet.AutoConfigureMockMvc
+import org.springframework.boot.test.context.SpringBootTest
+import org.springframework.http.MediaType
+import org.springframework.test.context.ActiveProfiles
+import org.springframework.test.web.servlet.MockMvc
+import org.springframework.test.web.servlet.ResultActions
+import org.springframework.test.web.servlet.request.MockMvcRequestBuilders.get
+import org.springframework.test.web.servlet.request.MockMvcRequestBuilders.post
+import org.springframework.test.web.servlet.result.MockMvcResultMatchers.jsonPath
+import org.springframework.test.web.servlet.result.MockMvcResultMatchers.status
+import org.springframework.transaction.annotation.Transactional
+
+@SpringBootTest
+@ActiveProfiles("test")
+@AutoConfigureMockMvc
+@Transactional
+class ApiV1PointControllerTest {
+    @Autowired
+    private lateinit var mvc: MockMvc
+
+    private fun charge(who: String, amount: String): ResultActions =
+        mvc.perform(
+            post("/api/v1/points/charge").header("Authorization", "Bearer $who")
+                .contentType(MediaType.APPLICATION_JSON).content("""{"amount": $amount}""")
+        )
+
+    private fun transfer(who: String, to: String, amount: String): ResultActions =
+        mvc.perform(
+            post("/api/v1/points/transfer").header("Authorization", "Bearer $who")
+                .contentType(MediaType.APPLICATION_JSON).content("""{"toUsername": "$to", "amount": $amount}""")
+        )
+
+    private fun balance(who: String): Long {
+        val body = mvc.perform(get("/api/v1/points").header("Authorization", "Bearer $who"))
+            .andExpect(status().isOk).andReturn().response.contentAsString
+        return Regex("\"balance\":(\\d+)").find(body)!!.groupValues[1].toLong()
+    }
+
+    @Test
+    @DisplayName("수수료 계산")
+    fun fee() {
+        assertThat(PointFee.calculate(1_000)).isEqualTo(500)
+        assertThat(PointFee.calculate(10_000)).isEqualTo(500)
+        assertThat(PointFee.calculate(10_001)).isEqualTo(1_000)
+        assertThat(PointFee.calculate(100_000)).isEqualTo(1_000)
+        assertThat(PointFee.calculate(100_001)).isEqualTo(1_000)
+        assertThat(PointFee.calculate(1_234_567)).isEqualTo(1_230)
+        assertThat(PointFee.calculate(5_000_000)).isEqualTo(5_000)
+        assertThat(PointFee.calculate(10_000_000)).isEqualTo(5_000)
+    }
+
+    @Test
+    @DisplayName("충전, 선물, 잔액")
+    fun t1() {
+        charge("user1", "20000").andExpect(status().isOk)
+        assertThat(balance("user1")).isEqualTo(20000)
+
+        transfer("user1", "user2", "10000").andExpect(status().isOk)
+            .andExpect(jsonPath("$.data.fee").value(500))
+        assertThat(balance("user1")).isEqualTo(9500)
+        assertThat(balance("user2")).isEqualTo(10000)
+    }
+
+    @Test
+    @DisplayName("거절 케이스")
+    fun t2() {
+        charge("user1", "10499").andExpect(status().isOk)
+        transfer("user1", "user1", "1000").andExpect(status().isBadRequest)
+        transfer("user1", "user2", "999").andExpect(status().isBadRequest)
+        transfer("user1", "nobody", "1000").andExpect(status().isNotFound)
+        transfer("user1", "user2", "10000").andExpect(status().isBadRequest) // 10500 필요
+        transfer("user1", "user2", "1000.5").andExpect(status().isBadRequest)
+        transfer("user1", "user2", "-5000").andExpect(status().isBadRequest)
+        mvc.perform(
+            post("/api/v1/points/transfer").contentType(MediaType.APPLICATION_JSON)
+                .content("""{"toUsername": "user2", "amount": 1000}""")
+        ).andExpect(status().isUnauthorized)
+        assertThat(balance("user1")).isEqualTo(10499)
+        assertThat(balance("user2")).isEqualTo(0)
+    }
+
+    @Test
+    @DisplayName("1일 한도 (수수료 제외 선물 금액 기준, 정확히 1천만은 허용)")
+    fun t3() {
+        charge("user1", "30000000").andExpect(status().isOk)
+        transfer("user1", "user2", "9000000").andExpect(status().isOk)
+        transfer("user1", "user2", "1000001").andExpect(status().isBadRequest)
+        transfer("user1", "user3", "1000000").andExpect(status().isOk)
+        transfer("user1", "user2", "1000").andExpect(status().isBadRequest)
+    }
+}
