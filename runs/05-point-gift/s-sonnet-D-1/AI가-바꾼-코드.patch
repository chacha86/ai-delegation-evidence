+package com.rest1.domain.point.repository
+
+import com.rest1.domain.point.entity.PointTransfer
+import org.springframework.data.jpa.repository.JpaRepository
+import org.springframework.data.jpa.repository.Query
+import org.springframework.data.repository.query.Param
+import java.time.LocalDate
+
+interface PointTransferRepository : JpaRepository<PointTransfer, Long> {
+    @Query("select coalesce(sum(t.amount), 0) from PointTransfer t where t.fromMemberId = :memberId and t.transferDate = :date")
+    fun sumAmountByDate(@Param("memberId") memberId: Long, @Param("date") date: LocalDate): Long
+}
diff --git a/src/main/kotlin/com/rest1/domain/point/service/PointService.kt b/src/main/kotlin/com/rest1/domain/point/service/PointService.kt
