+package com.rest1.domain.point.controller
+
+import com.rest1.domain.point.service.PointService
+import com.rest1.global.rq.Rq
+import com.rest1.global.rsData.RsData
+import jakarta.validation.Valid
+import jakarta.validation.constraints.NotBlank
+import jakarta.validation.constraints.NotNull
+import org.springframework.web.bind.annotation.GetMapping
+import org.springframework.web.bind.annotation.PostMapping
+import org.springframework.web.bind.annotation.RequestBody
+import org.springframework.web.bind.annotation.RequestMapping
+import org.springframework.web.bind.annotation.RestController
+
+@RestController
+@RequestMapping("/api/v1/points")
+class ApiV1PointController(
+    private val pointService: PointService,
+    private val rq: Rq,
+) {
+    data class BalanceResBody(val balance: Long)
+
+    @GetMapping
+    fun balance(): RsData<BalanceResBody> =
+        RsData("200-1", "OK", BalanceResBody(pointService.balanceOf(rq.actor.id!!)))
+
+    data class ChargeReqBody(@field:NotNull val amount: Long?)
+
+    @PostMapping("/charge")
+    fun charge(@RequestBody @Valid reqBody: ChargeReqBody): RsData<BalanceResBody> =
+        RsData("200-1", "충전되었습니다.", BalanceResBody(pointService.charge(rq.actor.id!!, reqBody.amount!!)))
+
+    data class TransferReqBody(
+        @field:NotBlank val toUsername: String?,
+        @field:NotNull val amount: Long?,
+    )
+
+    data class TransferResBody(val amount: Long, val fee: Long, val balance: Long)
+
+    @PostMapping("/transfer")
+    fun transfer(@RequestBody @Valid reqBody: TransferReqBody): RsData<TransferResBody> {
+        val r = pointService.transfer(rq.actor.id!!, reqBody.toUsername!!, reqBody.amount!!)
+        return RsData("200-1", "선물했습니다.", TransferResBody(r.amount, r.fee, r.balance))
+    }
+}
