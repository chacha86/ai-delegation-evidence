@@ -0,0 +1,77 @@
+package com.rest1.domain.point.service
+
+import com.rest1.domain.member.member.repository.MemberRepository
+import com.rest1.domain.point.entity.PointAccount
+import com.rest1.domain.point.entity.PointTransfer
+import com.rest1.domain.point.repository.PointAccountRepository
+import com.rest1.domain.point.repository.PointTransferRepository
+import com.rest1.global.exception.ServiceException
+import org.springframework.stereotype.Service
+import org.springframework.transaction.annotation.Transactional
+import java.time.LocalDate
+
+@Service
+class PointService(
+    private val memberRepository: MemberRepository,
+    private val accountRepository: PointAccountRepository,
+    private val transferRepository: PointTransferRepository,
+) {
+    companion object {
+        const val MIN_AMOUNT = 1_000L
+        const val DAILY_LIMIT = 10_000_000L
+        const val MAX_CHARGE = 100_000_000L
+
+        fun calcFee(amount: Long): Long = when {
+            amount <= 10_000L -> 500L
+            amount <= 100_000L -> 1_000L
+            else -> minOf(amount / 1_000L / 10L * 10L, 5_000L) // 0.1%, 10P 미만 절사
+        }
+    }
+
+    data class TransferResult(val amount: Long, val fee: Long, val balance: Long)
+
+    // 회원 행을 잠근 상태에서만 호출한다(계좌 최초 생성 경합 방지)
+    private fun accountOf(memberId: Long): PointAccount =
+        accountRepository.findByMemberId(memberId) ?: accountRepository.save(PointAccount(memberId))
+
+    @Transactional(readOnly = true)
+    fun balanceOf(memberId: Long): Long = accountRepository.findByMemberId(memberId)?.balance ?: 0L
+
+    @Transactional
+    fun charge(memberId: Long, amount: Long): Long {
+        if (amount < 1 || amount > MAX_CHARGE) throw ServiceException("400-3", "충전 금액은 1P 이상 ${MAX_CHARGE}P 이하여야 합니다.")
+        memberRepository.lockAllByIds(listOf(memberId)).firstOrNull() ?: throw NoSuchElementException()
+        val account = accountOf(memberId)
+        account.balance += amount
+        return account.balance
+    }
+
+    @Transactional
+    fun transfer(fromId: Long, toUsername: String, amount: Long): TransferResult {
+        if (amount < MIN_AMOUNT) throw ServiceException("400-4", "최소 선물 금액은 ${MIN_AMOUNT}P 입니다.")
+        if (amount > DAILY_LIMIT) throw ServiceException("400-5", "1일 선물 한도(${DAILY_LIMIT}P)를 초과했습니다.")
+
+        val to = memberRepository.findByUsername(toUsername).orElse(null)
+            ?: throw ServiceException("404-2", "존재하지 않는 아이디입니다.")
+        val toId = to.id!!
+        if (toId == fromId) throw ServiceException("400-6", "자기 자신에게는 선물할 수 없습니다.")
+
+        // 두 회원을 id 순서로 잠근다. 이후 보낸 사람 기준 검증/차감은 직렬화된다.
+        val locked = memberRepository.lockAllByIds(listOf(fromId, toId))
+        if (locked.size != 2) throw ServiceException("404-2", "존재하지 않는 아이디입니다.")
+
+        val today = LocalDate.now()
+        val used = transferRepository.sumAmountByDate(fromId, today)
+        if (used + amount > DAILY_LIMIT) throw ServiceException("400-5", "1일 선물 한도(${DAILY_LIMIT}P)를 초과했습니다.")
+
+        val fee = calcFee(amount)
+        val from = accountOf(fromId)
+        if (from.balance < amount + fee) throw ServiceException("400-7", "포인트 잔액이 부족합니다.")
+        val target = accountOf(toId)
+
+        from.balance -= amount + fee
+        target.balance += amount
+        transferRepository.save(PointTransfer(fromId, toId, amount, fee, today))
+        return TransferResult(amount, fee, from.balance)
+    }
+}
