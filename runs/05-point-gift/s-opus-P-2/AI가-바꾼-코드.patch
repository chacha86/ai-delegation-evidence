+package com.rest1.domain.point.point.controller
+
+import com.rest1.domain.point.point.service.PointService
+import com.rest1.global.exception.ServiceException
+import com.rest1.global.rq.Rq
+import com.rest1.global.rsData.RsData
+import io.swagger.v3.oas.annotations.Operation
+import io.swagger.v3.oas.annotations.security.SecurityRequirement
+import io.swagger.v3.oas.annotations.tags.Tag
+import jakarta.validation.Valid
+import jakarta.validation.constraints.NotBlank
+import jakarta.validation.constraints.NotNull
+import org.springframework.web.bind.annotation.GetMapping
+import org.springframework.web.bind.annotation.PostMapping
+import org.springframework.web.bind.annotation.RequestBody
+import org.springframework.web.bind.annotation.RequestMapping
+import org.springframework.web.bind.annotation.RestController
+import java.math.BigDecimal
+
+@RestController
+@RequestMapping("/api/v1/points")
+@Tag(name = "ApiV1PointController", description = "포인트 API")
+@SecurityRequirement(name = "bearerAuth")
+class ApiV1PointController(
+    private val pointService: PointService,
+    private val rq: Rq,
+) {
+    data class PointBalanceResBody(
+        val memberId: Long,
+        val username: String,
+        val balance: Long,
+    )
+
+    @GetMapping
+    @Operation(summary = "내 포인트 잔액 조회")
+    fun getBalance(): PointBalanceResBody {
+        val actor = rq.actor
+
+        return PointBalanceResBody(
+            actor.id!!,
+            actor.username,
+            pointService.getBalance(actor.id!!),
+        )
+    }
+
+    // 금액을 BigDecimal 로 받는 이유: Long 으로 받으면 Jackson 이 1000.5 를 1000 으로 조용히 잘라 버린다.
+    // 필드를 nullable 로 두는 이유는 ApiV1MemberController.JoinReqBody 주석 참고
+    data class PointChargeReqBody(
+        @field:NotNull
+        val amount: BigDecimal?,
+    )
+
+    data class PointChargeResBody(
+        val chargedAmount: Long,
+        val balance: Long,
+    )
+
+    @PostMapping("/charge")
+    @Operation(summary = "포인트 충전 (테스트용)")
+    fun charge(
+        @RequestBody @Valid reqBody: PointChargeReqBody,
+    ): RsData<PointChargeResBody> {
+        val actor = rq.actor
+        val amount = toPointAmount(reqBody.amount!!)
+
+        val balance = pointService.charge(actor.id!!, amount)
+
+        return RsData(
+            "200-1",
+            "${fmt(amount)}P 가 충전되었습니다.",
+            PointChargeResBody(amount, balance),
+        )
+    }
+
+    data class PointTransferReqBody(
+        @field:NotBlank
+        val toUsername: String?,
+        @field:NotNull
+        val amount: BigDecimal?,
+    )
+
+    data class PointTransferResBody(
+        val transferId: Long,
+        val toUsername: String,
+        val amount: Long,
+        val fee: Long,
+        val totalDeducted: Long,
+        val balance: Long,
+    )
+
+    @PostMapping("/transfer")
+    @Operation(summary = "포인트 선물하기")
+    fun transfer(
+        @RequestBody @Valid reqBody: PointTransferReqBody,
+    ): RsData<PointTransferResBody> {
+        val actor = rq.actor
+        val amount = toPointAmount(reqBody.amount!!)
+
+        val result = pointService.transfer(actor.id!!, actor.username, reqBody.toUsername!!.trim(), amount)
+        val transfer = result.transfer
+
+        return RsData(
+            "200-1",
+            "${result.receiverUsername}님에게 ${fmt(transfer.amount)}P 를 선물했습니다. (수수료 ${fmt(transfer.fee)}P)",
+            PointTransferResBody(
+                transfer.id!!,
+                result.receiverUsername,
+                transfer.amount,
+                transfer.fee,
+                transfer.amount + transfer.fee,
+                result.senderBalance,
+            ),
+        )
+    }
+
+    private fun toPointAmount(raw: BigDecimal): Long {
+        val normalized = raw.stripTrailingZeros()
+
+        if (normalized.scale() > 0) {
+            throw ServiceException("400-1", "금액은 정수로 입력해주세요.")
+        }
+        if (normalized.signum() <= 0) {
+            throw ServiceException("400-1", "금액은 0보다 커야 합니다.")
+        }
+        // 정책상 어떤 금액 한도보다도 훨씬 큰 값. 이보다 크면 Long 변환 전에 거절한다.
+        if (normalized > MAX_INPUT_AMOUNT) {
+            throw ServiceException("400-1", "금액이 너무 큽니다.")
+        }
+
+        return normalized.longValueExact()
+    }
+
+    private fun fmt(value: Long): String = "%,d".format(value)
+
+    companion object {
+        private val MAX_INPUT_AMOUNT = BigDecimal("1000000000000000") // 10^15
+    }
+}
