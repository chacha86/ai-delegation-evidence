+package com.rest1.domain.point.point.service
+
+import com.rest1.domain.point.point.entity.PointCharge
+import com.rest1.domain.point.point.entity.PointTransfer
+import com.rest1.domain.point.point.entity.PointWallet
+import com.rest1.domain.point.point.repository.PointChargeRepository
+import com.rest1.domain.point.point.repository.PointTransferRepository
+import com.rest1.domain.point.point.repository.PointWalletRepository
+import com.rest1.global.exception.ServiceException
+import org.springframework.stereotype.Component
+import org.springframework.transaction.annotation.Transactional
+import java.time.Clock
+import java.time.LocalDate
+import java.time.LocalDateTime
+
+/**
+ * 잔액을 실제로 바꾸는 트랜잭션 단위. 지갑은 PointService 가 미리 만들어 둔다.
+ * 지갑을 FOR UPDATE 로 잠근 뒤에 한도/잔액을 검사하므로 동시 요청에서도
+ * 잔액이 음수가 되거나 1일 한도를 넘지 않는다.
+ */
+@Component
+class PointLedger(
+    private val pointWalletRepository: PointWalletRepository,
+    private val pointTransferRepository: PointTransferRepository,
+    private val pointChargeRepository: PointChargeRepository,
+    private val pointClock: Clock,
+) {
+    @Transactional
+    fun charge(memberId: Long, amount: Long): Long {
+        val wallet = lockWallet(memberId)
+            ?: throw IllegalStateException("point wallet not found: memberId=$memberId")
+
+        wallet.deposit(amount)
+        pointChargeRepository.save(PointCharge(memberId, amount))
+
+        return wallet.balance
+    }
+
+    /** @return 선물 기록과 보낸 사람의 남은 잔액 */
+    @Transactional
+    fun transfer(senderId: Long, receiverId: Long, amount: Long): Pair<PointTransfer, Long> {
+        val fee = PointPolicy.calcFee(amount)
+        val totalDeduction = amount + fee
+
+        // 데드락을 피하려고 항상 memberId 가 작은 지갑부터 잠근다
+        val wallets = listOf(senderId, receiverId).sorted().associateWith { lockWallet(it) }
+        val senderWallet = wallets[senderId]
+        val receiverWallet = wallets[receiverId]
+            ?: throw IllegalStateException("point wallet not found: memberId=$receiverId")
+
+        val now = LocalDateTime.now(pointClock)
+        val todayStart = LocalDate.now(pointClock).atStartOfDay()
+        val sentToday = pointTransferRepository.sumAmountBySenderBetween(senderId, todayStart, todayStart.plusDays(1))
+
+        if (sentToday + amount > PointPolicy.DAILY_TRANSFER_LIMIT) {
+            throw dailyLimitException(sentToday)
+        }
+
+        val senderBalance = senderWallet?.balance ?: 0L
+        if (senderWallet == null || senderBalance < totalDeduction) {
+            throw ServiceException(
+                "400-4",
+                "잔액이 부족합니다. (필요: ${fmt(totalDeduction)}P = 선물 ${fmt(amount)}P + 수수료 ${fmt(fee)}P, 잔액: ${fmt(senderBalance)}P)",
+            )
+        }
+
+        senderWallet.withdraw(totalDeduction)
+        receiverWallet.deposit(amount)
+
+        val transfer = pointTransferRepository.save(
+            PointTransfer(senderId, receiverId, amount, fee, now)
+        )
+
+        return transfer to senderWallet.balance
+    }
+
+    private fun lockWallet(memberId: Long): PointWallet? =
+        pointWalletRepository.findByMemberIdForUpdate(memberId)
+
+    companion object {
+        fun dailyLimitException(sentToday: Long): ServiceException {
+            val remain = (PointPolicy.DAILY_TRANSFER_LIMIT - sentToday).coerceAtLeast(0)
+            return ServiceException(
+                "400-6",
+                "1일 선물 한도(${fmt(PointPolicy.DAILY_TRANSFER_LIMIT)}P)를 초과합니다. 오늘 남은 한도: ${fmt(remain)}P",
+            )
+        }
+
+        fun fmt(value: Long): String = "%,d".format(value)
+    }
+}
