+package com.rest1.domain.point.point.entity
+
+import com.rest1.global.exception.ServiceException
+import com.rest1.global.jpa.entity.BaseEntity
+import jakarta.persistence.Column
+import jakarta.persistence.Entity
+
+/**
+ * 회원 1명당 1개의 포인트 지갑. Member 엔티티를 건드리지 않으려고 별도 테이블로 둔다.
+ * 지갑은 처음 충전하거나 선물을 받을 때 만들어진다.
+ */
+@Entity
+class PointWallet(
+    @Column(unique = true, nullable = false)
+    val memberId: Long,
+) : BaseEntity() {
+    @Column(nullable = false)
+    var balance: Long = 0
+        protected set
+
+    fun deposit(amount: Long) {
+        require(amount > 0) { "amount must be positive: $amount" }
+        balance = Math.addExact(balance, amount)
+    }
+
+    fun withdraw(amount: Long) {
+        require(amount > 0) { "amount must be positive: $amount" }
+        if (balance < amount) {
+            throw ServiceException("400-4", "잔액이 부족합니다.")
+        }
+        balance -= amount
+    }
+}
