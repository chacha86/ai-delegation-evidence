+package com.rest1.domain.point.point.service
+
+import com.rest1.domain.member.member.repository.MemberRepository
+import com.rest1.domain.point.point.entity.PointTransfer
+import com.rest1.domain.point.point.repository.PointWalletRepository
+import com.rest1.global.exception.ServiceException
+import org.springframework.stereotype.Service
+import org.springframework.transaction.annotation.Transactional
+
+/**
+ * 포인트 기능의 진입점.
+ *
+ * 이 클래스의 charge/transfer 는 일부러 트랜잭션을 열지 않는다.
+ * 지갑이 없으면 먼저 별도 트랜잭션으로 만들고(PointWalletCreator), 그 다음
+ * 잔액 변경만 PointLedger 의 트랜잭션 안에서 한다. 바깥 트랜잭션이 커넥션을 쥔 채로
+ * REQUIRES_NEW 를 호출하면 요청 1건이 커넥션 2개를 쓰게 되어, 동시 요청이 많을 때
+ * 커넥션 풀이 고갈될 수 있기 때문이다.
+ */
+@Service
+class PointService(
+    private val pointWalletRepository: PointWalletRepository,
+    private val pointWalletCreator: PointWalletCreator,
+    private val pointLedger: PointLedger,
+    private val memberRepository: MemberRepository,
+) {
+    data class TransferResult(
+        val transfer: PointTransfer,
+        val receiverUsername: String,
+        val senderBalance: Long,
+    )
+
+    @Transactional(readOnly = true)
+    fun getBalance(memberId: Long): Long =
+        pointWalletRepository.findByMemberId(memberId)?.balance ?: 0L
+
+    /** 테스트용 충전. 충전 후 잔액을 돌려준다. */
+    fun charge(memberId: Long, amount: Long): Long {
+        if (amount <= 0) {
+            throw ServiceException("400-1", "충전 금액은 0보다 커야 합니다.")
+        }
+        if (amount > PointPolicy.MAX_CHARGE_AMOUNT) {
+            throw ServiceException("400-7", "1회 충전 금액은 ${fmt(PointPolicy.MAX_CHARGE_AMOUNT)}P 를 넘을 수 없습니다.")
+        }
+
+        pointWalletCreator.ensureExists(memberId)
+
+        return pointLedger.charge(memberId, amount)
+    }
+
+    /**
+     * 선물하기. 보내는 사람 잔액에서 (amount + fee) 를 빼고 받는 사람에게 amount 를 더한다.
+     * 검사 순서: 최소 금액 -> 자기 자신 -> 받는 사람 존재 -> 1일 한도 -> 잔액
+     */
+    fun transfer(senderId: Long, senderUsername: String, toUsername: String, amount: Long): TransferResult {
+        if (amount < PointPolicy.MIN_TRANSFER_AMOUNT) {
+            throw ServiceException("400-3", "최소 선물 금액은 ${fmt(PointPolicy.MIN_TRANSFER_AMOUNT)}P 입니다.")
+        }
+
+        if (toUsername == senderUsername) {
+            throw selfTransferException()
+        }
+
+        val receiver = memberRepository.findByUsername(toUsername).orElse(null)
+            ?: throw ServiceException("404-2", "존재하지 않는 회원입니다.")
+        val receiverId = receiver.id!!
+
+        if (receiverId == senderId) {
+            throw selfTransferException()
+        }
+
+        if (amount > PointPolicy.DAILY_TRANSFER_LIMIT) {
+            throw PointLedger.dailyLimitException(0)
+        }
+
+        // 보내는 사람 지갑은 만들지 않는다. 지갑이 없으면 잔액 0 이므로 PointLedger 에서 잔액 부족이 된다.
+        pointWalletCreator.ensureExists(receiverId)
+
+        val (transfer, senderBalance) = pointLedger.transfer(senderId, receiverId, amount)
+
+        return TransferResult(transfer, receiver.username, senderBalance)
+    }
+
+    private fun selfTransferException() = ServiceException("400-5", "자기 자신에게는 선물할 수 없습니다.")
+
+    private fun fmt(value: Long): String = PointLedger.fmt(value)
+}
