@@ -0,0 +1,134 @@
+package com.rest1.domain.point.point.service
+
+import com.rest1.domain.member.member.repository.MemberRepository
+import com.rest1.global.exception.ServiceException
+import org.assertj.core.api.Assertions.assertThat
+import org.junit.jupiter.api.DisplayName
+import org.junit.jupiter.api.Test
+import org.springframework.beans.factory.annotation.Autowired
+import org.springframework.boot.test.context.SpringBootTest
+import org.springframework.test.context.ActiveProfiles
+import java.util.Collections
+import java.util.concurrent.CountDownLatch
+import java.util.concurrent.Executors
+import java.util.concurrent.TimeUnit
+
+/**
+ * 동시 요청에서 잔액/한도가 지켜지는지 확인한다.
+ * 트랜잭션을 실제로 커밋해야 하므로 @Transactional 을 붙이지 않고,
+ * 다른 테스트와 DB 를 공유하지 않도록 별도 DB URL 로 별도 컨텍스트를 띄운다.
+ */
+@SpringBootTest(
+    properties = [
+        "spring.datasource.url=jdbc:h2:mem:db_point_concurrency_\${random.uuid};MODE=MySQL;LOCK_TIMEOUT=10000",
+    ]
+)
+@ActiveProfiles("test")
+class PointServiceConcurrencyTest {
+    @Autowired
+    private lateinit var pointService: PointService
+
+    @Autowired
+    private lateinit var memberRepository: MemberRepository
+
+    private fun idOf(username: String): Long = memberRepository.findByUsername(username).get().id!!
+
+    private fun runConcurrently(tasks: List<() -> Unit>): List<Throwable?> {
+        val pool = Executors.newFixedThreadPool(tasks.size)
+        val ready = CountDownLatch(tasks.size)
+        val start = CountDownLatch(1)
+        val results = Collections.synchronizedList(MutableList<Throwable?>(tasks.size) { null })
+
+        tasks.forEachIndexed { i, task ->
+            pool.submit {
+                ready.countDown()
+                start.await()
+                try {
+                    task()
+                } catch (e: Throwable) {
+                    results[i] = e
+                }
+            }
+        }
+
+        ready.await()
+        start.countDown()
+        pool.shutdown()
+        assertThat(pool.awaitTermination(60, TimeUnit.SECONDS)).isTrue()
+
+        return results
+    }
+
+    @Test
+    @DisplayName("같은 사람이 동시에 여러 번 선물해도 잔액이 음수가 되지 않는다")
+    fun t1() {
+        // user1 은 이 테스트에서만 보내는 사람으로 쓰므로 시작 잔액은 0 이다
+        val senderId = idOf("user1")
+        val receiverId = idOf("user2")
+        val receiverBefore = pointService.getBalance(receiverId)
+
+        pointService.charge(senderId, 1_000_000)
+
+        // 100,000P 선물 = 수수료 1,000P 포함 101,000P 차감 -> 1,000,000P 로는 9번만 가능
+        val results = runConcurrently(
+            List(20) { { pointService.transfer(senderId, "user1", "user2", 100_000); Unit } }
+        )
+
+        val successes = results.count { it == null }
+        val failures = results.filterNotNull()
+
+        assertThat(failures).allSatisfy {
+            assertThat(it).isInstanceOf(ServiceException::class.java)
+            assertThat((it as ServiceException).resultCode).isEqualTo("400-4")
+        }
+        assertThat(successes).isEqualTo(9)
+        assertThat(pointService.getBalance(senderId)).isEqualTo(1_000_000L - 9 * 101_000)
+        assertThat(pointService.getBalance(receiverId)).isEqualTo(receiverBefore + 9 * 100_000L)
+    }
+
+    @Test
+    @DisplayName("두 사람이 서로에게 동시에 선물해도 데드락 없이 모두 처리된다")
+    fun t2() {
+        val aId = idOf("user3")
+        val bId = idOf("admin")
+
+        pointService.charge(aId, 100_000)
+        pointService.charge(bId, 100_000)
+        val aBefore = pointService.getBalance(aId)
+        val bBefore = pointService.getBalance(bId)
+
+        val tasks = List(20) { i ->
+            if (i % 2 == 0) {
+                { pointService.transfer(aId, "user3", "admin", 1_000); Unit }
+            } else {
+                { pointService.transfer(bId, "admin", "user3", 1_000); Unit }
+            }
+        }
+
+        val results = runConcurrently(tasks)
+
+        assertThat(results.filterNotNull()).isEmpty()
+        // 각자 10번 보내고(1,500P x 10) 10번 받음(1,000P x 10)
+        assertThat(pointService.getBalance(aId)).isEqualTo(aBefore - 15_000 + 10_000)
+        assertThat(pointService.getBalance(bId)).isEqualTo(bBefore - 15_000 + 10_000)
+    }
+
+    @Test
+    @DisplayName("동시에 선물해도 1일 한도를 넘지 않는다")
+    fun t3() {
+        val senderId = idOf("system")
+
+        pointService.charge(senderId, 50_000_000)
+
+        // 3,000,000P x 10건 동시 요청 -> 한도 10,000,000P 이므로 3건만 성공
+        val results = runConcurrently(
+            List(10) { { pointService.transfer(senderId, "system", "user3", 3_000_000); Unit } }
+        )
+
+        val failures = results.filterNotNull()
+        assertThat(failures).allSatisfy {
+            assertThat((it as ServiceException).resultCode).isEqualTo("400-6")
+        }
+        assertThat(results.count { it == null }).isEqualTo(3)
+    }
+}
