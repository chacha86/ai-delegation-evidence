+package com.rest1.domain.point.point.entity
+
+import com.rest1.global.jpa.entity.BaseEntity
+import jakarta.persistence.Column
+import jakarta.persistence.Entity
+import jakarta.persistence.Index
+import jakarta.persistence.Table
+import java.time.LocalDateTime
+
+/**
+ * 선물 1건의 기록. 1일 선물 한도 계산에도 쓴다.
+ * 수수료는 보내는 사람 잔액에서 (amount + fee) 만큼 빠지고, 받는 사람은 amount 만큼 받는다.
+ * 수수료는 별도 지갑에 적립하지 않고 이 기록의 fee 로만 남긴다.
+ */
+@Entity
+@Table(indexes = [Index(name = "idx_point_transfer_sender_at", columnList = "senderId, transferredAt")])
+class PointTransfer(
+    @Column(nullable = false)
+    val senderId: Long,
+    @Column(nullable = false)
+    val receiverId: Long,
+    @Column(nullable = false)
+    val amount: Long,
+    @Column(nullable = false)
+    val fee: Long,
+    // 한도 계산 기준 시각 (Asia/Seoul). Clock 으로 넣어서 테스트에서 바꿀 수 있게 한다.
+    @Column(nullable = false)
+    val transferredAt: LocalDateTime,
+) : BaseEntity()
