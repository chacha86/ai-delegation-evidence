+package com.rest1.domain.point.point.service
+
+/**
+ * 포인트 선물하기 기획서 v1.2 의 정책 값과 수수료 계산.
+ *
+ * 수수료 구간 (경계값 포함):
+ * - 선물 금액 <= 10,000P            : 500P
+ * - 10,000P < 선물 금액 <= 100,000P : 1,000P
+ * - 100,000P < 선물 금액            : 선물 금액의 0.1% (10P 미만 절사, 최대 5,000P)
+ *
+ * 주의: 기획서 문구를 그대로 구현했기 때문에 100,000P 를 조금 넘는 구간(100,001P ~ 999,999P)은
+ * 수수료가 1,000P 보다 작아진다(예: 100,010P -> 100P). 기획 확인이 필요한 부분이다.
+ */
+object PointPolicy {
+    const val MIN_TRANSFER_AMOUNT = 1_000L
+    const val DAILY_TRANSFER_LIMIT = 10_000_000L
+
+    // 테스트용 충전 1회 최대 금액. 기획서에는 없지만 잔액 overflow 와 오남용을 막기 위해 둔다.
+    const val MAX_CHARGE_AMOUNT = 100_000_000L
+
+    private const val TIER1_UPPER = 10_000L
+    private const val TIER1_FEE = 500L
+    private const val TIER2_UPPER = 100_000L
+    private const val TIER2_FEE = 1_000L
+    private const val MAX_FEE = 5_000L
+
+    fun calcFee(amount: Long): Long {
+        require(amount > 0) { "amount must be positive: $amount" }
+
+        return when {
+            amount <= TIER1_UPPER -> TIER1_FEE
+            amount <= TIER2_UPPER -> TIER2_FEE
+            else -> {
+                // 0.1% = amount / 1000, 10P 미만 절사 = 10 으로 나눈 몫 * 10
+                val rateFee = amount / 1_000 / 10 * 10
+                minOf(rateFee, MAX_FEE)
+            }
+        }
+    }
+}
