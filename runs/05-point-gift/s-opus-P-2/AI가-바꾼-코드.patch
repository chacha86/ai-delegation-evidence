+package com.rest1.domain.point.point.service
+
+import com.rest1.domain.point.point.entity.PointWallet
+import com.rest1.domain.point.point.repository.PointWalletRepository
+import org.springframework.dao.DataIntegrityViolationException
+import org.springframework.stereotype.Component
+import org.springframework.transaction.annotation.Propagation
+import org.springframework.transaction.annotation.Transactional
+
+/**
+ * 지갑이 없으면 별도 트랜잭션(REQUIRES_NEW)으로 만들어 바로 커밋한다.
+ * 같은 회원의 첫 충전/첫 수신이 동시에 들어와도 member_id unique 제약으로 하나만 생기고,
+ * 진 쪽은 이미 생긴 지갑을 그대로 쓴다. 바깥 트랜잭션은 그 뒤에 FOR UPDATE 로 잠근다.
+ */
+@Component
+class PointWalletCreator(
+    private val pointWalletRepository: PointWalletRepository,
+    private val txHelper: PointWalletCreatorTx,
+) {
+    fun ensureExists(memberId: Long) {
+        if (pointWalletRepository.findByMemberId(memberId) != null) return
+
+        try {
+            txHelper.createInNewTx(memberId)
+        } catch (e: DataIntegrityViolationException) {
+            // 다른 요청이 먼저 만들었다. 그대로 진행한다.
+        }
+    }
+}
+
+@Component
+class PointWalletCreatorTx(
+    private val pointWalletRepository: PointWalletRepository,
+) {
+    @Transactional(propagation = Propagation.REQUIRES_NEW)
+    fun createInNewTx(memberId: Long) {
+        if (pointWalletRepository.findByMemberId(memberId) != null) return
+        pointWalletRepository.saveAndFlush(PointWallet(memberId))
+    }
+}
