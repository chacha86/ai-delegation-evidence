+++ b/src/test/kotlin/com/rest1/domain/point/point/service/PointServiceConcurrencyTest.kt
@@ -0,0 +1,136 @@
+package com.rest1.domain.point.point.service
+
+import com.rest1.domain.member.member.service.MemberService
+import com.rest1.domain.point.point.repository.PointHistoryRepository
+import com.rest1.global.exception.ServiceException
+import org.assertj.core.api.Assertions.assertThat
+import org.junit.jupiter.api.DisplayName
+import org.junit.jupiter.api.Test
+import org.springframework.beans.factory.annotation.Autowired
+import org.springframework.boot.test.context.SpringBootTest
+import org.springframework.test.annotation.DirtiesContext
+import org.springframework.test.context.ActiveProfiles
+import java.util.concurrent.CountDownLatch
+import java.util.concurrent.Executors
+import java.util.concurrent.TimeUnit
+import java.util.concurrent.atomic.AtomicInteger
+
+// 실제 커밋이 일어나야 하므로 @Transactional 을 붙이지 않는다.
+// 커밋된 포인트 데이터가 다른 테스트에 남지 않도록 이 클래스가 끝나면 컨텍스트(메모리 DB)를 버린다.
+@SpringBootTest
+@ActiveProfiles("test")
+@DirtiesContext(classMode = DirtiesContext.ClassMode.AFTER_CLASS)
+class PointServiceConcurrencyTest {
+    @Autowired
+    private lateinit var pointService: PointService
+
+    @Autowired
+    private lateinit var memberService: MemberService
+
+    @Autowired
+    private lateinit var pointHistoryRepository: PointHistoryRepository
+
+    private fun runConcurrently(count: Int, task: (Int) -> Unit): Map<String, Int> {
+        val pool = Executors.newFixedThreadPool(count)
+        val start = CountDownLatch(1)
+        val done = CountDownLatch(count)
+        val results = java.util.concurrent.ConcurrentHashMap<String, AtomicInteger>()
+
+        repeat(count) { i ->
+            pool.submit {
+                try {
+                    start.await()
+                    task(i)
+                    results.computeIfAbsent("ok") { AtomicInteger() }.incrementAndGet()
+                } catch (e: ServiceException) {
+                    results.computeIfAbsent(e.resultCode) { AtomicInteger() }.incrementAndGet()
+                } catch (e: Exception) {
+                    results.computeIfAbsent(e.javaClass.simpleName) { AtomicInteger() }.incrementAndGet()
+                } finally {
+                    done.countDown()
+                }
+            }
+        }
+
+        start.countDown()
+        assertThat(done.await(60, TimeUnit.SECONDS)).isTrue()
+        pool.shutdown()
+
+        return results.mapValues { it.value.get() }
+    }
+
+    @Test
+    @DisplayName("동시에 선물해도 잔액이 음수가 되거나 포인트가 새로 생기거나 사라지지 않는다")
+    fun t1() {
+        val a = memberService.join("concA", "1234", "동시A")
+        val b = memberService.join("concB", "1234", "동시B")
+
+        // 1,000P 선물 = 1,500P 차감. 10번만 성공할 수 있는 잔액
+        pointService.charge(a.id!!, 15_000)
+        pointService.charge(b.id!!, 15_000)
+
+        val results = runConcurrently(30) { i ->
+            // 서로에게 동시에 보내 교착 가능성도 확인
+            if (i % 2 == 0) pointService.transfer(a.id!!, "concB", 1_000)
+            else pointService.transfer(b.id!!, "concA", 1_000)
+        }
+
+        println("concurrency results = $results")
+
+        val balanceA = pointService.getBalance(a.id!!)
+        val balanceB = pointService.getBalance(b.id!!)
+        val succeeded = results["ok"] ?: 0
+        val totalFee = pointHistoryRepository.findAll().sumOf { it.fee }
+
+        assertThat(balanceA).isGreaterThanOrEqualTo(0)
+        assertThat(balanceB).isGreaterThanOrEqualTo(0)
+        // 포인트 보존: 충전 총액 = 두 사람 잔액 + 걷힌 수수료
+        assertThat(balanceA + balanceB + totalFee).isEqualTo(30_000)
+        assertThat(totalFee).isEqualTo(succeeded * 500L)
+        // 실패는 잔액 부족(400-5) 또는 잠금 실패만 허용
+        assertThat(results.keys - setOf("ok", "400-5", "PessimisticLockingFailureException", "CannotAcquireLockException"))
+            .isEmpty()
+    }
+
+    @Test
+    @DisplayName("한 사람이 동시에 여러 번 선물하면 잔액 범위 안에서만 성공한다")
+    fun t3() {
+        val e = memberService.join("concE", "1234", "동시E")
+        val f = memberService.join("concF", "1234", "동시F")
+
+        // 1,000P 선물 = 1,500P 차감 → 15,000P 로는 정확히 10번만 가능
+        pointService.charge(e.id!!, 15_000)
+
+        val results = runConcurrently(30) {
+            pointService.transfer(e.id!!, "concF", 1_000)
+        }
+
+        println("one-way concurrency results = $results")
+
+        assertThat(results["ok"]).isEqualTo(10)
+        assertThat(results["400-5"]).isEqualTo(20)
+        assertThat(pointService.getBalance(e.id!!)).isEqualTo(0)
+        assertThat(pointService.getBalance(f.id!!)).isEqualTo(10_000)
+    }
+
+    @Test
+    @DisplayName("동시에 선물해도 1일 한도를 넘지 않는다")
+    fun t2() {
+        val c = memberService.join("concC", "1234", "동시C")
+        memberService.join("concD", "1234", "동시D")
+
+        pointService.charge(c.id!!, 100_000_000)
+
+        // 2,000,000P x 10 건 = 2,000만P 시도 → 한도 1,000만P 이므로 최대 5건만 성공해야 한다
+        val results = runConcurrently(10) {
+            pointService.transfer(c.id!!, "concD", 2_000_000)
+        }
+
+        println("daily limit concurrency results = $results")
+
+        val received = pointService.getBalance(memberService.findByUsername("concD")!!.id!!)
+        assertThat(results["ok"]).isEqualTo(5)
+        assertThat(results["400-6"]).isEqualTo(5)
+        assertThat(received).isEqualTo(PointService.DAILY_TRANSFER_LIMIT)
+    }
+}
