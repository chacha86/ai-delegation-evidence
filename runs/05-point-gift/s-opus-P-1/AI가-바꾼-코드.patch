@@ -0,0 +1,142 @@
+package com.rest1.domain.point.point.controller
+
+import com.rest1.domain.point.point.service.PointService
+import com.rest1.global.exception.ServiceException
+import com.rest1.global.rq.Rq
+import com.rest1.global.rsData.RsData
+import io.swagger.v3.oas.annotations.Operation
+import io.swagger.v3.oas.annotations.security.SecurityRequirement
+import io.swagger.v3.oas.annotations.tags.Tag
+import jakarta.validation.Valid
+import jakarta.validation.constraints.NotBlank
+import jakarta.validation.constraints.NotNull
+import org.springframework.dao.PessimisticLockingFailureException
+import org.springframework.web.bind.annotation.ExceptionHandler
+import org.springframework.web.bind.annotation.GetMapping
+import org.springframework.web.bind.annotation.PostMapping
+import org.springframework.web.bind.annotation.RequestBody
+import org.springframework.web.bind.annotation.RequestMapping
+import org.springframework.web.bind.annotation.ResponseBody
+import org.springframework.web.bind.annotation.RestController
+import java.math.BigDecimal
+
+@RestController
+@RequestMapping("/api/v1/points")
+@Tag(name = "ApiV1PointController", description = "포인트 API")
+@SecurityRequirement(name = "bearerAuth")
+class ApiV1PointController(
+    private val pointService: PointService,
+    private val rq: Rq,
+) {
+    data class PointBalanceResBody(
+        val memberId: Long,
+        val username: String,
+        val balance: Long,
+    )
+
+    // 기존 GET API(글 조회 등)처럼 DTO 를 그대로 반환한다 → 응답 JSON 최상위에 balance 필드
+    @GetMapping
+    @Operation(summary = "내 포인트 잔액 조회")
+    fun getBalance(): PointBalanceResBody {
+        val actor = rq.actor
+
+        return PointBalanceResBody(
+            actor.id!!,
+            actor.username,
+            pointService.getBalance(actor.id!!),
+        )
+    }
+
+    // 금액을 BigDecimal 로 받는 이유: Long 으로 받으면 Jackson 이 1000.5 를 1000 으로 조용히 잘라버린다.
+    // 필드를 nullable 로 두는 이유는 ApiV1MemberController.JoinReqBody 주석 참고
+    data class PointChargeReqBody(
+        @field:NotNull
+        val amount: BigDecimal?,
+    )
+
+    data class PointChargeResBody(
+        val amount: Long,
+        val balance: Long,
+    )
+
+    @PostMapping("/charge")
+    @Operation(summary = "포인트 충전 (테스트용)")
+    fun charge(
+        @RequestBody @Valid reqBody: PointChargeReqBody,
+    ): RsData<PointChargeResBody> {
+        val actor = rq.actor
+        val amount = toPointAmount(reqBody.amount!!)
+
+        val balance = pointService.charge(actor.id!!, amount)
+
+        return RsData(
+            "200-1",
+            "${amount}P가 충전되었습니다.",
+            PointChargeResBody(amount, balance),
+        )
+    }
+
+    data class PointTransferReqBody(
+        @field:NotBlank
+        val toUsername: String?,
+        @field:NotNull
+        val amount: BigDecimal?,
+    )
+
+    data class PointTransferResBody(
+        val toUsername: String,
+        val amount: Long,
+        val fee: Long,
+        val totalDeducted: Long,
+        val balance: Long,
+        val todayTransferredAmount: Long,
+        val dailyLimit: Long,
+    )
+
+    @PostMapping("/transfer")
+    @Operation(summary = "포인트 선물하기")
+    fun transfer(
+        @RequestBody @Valid reqBody: PointTransferReqBody,
+    ): RsData<PointTransferResBody> {
+        val actor = rq.actor
+        val amount = toPointAmount(reqBody.amount!!)
+
+        val result = pointService.transfer(actor.id!!, reqBody.toUsername!!.trim(), amount)
+
+        return RsData(
+            "200-1",
+            "${result.toUsername}님에게 ${result.amount}P를 선물했습니다. (수수료 ${result.fee}P)",
+            PointTransferResBody(
+                toUsername = result.toUsername,
+                amount = result.amount,
+                fee = result.fee,
+                totalDeducted = result.totalDeducted,
+                balance = result.balance,
+                todayTransferredAmount = result.todayTransferredAmount,
+                dailyLimit = PointService.DAILY_TRANSFER_LIMIT,
+            ),
+        )
+    }
+
+    // 동시에 같은 회원의 포인트를 바꾸는 요청이 몰려 행 잠금을 제때 얻지 못한 경우
+    @ExceptionHandler(PessimisticLockingFailureException::class)
+    @ResponseBody
+    fun handleLockFailure(e: PessimisticLockingFailureException): RsData<Void> {
+        return RsData(
+            "409-1",
+            "요청이 몰려 처리하지 못했습니다. 잠시 후 다시 시도해주세요.",
+        )
+    }
+
+    private fun toPointAmount(amount: BigDecimal): Long {
+        if (amount.stripTrailingZeros().scale() > 0) {
+            throw ServiceException("400-3", "포인트 금액은 정수여야 합니다.")
+        }
+
+        return try {
+            amount.longValueExact()
+        } catch (e: ArithmeticException) {
+            throw ServiceException("400-3", "포인트 금액이 너무 큽니다.")
+        }
+    }
+}
