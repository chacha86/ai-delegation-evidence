+package com.rest1.domain.point.point.service
+
+import org.assertj.core.api.Assertions.assertThat
+import org.assertj.core.api.Assertions.assertThatThrownBy
+import org.junit.jupiter.api.DisplayName
+import org.junit.jupiter.api.Test
+
+class PointFeePolicyTest {
+    @Test
+    @DisplayName("수수료 구간 경계값")
+    fun t1() {
+        val cases = mapOf(
+            1_000L to 500L,
+            10_000L to 500L, // 1만P 까지 500P (이하로 해석)
+            10_001L to 1_000L,
+            100_000L to 1_000L, // 10만P 까지 1,000P (이하로 해석)
+            100_001L to 100L, // 그 이상은 0.1% → 100.001 → 10P 미만 절사 → 100P (기획서 문구 그대로)
+            109_999L to 100L,
+            110_000L to 110L,
+            1_234_567L to 1_230L, // 1234.567 → 1230
+            4_999_999L to 4_990L,
+            5_000_000L to 5_000L,
+            5_000_001L to 5_000L, // 최대 5,000P
+            10_000_000L to 5_000L,
+        )
+
+        cases.forEach { (amount, expectedFee) ->
+            assertThat(PointFeePolicy.calculate(amount))
+                .`as`("amount=%d", amount)
+                .isEqualTo(expectedFee)
+        }
+    }
+
+    @Test
+    @DisplayName("수수료는 항상 10P 단위")
+    fun t2() {
+        (1_000L..3_000_000L step 997).forEach {
+            assertThat(PointFeePolicy.calculate(it) % 10).isZero()
+        }
+    }
+
+    @Test
+    @DisplayName("0 이하 금액은 계산하지 않는다")
+    fun t3() {
+        assertThatThrownBy { PointFeePolicy.calculate(0) }.isInstanceOf(IllegalArgumentException::class.java)
+        assertThatThrownBy { PointFeePolicy.calculate(-1) }.isInstanceOf(IllegalArgumentException::class.java)
+    }
+}
