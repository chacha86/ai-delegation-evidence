+package com.rest1.domain.point.point.service
+
+/**
+ * 포인트 선물 수수료 정책 (기획서 v1.2)
+ *
+ * - 선물 금액 10,000P 이하      : 500P
+ * - 선물 금액 100,000P 이하     : 1,000P
+ * - 선물 금액 100,000P 초과     : 선물 금액의 0.1%, 10P 미만 절사, 최대 5,000P
+ *
+ * 주의: 기획서 문구를 그대로 따르면 100,000P 까지는 1,000P 인데 100,001P 부터는 0.1%(=100P) 가 되어
+ * 금액이 커질수록 수수료가 오히려 줄어드는 구간(100,001P ~ 999,999P)이 생긴다.
+ * 기획 의도 확인이 필요하지만, 사용자에게 기획서보다 많은 수수료를 받지 않도록 문구 그대로 구현했다.
+ */
+object PointFeePolicy {
+    const val TIER1_MAX_AMOUNT = 10_000L
+    const val TIER1_FEE = 500L
+    const val TIER2_MAX_AMOUNT = 100_000L
+    const val TIER2_FEE = 1_000L
+    const val MAX_FEE = 5_000L
+
+    fun calculate(amount: Long): Long {
+        require(amount > 0) { "선물 금액은 0보다 커야 합니다." }
+
+        return when {
+            amount <= TIER1_MAX_AMOUNT -> TIER1_FEE
+            amount <= TIER2_MAX_AMOUNT -> TIER2_FEE
+            // 0.1% = amount / 1000, 거기서 10P 미만 절사 = (amount / 1000) / 10 * 10 = amount / 10000 * 10
+            else -> minOf(amount / 10_000 * 10, MAX_FEE)
+        }
+    }
+}
