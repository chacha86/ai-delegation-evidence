+package com.rest1.domain.point.point.entity
+
+import com.rest1.global.exception.ServiceException
+import com.rest1.global.jpa.entity.BaseEntity
+import jakarta.persistence.Column
+import jakarta.persistence.Entity
+
+/**
+ * 회원 1명당 1개의 포인트 지갑.
+ *
+ * Member 엔티티에 컬럼을 추가하지 않고 별도 테이블로 둔다.
+ * (기존 회원 행/DTO/JWT 인증 흐름에 영향을 주지 않기 위해)
+ * 지갑은 처음 충전하거나 선물을 받을 때 만들어지고, 지갑이 없으면 잔액은 0 이다.
+ */
+@Entity
+class PointWallet(
+    @Column(name = "member_id", unique = true, nullable = false, updatable = false)
+    val memberId: Long,
+) : BaseEntity() {
+    @Column(nullable = false)
+    var balance: Long = 0
+        protected set
+
+    fun deposit(amount: Long) {
+        require(amount > 0) { "입금액은 0보다 커야 합니다." }
+
+        balance = try {
+            Math.addExact(balance, amount)
+        } catch (e: ArithmeticException) {
+            throw ServiceException("400-7", "보유 가능한 포인트 한도를 초과합니다.")
+        }
+    }
+
+    fun withdraw(amount: Long) {
+        require(amount > 0) { "출금액은 0보다 커야 합니다." }
+
+        if (balance < amount) {
+            throw ServiceException("400-5", "포인트 잔액이 부족합니다.")
+        }
+
+        balance -= amount
+    }
+}
