@@ -0,0 +1,143 @@
+package com.rest1.domain.point.point.service
+
+import com.rest1.domain.member.member.entity.Member
+import com.rest1.domain.member.member.repository.MemberRepository
+import com.rest1.domain.point.point.config.PointConfig
+import com.rest1.domain.point.point.entity.PointHistory
+import com.rest1.domain.point.point.entity.PointHistoryType
+import com.rest1.domain.point.point.entity.PointWallet
+import com.rest1.domain.point.point.repository.PointHistoryRepository
+import com.rest1.domain.point.point.repository.PointWalletRepository
+import com.rest1.global.exception.ServiceException
+import org.springframework.stereotype.Service
+import org.springframework.transaction.annotation.Transactional
+import java.time.Clock
+import java.time.Instant
+import java.time.LocalDate
+
+@Service
+class PointService(
+    private val memberRepository: MemberRepository,
+    private val pointWalletRepository: PointWalletRepository,
+    private val pointHistoryRepository: PointHistoryRepository,
+    private val pointClock: Clock,
+) {
+    companion object {
+        const val MIN_TRANSFER_AMOUNT = 1_000L
+        const val DAILY_TRANSFER_LIMIT = 10_000_000L
+
+        // 테스트용 충전 1회 상한 (기획서에 없음. 잘못된 입력으로 잔액이 비정상적으로 커지는 것을 막기 위한 값)
+        const val MAX_CHARGE_AMOUNT = 1_000_000_000L
+    }
+
+    data class TransferResult(
+        val toUsername: String,
+        val amount: Long,
+        val fee: Long,
+        val totalDeducted: Long,
+        val balance: Long,
+        val todayTransferredAmount: Long,
+    )
+
+    @Transactional(readOnly = true)
+    fun getBalance(memberId: Long): Long =
+        pointWalletRepository.findByMemberId(memberId)?.balance ?: 0L
+
+    @Transactional
+    fun charge(memberId: Long, amount: Long): Long {
+        if (amount <= 0) {
+            throw ServiceException("400-3", "충전 금액은 1P 이상이어야 합니다.")
+        }
+        if (amount > MAX_CHARGE_AMOUNT) {
+            throw ServiceException("400-3", "1회 충전 금액은 ${MAX_CHARGE_AMOUNT}P 이하여야 합니다.")
+        }
+
+        lockMember(memberId)
+
+        val wallet = getOrCreateLockedWallet(memberId)
+        wallet.deposit(amount)
+
+        pointHistoryRepository.save(
+            PointHistory(PointHistoryType.CHARGE, null, memberId, amount, 0, Instant.now(pointClock))
+        )
+
+        return wallet.balance
+    }
+
+    @Transactional
+    fun transfer(senderId: Long, toUsername: String, amount: Long): TransferResult {
+        if (amount < MIN_TRANSFER_AMOUNT) {
+            throw ServiceException("400-3", "최소 선물 금액은 ${MIN_TRANSFER_AMOUNT}P 입니다.")
+        }
+        if (amount > DAILY_TRANSFER_LIMIT) {
+            throw ServiceException("400-6", "1일 선물 한도(${DAILY_TRANSFER_LIMIT}P)를 초과합니다.")
+        }
+
+        val receiver = memberRepository.findByUsername(toUsername).orElse(null)
+            ?: throw ServiceException("404-2", "받는 회원이 존재하지 않습니다.")
+        val receiverId = receiver.id!!
+
+        if (receiverId == senderId) {
+            throw ServiceException("400-4", "자기 자신에게는 선물할 수 없습니다.")
+        }
+
+        // 서로에게 동시에 선물할 때 교착을 피하기 위해 항상 id 오름차순으로 잠근다
+        listOf(senderId, receiverId).sorted().forEach { lockMember(it) }
+
+        val now = Instant.now(pointClock)
+        val todayTransferred = todayTransferredAmount(senderId, now)
+
+        if (todayTransferred + amount > DAILY_TRANSFER_LIMIT) {
+            throw ServiceException(
+                "400-6",
+                "1일 선물 한도(${DAILY_TRANSFER_LIMIT}P)를 초과합니다. 오늘 남은 한도는 ${DAILY_TRANSFER_LIMIT - todayTransferred}P 입니다.",
+            )
+        }
+
+        val fee = PointFeePolicy.calculate(amount)
+        val totalDeducted = amount + fee
+
+        val senderWallet = pointWalletRepository.findByMemberIdForUpdate(senderId)
+        if (senderWallet == null || senderWallet.balance < totalDeducted) {
+            throw ServiceException(
+                "400-5",
+                "포인트 잔액이 부족합니다. (필요: ${totalDeducted}P = 선물 ${amount}P + 수수료 ${fee}P, 보유: ${senderWallet?.balance ?: 0}P)",
+            )
+        }
+
+        val receiverWallet = getOrCreateLockedWallet(receiverId)
+
+        senderWallet.withdraw(totalDeducted)
+        receiverWallet.deposit(amount)
+
+        pointHistoryRepository.save(
+            PointHistory(PointHistoryType.TRANSFER, senderId, receiverId, amount, fee, now)
+        )
+
+        return TransferResult(
+            toUsername = receiver.username,
+            amount = amount,
+            fee = fee,
+            totalDeducted = totalDeducted,
+            balance = senderWallet.balance,
+            todayTransferredAmount = todayTransferred + amount,
+        )
+    }
+
+    private fun todayTransferredAmount(senderId: Long, now: Instant): Long {
+        val today = LocalDate.ofInstant(now, PointConfig.POINT_ZONE)
+        val from = today.atStartOfDay(PointConfig.POINT_ZONE).toInstant()
+        val to = today.plusDays(1).atStartOfDay(PointConfig.POINT_ZONE).toInstant()
+
+        return pointHistoryRepository.sumAmountBySender(PointHistoryType.TRANSFER, senderId, from, to)
+    }
+
+    private fun lockMember(memberId: Long): Member =
+        memberRepository.findByIdForUpdate(memberId)
+            ?: throw ServiceException("404-1", "존재하지 않는 회원입니다.")
+
+    // 반드시 lockMember(memberId) 이후에 호출한다. 회원 잠금 덕분에 같은 회원의 지갑이 동시에 두 번 만들어지지 않는다.
+    private fun getOrCreateLockedWallet(memberId: Long): PointWallet =
+        pointWalletRepository.findByMemberIdForUpdate(memberId)
+            ?: pointWalletRepository.save(PointWallet(memberId))
+}
