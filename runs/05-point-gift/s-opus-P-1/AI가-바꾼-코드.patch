+package com.rest1.domain.point.point.entity
+
+import com.rest1.global.jpa.entity.BaseEntity
+import jakarta.persistence.Column
+import jakarta.persistence.Entity
+import jakarta.persistence.EnumType
+import jakarta.persistence.Enumerated
+import jakarta.persistence.Index
+import jakarta.persistence.Table
+import java.time.Instant
+
+enum class PointHistoryType {
+    CHARGE,
+    TRANSFER,
+}
+
+/**
+ * 포인트 변동 이력(원장).
+ *
+ * - CHARGE   : senderId = null, receiverId = 충전한 회원, fee = 0
+ * - TRANSFER : senderId = 보낸 회원, receiverId = 받은 회원, amount = 선물 금액, fee = 보낸 회원이 추가로 낸 수수료
+ *
+ * 수수료는 보낸 회원 잔액에서 (amount + fee) 를 빼고 받은 회원에게 amount 만 더하는 방식으로 걷는다.
+ * 걷은 수수료의 합계는 이 테이블의 fee 합으로 알 수 있다.
+ *
+ * 1일 선물 한도 계산에 쓰기 위해 시각은 타임존 문제가 없는 Instant 로 별도 저장한다.
+ */
+@Entity
+@Table(
+    indexes = [
+        Index(name = "idx_point_history_sender_created", columnList = "sender_id, created_at"),
+    ],
+)
+class PointHistory(
+    @Enumerated(EnumType.STRING)
+    @Column(nullable = false, length = 20, updatable = false)
+    val type: PointHistoryType,
+    @Column(name = "sender_id", updatable = false)
+    val senderId: Long?,
+    @Column(name = "receiver_id", nullable = false, updatable = false)
+    val receiverId: Long,
+    @Column(nullable = false, updatable = false)
+    val amount: Long,
+    @Column(nullable = false, updatable = false)
+    val fee: Long,
+    @Column(name = "created_at", nullable = false, updatable = false)
+    val createdAt: Instant,
+) : BaseEntity()
