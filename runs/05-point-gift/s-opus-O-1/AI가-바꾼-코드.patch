+package com.rest1.domain.point.point.entity
+
+import com.rest1.domain.member.member.entity.Member
+import com.rest1.global.exception.ServiceException
+import com.rest1.global.jpa.entity.BaseEntity
+import jakarta.persistence.Entity
+import jakarta.persistence.FetchType
+import jakarta.persistence.JoinColumn
+import jakarta.persistence.OneToOne
+import java.time.LocalDate
+
+// 회원별 포인트 잔액. Member 에 두지 않는 이유: JWT 인증 시 DB 조회 없이 만드는
+// Member(id, username, nickname) 객체에는 잔액이 없어 잘못 읽힐 위험이 있다.
+@Entity
+class PointWallet(
+    @OneToOne(fetch = FetchType.LAZY)
+    @JoinColumn(unique = true, nullable = false)
+    val member: Member,
+) : BaseEntity() {
+    var balance: Long = 0
+        protected set
+
+    // 1일 선물 한도용 누계. 잠근 지갑 행 안에 두어 동시 선물에도 한도 계산이 어긋나지 않게 한다.
+    var dailyTransferDate: LocalDate? = null
+        protected set
+
+    var dailyTransferAmount: Long = 0
+        protected set
+
+    fun deposit(amount: Long) {
+        require(amount > 0) { "amount must be positive: $amount" }
+
+        balance = Math.addExact(balance, amount)
+    }
+
+    fun withdraw(amount: Long) {
+        require(amount > 0) { "amount must be positive: $amount" }
+
+        if (balance < amount) {
+            throw ServiceException("400-4", "포인트 잔액이 부족합니다.")
+        }
+
+        balance -= amount
+    }
+
+    fun transferredAmountOn(date: LocalDate): Long =
+        if (dailyTransferDate == date) dailyTransferAmount else 0L
+
+    fun addTransferredAmount(date: LocalDate, amount: Long) {
+        dailyTransferAmount = transferredAmountOn(date) + amount
+        dailyTransferDate = date
+    }
+}
