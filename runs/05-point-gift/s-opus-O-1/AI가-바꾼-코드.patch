+package com.rest1.domain.point.point.controller
+
+import com.rest1.domain.point.point.service.PointService
+import com.rest1.global.rq.Rq
+import com.rest1.global.rsData.RsData
+import io.swagger.v3.oas.annotations.Operation
+import io.swagger.v3.oas.annotations.security.SecurityRequirement
+import io.swagger.v3.oas.annotations.tags.Tag
+import jakarta.validation.Valid
+import jakarta.validation.constraints.Digits
+import jakarta.validation.constraints.NotBlank
+import jakarta.validation.constraints.NotNull
+import jakarta.validation.constraints.Positive
+import org.springframework.web.bind.annotation.GetMapping
+import org.springframework.web.bind.annotation.PostMapping
+import org.springframework.web.bind.annotation.RequestBody
+import org.springframework.web.bind.annotation.RequestMapping
+import org.springframework.web.bind.annotation.RestController
+import java.math.BigDecimal
+
+@RestController
+@RequestMapping("/api/v1/points")
+@Tag(name = "ApiV1PointController", description = "포인트 API")
+@SecurityRequirement(name = "bearerAuth")
+class ApiV1PointController(
+    private val pointService: PointService,
+    private val rq: Rq,
+) {
+    data class BalanceResBody(
+        val balance: Long,
+    )
+
+    @GetMapping
+    @Operation(summary = "내 포인트 잔액 조회")
+    fun getBalance(): BalanceResBody {
+        return BalanceResBody(pointService.getBalance(rq.actor.id!!))
+    }
+
+    // 필드를 nullable 로 두는 이유는 ApiV1MemberController.JoinReqBody 주석 참고.
+    // amount 를 BigDecimal 로 받는 이유: Long 으로 받으면 Jackson 이 1000.5 를 1000 으로
+    // 조용히 잘라 버리므로, 소수 입력을 400 으로 거절하기 위해서다.
+    data class ChargeReqBody(
+        @field:NotNull
+        @field:Positive
+        @field:Digits(integer = 18, fraction = 0)
+        val amount: BigDecimal?,
+    )
+
+    @PostMapping("/charge")
+    @Operation(summary = "포인트 충전 (테스트용)")
+    fun charge(
+        @RequestBody @Valid reqBody: ChargeReqBody,
+    ): RsData<BalanceResBody> {
+        val balance = pointService.charge(rq.actor.id!!, reqBody.amount!!.longValueExact())
+
+        return RsData(
+            "200-1",
+            "${"%,d".format(reqBody.amount.longValueExact())}P 가 충전되었습니다.",
+            BalanceResBody(balance),
+        )
+    }
+
+    data class TransferReqBody(
+        @field:NotBlank
+        val toUsername: String?,
+        @field:NotNull
+        @field:Positive
+        @field:Digits(integer = 18, fraction = 0)
+        val amount: BigDecimal?,
+    )
+
+    data class TransferResBody(
+        val transferId: Long,
+        val toUsername: String,
+        val amount: Long,
+        val fee: Long,
+        val balance: Long,
+    )
+
+    @PostMapping("/transfer")
+    @Operation(summary = "포인트 선물하기")
+    fun transfer(
+        @RequestBody @Valid reqBody: TransferReqBody,
+    ): RsData<TransferResBody> {
+        val toUsername = reqBody.toUsername!!
+        val amount = reqBody.amount!!.longValueExact()
+
+        val result = pointService.transfer(rq.actor.id!!, toUsername, amount)
+        val transfer = result.transfer
+
+        return RsData(
+            "201-1",
+            "${toUsername}님에게 ${"%,d".format(transfer.amount)}P 를 선물했습니다. (수수료 ${"%,d".format(transfer.fee)}P)",
+            TransferResBody(
+                transfer.id!!,
+                toUsername,
+                transfer.amount,
+                transfer.fee,
+                result.senderBalance,
+            ),
+        )
+    }
+}
