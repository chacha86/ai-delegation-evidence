+package com.rest1.domain.point.point.service
+
+import com.rest1.domain.member.member.entity.Member
+import com.rest1.domain.member.member.repository.MemberRepository
+import com.rest1.domain.point.point.entity.PointTransfer
+import com.rest1.domain.point.point.entity.PointWallet
+import com.rest1.domain.point.point.repository.PointTransferRepository
+import com.rest1.domain.point.point.repository.PointWalletRepository
+import com.rest1.global.exception.ServiceException
+import org.springframework.stereotype.Service
+import org.springframework.transaction.annotation.Transactional
+import java.time.LocalDate
+
+@Service
+class PointService(
+    private val memberRepository: MemberRepository,
+    private val pointWalletRepository: PointWalletRepository,
+    private val pointTransferRepository: PointTransferRepository,
+) {
+    data class TransferResult(
+        val transfer: PointTransfer,
+        val senderBalance: Long,
+    )
+
+    // 지갑이 아직 없는 회원은 잔액 0 으로 본다 (조회만으로 지갑을 만들지 않는다)
+    @Transactional(readOnly = true)
+    fun getBalance(memberId: Long): Long =
+        pointWalletRepository.findByMemberId(memberId)?.balance ?: 0L
+
+    @Transactional
+    fun charge(memberId: Long, amount: Long): Long {
+        if (amount <= 0 || amount > PointPolicy.MAX_CHARGE_AMOUNT) {
+            throw ServiceException(
+                "400-3",
+                "충전 금액은 1P 이상 ${"%,d".format(PointPolicy.MAX_CHARGE_AMOUNT)}P 이하여야 합니다.",
+            )
+        }
+
+        val member = lockMember(memberId)
+        val wallet = getOrCreateWallet(member)
+
+        wallet.deposit(amount)
+
+        return wallet.balance
+    }
+
+    @Transactional
+    fun transfer(senderId: Long, toUsername: String, amount: Long): TransferResult {
+        if (amount < PointPolicy.MIN_TRANSFER_AMOUNT) {
+            throw ServiceException(
+                "400-3",
+                "최소 선물 금액은 ${"%,d".format(PointPolicy.MIN_TRANSFER_AMOUNT)}P 입니다.",
+            )
+        }
+
+        val receiverId = memberRepository.findByUsername(toUsername).orElse(null)?.id
+            ?: throw ServiceException("404-2", "존재하지 않는 회원입니다.")
+
+        if (receiverId == senderId) {
+            throw ServiceException("400-5", "자기 자신에게는 선물할 수 없습니다.")
+        }
+
+        // 두 회원을 항상 id 오름차순으로 잠가 맞선물(A->B, B->A) 동시 요청 시 데드락을 막는다
+        val locked = listOf(senderId, receiverId).sorted().associateWith { lockMember(it) }
+        val sender = locked.getValue(senderId)
+        val receiver = locked.getValue(receiverId)
+
+        val senderWallet = getOrCreateWallet(sender)
+        val receiverWallet = getOrCreateWallet(receiver)
+
+        val today = LocalDate.now()
+        val todayTotal = senderWallet.transferredAmountOn(today)
+
+        if (todayTotal + amount > PointPolicy.DAILY_TRANSFER_LIMIT) {
+            val remaining = maxOf(PointPolicy.DAILY_TRANSFER_LIMIT - todayTotal, 0)
+
+            throw ServiceException(
+                "400-6",
+                "1일 선물 한도(${"%,d".format(PointPolicy.DAILY_TRANSFER_LIMIT)}P)를 초과합니다. 오늘 남은 한도는 ${"%,d".format(remaining)}P 입니다.",
+            )
+        }
+
+        val fee = PointPolicy.calcFee(amount)
+
+        senderWallet.withdraw(amount + fee)
+        senderWallet.addTransferredAmount(today, amount)
+        receiverWallet.deposit(amount)
+
+        val transfer = pointTransferRepository.save(PointTransfer(sender, receiver, amount, fee))
+
+        return TransferResult(transfer, senderWallet.balance)
+    }
+
+    private fun lockMember(memberId: Long): Member =
+        memberRepository.findByIdForUpdate(memberId)
+            ?: throw ServiceException("404-2", "존재하지 않는 회원입니다.")
+
+    // 반드시 lockMember 로 해당 회원을 잠근 뒤 호출한다 (지갑 중복 생성 방지)
+    private fun getOrCreateWallet(member: Member): PointWallet =
+        pointWalletRepository.findByMemberIdForUpdate(member.id!!)
+            ?: pointWalletRepository.save(PointWallet(member))
+}
