+package com.rest1.domain.point.point.service
+
+import org.assertj.core.api.Assertions.assertThat
+import org.assertj.core.api.Assertions.assertThatThrownBy
+import org.junit.jupiter.api.DisplayName
+import org.junit.jupiter.api.Test
+import org.junit.jupiter.params.ParameterizedTest
+import org.junit.jupiter.params.provider.CsvSource
+
+class PointPolicyTest {
+    @ParameterizedTest(name = "{0}P 선물 -> 수수료 {1}P")
+    @CsvSource(
+        // 1만P까지 500P
+        "1000, 500",
+        "10000, 500",
+        // 10만P까지 1,000P
+        "10001, 1000",
+        "100000, 1000",
+        // 그 이상은 0.1%, 10P 미만 절사
+        "100001, 100",
+        "123456, 120",
+        "123999, 120",
+        "999999, 990",
+        "1000000, 1000",
+        "1234567, 1230",
+        // 최대 5,000P
+        "5000000, 5000",
+        "5009999, 5000",
+        "10000000, 5000",
+    )
+    @DisplayName("수수료 계산")
+    fun calcFee(amount: Long, expectedFee: Long) {
+        assertThat(PointPolicy.calcFee(amount)).isEqualTo(expectedFee)
+    }
+
+    @Test
+    @DisplayName("수수료 계산, 0 이하 금액은 허용하지 않는다")
+    fun calcFeeNonPositive() {
+        assertThatThrownBy { PointPolicy.calcFee(0) }.isInstanceOf(IllegalArgumentException::class.java)
+        assertThatThrownBy { PointPolicy.calcFee(-1000) }.isInstanceOf(IllegalArgumentException::class.java)
+    }
+}
diff --git a/src/test/kotlin/com/rest1/domain/point/point/service/PointServiceConcurrencyTest.kt b/src/test/kotlin/com/rest1/domain/point/point/service/PointServiceConcurrencyTest.kt
new file mode 100644
index 0000000..4ea3131
--- /dev/null
+++ b/src/test/kotlin/com/rest1/domain/point/point/service/PointServiceConcurrencyTest.kt
@@ -0,0 +1,149 @@
+package com.rest1.domain.point.point.service
+
+import com.rest1.domain.member.member.repository.MemberRepository
+import com.rest1.domain.point.point.repository.PointTransferRepository
+import com.rest1.global.exception.ServiceException
+import org.assertj.core.api.Assertions.assertThat
+import org.junit.jupiter.api.DisplayName
+import org.junit.jupiter.api.Test
+import org.springframework.beans.factory.annotation.Autowired
+import org.springframework.boot.test.context.SpringBootTest
+import org.springframework.test.annotation.DirtiesContext
+import org.springframework.test.context.ActiveProfiles
+import java.util.concurrent.Callable
+import java.util.concurrent.CountDownLatch
+import java.util.concurrent.Executors
+import java.util.concurrent.atomic.AtomicInteger
+
+// 실제로 커밋되는 동시 요청을 검증하므로 @Transactional 을 붙이지 않는다.
+// 커밋된 데이터가 다른 테스트에 영향을 주지 않도록 테스트마다 컨텍스트(인메모리 DB)를 버린다.
+@SpringBootTest
+@ActiveProfiles("test")
+@DirtiesContext(classMode = DirtiesContext.ClassMode.AFTER_EACH_TEST_METHOD)
+class PointServiceConcurrencyTest {
+    @Autowired
+    private lateinit var pointService: PointService
+
+    @Autowired
+    private lateinit var memberRepository: MemberRepository
+
+    @Autowired
+    private lateinit var pointTransferRepository: PointTransferRepository
+
+    private fun idOf(username: String): Long = memberRepository.findByUsername(username).get().id!!
+
+    private fun runConcurrently(tasks: List<() -> Unit>): Pair<Int, Int> {
+        val pool = Executors.newFixedThreadPool(tasks.size)
+        val ready = CountDownLatch(1)
+        val success = AtomicInteger()
+        val rejected = AtomicInteger()
+
+        try {
+            val futures = tasks.map { task ->
+                pool.submit(Callable {
+                    ready.await()
+                    try {
+                        task()
+                        success.incrementAndGet()
+                    } catch (e: ServiceException) {
+                        rejected.incrementAndGet()
+                    }
+                })
+            }
+
+            ready.countDown()
+            futures.forEach { it.get() } // ServiceException 이외의 예외(데드락, 락 타임아웃 등)는 테스트 실패
+        } finally {
+            pool.shutdown()
+        }
+
+        return success.get() to rejected.get()
+    }
+
+    @Test
+    @DisplayName("동시에 선물해도 잔액 이상으로 빠져나가지 않는다")
+    fun noOverdraft() {
+        val user1 = idOf("user1")
+
+        pointService.charge(user1, 10_500)
+
+        // 1,000P 선물 = 1,500P 차감. 10,500P 로는 정확히 7번만 성공해야 한다.
+        val (success, rejected) = runConcurrently(
+            List(10) { { pointService.transfer(user1, "user2", 1_000); Unit } }
+        )
+
+        assertThat(success).isEqualTo(7)
+        assertThat(rejected).isEqualTo(3)
+        assertThat(pointService.getBalance(user1)).isEqualTo(0)
+        assertThat(pointService.getBalance(idOf("user2"))).isEqualTo(7_000)
+        assertThat(pointTransferRepository.count()).isEqualTo(7)
+    }
+
+    @Test
+    @DisplayName("서로에게 동시에 선물해도 데드락 없이 처리되고 포인트 총량은 수수료만큼만 줄어든다")
+    fun crossTransfer() {
+        val user1 = idOf("user1")
+        val user2 = idOf("user2")
+
+        pointService.charge(user1, 100_000)
+        pointService.charge(user2, 100_000)
+
+        val tasks = List(10) { i ->
+            if (i % 2 == 0) {
+                { pointService.transfer(user1, "user2", 1_000); Unit }
+            } else {
+                { pointService.transfer(user2, "user1", 1_000); Unit }
+            }
+        }
+
+        val (success, _) = runConcurrently(tasks)
+
+        assertThat(success).isEqualTo(10)
+
+        val totalFee = pointTransferRepository.findAll().sumOf { it.fee }
+
+        assertThat(totalFee).isEqualTo(10 * 500L)
+        assertThat(pointService.getBalance(user1) + pointService.getBalance(user2))
+            .isEqualTo(200_000L - totalFee)
+        assertThat(pointService.getBalance(user1)).isEqualTo(100_000L - 5 * 500L)
+    }
+
+    @Test
+    @DisplayName("동시에 선물해도 1일 한도를 넘지 않는다")
+    fun dailyLimit() {
+        val user1 = idOf("user1")
+
+        pointService.charge(user1, 100_000_000)
+
+        // 300만P x 5 = 1,500만P 시도. 한도 1,000만P 이므로 3번만 성공해야 한다.
+        val (success, rejected) = runConcurrently(
+            List(5) { { pointService.transfer(user1, "user2", 3_000_000); Unit } }
+        )
+
+        assertThat(success).isEqualTo(3)
+        assertThat(rejected).isEqualTo(2)
+        assertThat(pointService.getBalance(idOf("user2"))).isEqualTo(9_000_000)
+    }
+
+    @Test
+    @DisplayName("지갑이 없는 회원에게 동시에 충전/선물해도 지갑이 하나만 만들어진다")
+    fun walletCreatedOnce() {
+        val user1 = idOf("user1")
+        val user3 = idOf("user3")
+
+        pointService.charge(user1, 100_000)
+
+        val tasks = List(10) { i ->
+            if (i % 2 == 0) {
+                { pointService.transfer(user1, "user3", 1_000); Unit }
+            } else {
+                { pointService.charge(user3, 1_000); Unit }
+            }
+        }
+
+        val (success, _) = runConcurrently(tasks)
+
+        assertThat(success).isEqualTo(10)
+        assertThat(pointService.getBalance(user3)).isEqualTo(10_000)
+    }
+}
