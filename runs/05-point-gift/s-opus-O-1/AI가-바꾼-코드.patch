+package com.rest1.domain.point.point.controller
+
+import com.rest1.domain.point.point.repository.PointTransferRepository
+import org.assertj.core.api.Assertions.assertThat
+import org.junit.jupiter.api.DisplayName
+import org.junit.jupiter.api.Test
+import org.springframework.beans.factory.annotation.Autowired
+import org.springframework.boot.test.autoconfigure.web.servlet.AutoConfigureMockMvc
+import org.springframework.boot.test.context.SpringBootTest
+import org.springframework.http.MediaType
+import org.springframework.test.context.ActiveProfiles
+import org.springframework.test.web.servlet.MockMvc
+import org.springframework.test.web.servlet.ResultActions
+import org.springframework.test.web.servlet.request.MockMvcRequestBuilders.get
+import org.springframework.test.web.servlet.request.MockMvcRequestBuilders.post
+import org.springframework.test.web.servlet.result.MockMvcResultHandlers.print
+import org.springframework.test.web.servlet.result.MockMvcResultMatchers.handler
+import org.springframework.test.web.servlet.result.MockMvcResultMatchers.jsonPath
+import org.springframework.test.web.servlet.result.MockMvcResultMatchers.status
+import org.springframework.transaction.annotation.Transactional
+
+@SpringBootTest
+@ActiveProfiles("test")
+@AutoConfigureMockMvc
+@Transactional
+class ApiV1PointControllerTest {
+    @Autowired
+    private lateinit var mvc: MockMvc
+
+    @Autowired
+    private lateinit var pointTransferRepository: PointTransferRepository
+
+    // BaseInitData 에서 user1, user2 의 apiKey 를 아이디와 같게 만든다
+    private fun charge(apiKey: String, amountJson: String): ResultActions =
+        mvc.perform(
+            post("/api/v1/points/charge")
+                .header("Authorization", "Bearer $apiKey")
+                .contentType(MediaType.APPLICATION_JSON)
+                .content("""{"amount": $amountJson}""")
+        ).andDo(print())
+
+    private fun transfer(apiKey: String, toUsername: String, amountJson: String): ResultActions =
+        mvc.perform(
+            post("/api/v1/points/transfer")
+                .header("Authorization", "Bearer $apiKey")
+                .contentType(MediaType.APPLICATION_JSON)
+                .content("""{"toUsername": "$toUsername", "amount": $amountJson}""")
+        ).andDo(print())
+
+    private fun balanceOf(apiKey: String): Long {
+        val body = mvc.perform(
+            get("/api/v1/points")
+                .header("Authorization", "Bearer $apiKey")
+        )
+            .andExpect(status().isOk)
+            .andReturn()
+            .response
+            .contentAsString
+
+        return Regex(""""balance"\s*:\s*(\d+)""").find(body)!!.groupValues[1].toLong()
+    }
+
+    @Test
+    @DisplayName("잔액 조회, 충전한 적 없으면 0")
+    fun t1() {
+        mvc.perform(
+            get("/api/v1/points")
+                .header("Authorization", "Bearer user1")
+        )
+            .andDo(print())
+            .andExpect(handler().handlerType(ApiV1PointController::class.java))
+            .andExpect(handler().methodName("getBalance"))
+            .andExpect(status().isOk)
+            .andExpect(jsonPath("$.balance").value(0))
+    }
+
+    @Test
+    @DisplayName("잔액 조회, 로그인하지 않으면 401")
+    fun t2() {
+        mvc.perform(get("/api/v1/points"))
+            .andDo(print())
+            .andExpect(status().isUnauthorized)
+    }
+
+    @Test
+    @DisplayName("충전")
+    fun t3() {
+        charge("user1", "10000")
+            .andExpect(handler().methodName("charge"))
+            .andExpect(status().isOk)
+            .andExpect(jsonPath("$.resultCode").value("200-1"))
+            .andExpect(jsonPath("$.data.balance").value(10000))
+
+        charge("user1", "5000")
+            .andExpect(jsonPath("$.data.balance").value(15000))
+
+        assertThat(balanceOf("user1")).isEqualTo(15000)
+    }
+
+    @Test
+    @DisplayName("충전, 0 이하나 소수, 누락된 금액은 400")
+    fun t4() {
+        charge("user1", "0").andExpect(status().isBadRequest)
+        charge("user1", "-1000").andExpect(status().isBadRequest)
+        charge("user1", "1000.5").andExpect(status().isBadRequest)
+        charge("user1", "null").andExpect(status().isBadRequest)
+        charge("user1", "\"abc\"").andExpect(status().isBadRequest)
+
+        assertThat(balanceOf("user1")).isEqualTo(0)
+    }
+
+    @Test
+    @DisplayName("선물하기, 수수료는 보내는 사람이 부담하고 받는 사람은 선물 금액을 그대로 받는다")
+    fun t5() {
+        charge("user1", "20000")
+
+        transfer("user1", "user2", "10000")
+            .andExpect(handler().methodName("transfer"))
+            .andExpect(status().isCreated)
+            .andExpect(jsonPath("$.resultCode").value("201-1"))
+            .andExpect(jsonPath("$.data.toUsername").value("user2"))
+            .andExpect(jsonPath("$.data.amount").value(10000))
+            .andExpect(jsonPath("$.data.fee").value(500))
+            .andExpect(jsonPath("$.data.balance").value(9500))
+
+        assertThat(balanceOf("user1")).isEqualTo(9500)
+        assertThat(balanceOf("user2")).isEqualTo(10000)
+
+        val saved = pointTransferRepository.findAll().single()
+        assertThat(saved.amount).isEqualTo(10000)
