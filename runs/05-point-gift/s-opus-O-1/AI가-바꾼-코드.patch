+package com.rest1.domain.point.point.entity
+
+import com.rest1.domain.member.member.entity.Member
+import com.rest1.global.exception.ServiceException
+import org.assertj.core.api.Assertions.assertThat
+import org.assertj.core.api.Assertions.assertThatThrownBy
+import org.junit.jupiter.api.DisplayName
+import org.junit.jupiter.api.Test
+import java.time.LocalDate
+
+class PointWalletTest {
+    private fun wallet() = PointWallet(Member(1L, "user1", "유저1"))
+
+    @Test
+    @DisplayName("입금과 출금")
+    fun depositAndWithdraw() {
+        val wallet = wallet()
+
+        wallet.deposit(10_000)
+        wallet.withdraw(3_000)
+
+        assertThat(wallet.balance).isEqualTo(7_000)
+    }
+
+    @Test
+    @DisplayName("잔액보다 많이 출금하면 실패하고 잔액은 그대로다")
+    fun withdrawInsufficient() {
+        val wallet = wallet()
+        wallet.deposit(1_000)
+
+        assertThatThrownBy { wallet.withdraw(1_001) }
+            .isInstanceOf(ServiceException::class.java)
+            .hasMessageContaining("400-4")
+
+        assertThat(wallet.balance).isEqualTo(1_000)
+    }
+
+    @Test
+    @DisplayName("1일 선물 누계는 날짜가 바뀌면 0 부터 다시 센다")
+    fun dailyTransferAmountResetsByDate() {
+        val wallet = wallet()
+        val day1 = LocalDate.of(2026, 10, 19)
+        val day2 = day1.plusDays(1)
+
+        wallet.addTransferredAmount(day1, 3_000)
+        wallet.addTransferredAmount(day1, 2_000)
+
+        assertThat(wallet.transferredAmountOn(day1)).isEqualTo(5_000)
+        assertThat(wallet.transferredAmountOn(day2)).isEqualTo(0)
+
+        wallet.addTransferredAmount(day2, 1_000)
+
+        assertThat(wallet.transferredAmountOn(day2)).isEqualTo(1_000)
+    }
+}
