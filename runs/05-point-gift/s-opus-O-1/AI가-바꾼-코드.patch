+package com.rest1.domain.point.point.service
+
+// 포인트 선물하기 기획서 v1.2 의 정책 값과 수수료 계산
+object PointPolicy {
+    const val MIN_TRANSFER_AMOUNT = 1_000L
+    const val DAILY_TRANSFER_LIMIT = 10_000_000L
+
+    // 테스트용 충전 1회 상한 (기획서에 없는 값. 잔액 overflow 와 오입력 방지용)
+    const val MAX_CHARGE_AMOUNT = 1_000_000_000L
+
+    private const val FEE_RATE_DIVISOR = 1_000L // 0.1%
+    private const val MAX_RATE_FEE = 5_000L
+    private const val FEE_TRUNCATE_UNIT = 10L
+
+    // 1만P까지 500P, 10만P까지 1,000P, 그 이상은 금액의 0.1% (최대 5,000P). 10P 미만 절사.
+    // 주의: 기획서 문구를 그대로 따르면 100,001P ~ 999,999P 구간의 수수료(100P ~ 990P)가
+    // 10만P 이하 구간의 1,000P 보다 작아진다.
+    fun calcFee(amount: Long): Long {
+        require(amount > 0) { "amount must be positive: $amount" }
+
+        val fee = when {
+            amount <= 10_000L -> 500L
+            amount <= 100_000L -> 1_000L
+            else -> minOf(amount / FEE_RATE_DIVISOR, MAX_RATE_FEE)
+        }
+
+        return fee / FEE_TRUNCATE_UNIT * FEE_TRUNCATE_UNIT
+    }
+}
