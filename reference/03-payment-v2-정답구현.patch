+package com.rest1.domain.wallet.controller
+
+import com.rest1.domain.post.post.service.PostService
+import com.rest1.domain.wallet.service.WalletService
+import com.rest1.global.exception.ServiceException
+import com.rest1.global.rq.Rq
+import com.rest1.global.rsData.RsData
+import org.springframework.transaction.annotation.Transactional
+import org.springframework.web.bind.annotation.GetMapping
+import org.springframework.web.bind.annotation.PathVariable
+import org.springframework.web.bind.annotation.PostMapping
+import org.springframework.web.bind.annotation.RequestBody
+import org.springframework.web.bind.annotation.RestController
+
+@RestController
+class ApiV1WalletController(
+    private val walletService: WalletService,
+    private val postService: PostService,
+    private val rq: Rq,
+) {
+    data class BalanceResBody(val balance: Long)
+    data class ChargeReqBody(val amount: Long?)
+    data class ContentResBody(val content: String)
+
+    @GetMapping("/api/v1/wallet")
+    fun balance(): BalanceResBody {
+        val id = rq.actor.id!!
+        walletService.ensureWallet(id)
+        return BalanceResBody(walletService.balance(id))
+    }
+
+    @PostMapping("/api/v1/wallet/charge")
+    fun charge(@RequestBody reqBody: ChargeReqBody): RsData<BalanceResBody> {
+        val id = rq.actor.id!!
+        walletService.ensureWallet(id)
+        val balance = walletService.charge(id, reqBody.amount ?: 0)
+        return RsData("200-1", "충전되었습니다.", BalanceResBody(balance))
+    }
+
+    @PostMapping("/api/v1/posts/{id}/purchase")
+    fun purchase(@PathVariable id: Long): RsData<Void> {
+        val actor = rq.actor
+        val post = postService.findById(id) ?: throw NoSuchElementException()
+        walletService.ensureWallet(actor.id!!)
+        walletService.ensureWallet(post.author.id!!)
+        walletService.purchase(actor, post)
+        return RsData("200-1", "${id}번 글을 구매했습니다.")
+    }
+
+    @GetMapping("/api/v1/posts/{id}/content")
+    @Transactional(readOnly = true)
+    fun content(@PathVariable id: Long): ContentResBody {
+        val post = postService.findById(id) ?: throw NoSuchElementException()
+        if (!walletService.canRead(rq.actor.id, post)) throw ServiceException("403-3", "구매 후 볼 수 있습니다.")
+        return ContentResBody(post.content)
+    }
+}
