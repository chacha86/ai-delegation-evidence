+package com.rest1.domain.wallet.service
+
+import com.rest1.domain.member.member.entity.Member
+import com.rest1.domain.member.member.repository.MemberRepository
+import com.rest1.domain.post.post.entity.Post
+import com.rest1.domain.wallet.entity.Purchase
+import com.rest1.domain.wallet.entity.Wallet
+import com.rest1.domain.wallet.repository.PurchaseRepository
+import com.rest1.domain.wallet.repository.WalletRepository
+import com.rest1.global.exception.ServiceException
+import org.springframework.dao.DataIntegrityViolationException
+import org.springframework.stereotype.Service
+import org.springframework.transaction.annotation.Propagation
+import org.springframework.transaction.annotation.Transactional
+
+@Service
+class WalletService(
+    private val walletRepository: WalletRepository,
+    private val purchaseRepository: PurchaseRepository,
+    private val memberRepository: MemberRepository,
+) {
+    // 지갑이 없으면 별도 트랜잭션에서 만든다. 동시에 만들면 유니크 제약으로 하나만 남는다.
+    @Transactional(propagation = Propagation.REQUIRES_NEW)
+    fun ensureWallet(memberId: Long) {
+        if (walletRepository.existsByMemberId(memberId)) return
+        try {
+            walletRepository.saveAndFlush(Wallet(memberRepository.getReferenceById(memberId)))
+        } catch (e: DataIntegrityViolationException) {
+            // 다른 요청이 먼저 만들었다
+        }
+    }
+
+    @Transactional(readOnly = true)
+    fun balance(memberId: Long): Long = walletRepository.findByMemberId(memberId)?.balance ?: 0
+
+    @Transactional
+    fun charge(memberId: Long, amount: Long): Long {
+        val wallet = walletRepository.findByMemberIdForUpdate(memberId)!!
+        wallet.charge(amount)
+        return wallet.balance
+    }
+
+    @Transactional
+    fun purchase(buyer: Member, post: Post) {
+        val buyerId = buyer.id!!
+        val authorId = post.author.id!!
+        if (buyerId == authorId) throw ServiceException("400-3", "자신의 글은 구매할 수 없습니다.")
+        if (post.price <= 0) throw ServiceException("400-4", "무료 글은 구매할 필요가 없습니다.")
+
+        // 교착을 피하려고 회원 id 순서대로 잠근다
+        val first = walletRepository.findByMemberIdForUpdate(minOf(buyerId, authorId))!!
+        val second = walletRepository.findByMemberIdForUpdate(maxOf(buyerId, authorId))!!
+        val buyerWallet = if (buyerId < authorId) first else second
+        val authorWallet = if (buyerId < authorId) second else first
+
+        if (purchaseRepository.existsByBuyerIdAndPostId(buyerId, post.id!!)) {
+            throw ServiceException("409-1", "이미 구매한 글입니다.")
+        }
+        buyerWallet.withdraw(post.price)
+        authorWallet.deposit(post.price * 9 / 10) // 플랫폼 수수료 10%
+        purchaseRepository.save(Purchase(buyer, post, post.price))
+    }
+
+    @Transactional(readOnly = true)
+    fun canRead(actorId: Long?, post: Post): Boolean {
+        if (post.price <= 0) return true
+        if (actorId == null) return false
+        if (post.author.id == actorId) return true
+        return purchaseRepository.existsByBuyerIdAndPostId(actorId, post.id!!)
+    }
+}
