+package com.rest1.domain.wallet.entity
+
+import com.rest1.domain.member.member.entity.Member
+import com.rest1.global.exception.ServiceException
+import com.rest1.global.jpa.entity.BaseEntity
+import jakarta.persistence.Entity
+import jakarta.persistence.JoinColumn
+import jakarta.persistence.OneToOne
+
+@Entity
+class Wallet(
+    @OneToOne
+    @JoinColumn(unique = true)
+    var member: Member,
+) : BaseEntity() {
+    var balance: Long = 0
+        protected set
+
+    fun charge(amount: Long) {
+        if (amount < 1) throw ServiceException("400-1", "충전 금액은 1 이상이어야 합니다.")
+        if (amount > 100_000) throw ServiceException("400-5", "1회 충전 한도는 100,000 입니다.")
+        balance += amount
+    }
+
+    fun withdraw(amount: Long) {
+        if (balance < amount) throw ServiceException("400-2", "잔액이 부족합니다.")
+        balance -= amount
+    }
+
+    fun deposit(amount: Long) {
+        balance += amount
+    }
+}
